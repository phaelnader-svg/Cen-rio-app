// Cenário Gestão — esquema do banco de dados (Fase 1: fundação).
//
// Convenções:
// - Tabelas e colunas em snake_case no banco; modelos em PascalCase no código.
// - Identificadores UUID.
// - Entidades editáveis têm coluna `version` para controle otimista de concorrência.
// - Toda alteração relevante gera registro de auditoria e evento de domínio na
//   mesma transação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identidade ───────────────────────────────

/// Identidade de acesso. Credenciais ficam aqui; dados da pessoa ficam em Employee.
model User {
  id                   String    @id @default(uuid()) @db.Uuid
  /// E-mail de acesso ao painel (opcional). Sempre armazenado em minúsculas.
  email                String?   @unique @db.VarChar(254)
  passwordHash         String?   @map("password_hash")
  /// PIN de 6 dígitos para os tablets (hash argon2id).
  pinHash              String?   @map("pin_hash")
  displayName          String    @map("display_name") @db.VarChar(60)
  active               Boolean   @default(true)
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz(3)
  credentialsChangedAt DateTime? @map("credentials_changed_at") @db.Timestamptz(3)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee        Employee?
  roles           UserRole[]
  permissions     UserPermission[]
  sessions        Session[]        @relation("SessionUser")
  revokedSessions Session[]        @relation("SessionRevokedBy")
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]
  uploadedFiles   StoredFile[]
  createdDevices  Device[]         @relation("DeviceCreatedBy")
  revokedDevices  Device[]         @relation("DeviceRevokedBy")

  createdCustomers       Customer[]             @relation("CustomerCreatedBy")
  createdOrders          CommercialOrder[]      @relation("OrderCreatedBy")
  cancelledOrders        CommercialOrder[]      @relation("OrderCancelledBy")
  createdPickups         PickupRequest[]        @relation("PickupCreatedBy")
  pickupEvents           PickupEvent[]
  registeredReceipts     Receipt[]              @relation("ReceiptRegisteredBy")
  createdServiceOrders   ServiceOrder[]         @relation("ServiceOrderCreatedBy")
  cancelledServiceOrders ServiceOrder[]         @relation("ServiceOrderCancelledBy")
  measuredItems          ServiceOrderItem[]     @relation("ItemMeasuredBy")
  serviceOrderRevisions  ServiceOrderRevision[]
  attachments            Attachment[]

  assignedMeasurements  Measurement[]         @relation("MeasurementAssignee")
  requestedMeasurements Measurement[]         @relation("MeasurementRequestedBy")
  measurementRevisions  MeasurementRevision[]
  reviewedRequests      MaterialRequest[]     @relation("MaterialRequestReviewedBy")

  stockMovements              StockMovement[]            @relation("StockMovementActor")
  createdReservations         StockReservation[]         @relation("ReservationCreatedBy")
  closedReservations          StockReservation[]         @relation("ReservationClosedBy")
  createdPurchaseOrders       PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  confirmedPurchaseOrders     PurchaseOrder[]            @relation("PurchaseOrderConfirmedBy")
  cancelledPurchaseOrders     PurchaseOrder[]            @relation("PurchaseOrderCancelledBy")
  balanceClosedPurchaseOrders PurchaseOrder[]            @relation("PurchaseOrderBalanceClosedBy")
  purchaseOrderHistory        PurchaseOrderHistory[]     @relation("PurchaseOrderHistoryActor")
  materialReceipts            MaterialReceipt[]          @relation("MaterialReceiptReceivedBy")
  receiptReversals            MaterialReceiptReversal[]  @relation("ReceiptReversalAuthorizedBy")
  createdLeftovers            MaterialLeftover[]         @relation("LeftoverCreatedBy")
  authorizedLeftoverMoves     MaterialLeftoverTransfer[] @relation("LeftoverTransferAuthorizedBy")

  createdPlans              ProductionPlan[]              @relation("PlanCreatedBy")
  publishedPlans            ProductionPlan[]              @relation("PlanPublishedBy")
  principalPlanItems        ProductionPlanItem[]          @relation("PlanItemPrincipal")
  upholsteredItems          ServiceOrderItem[]            @relation("ItemUpholsterer")
  itemOwnerChangesFrom      ServiceOrderItemOwnerChange[] @relation("OwnerChangeFrom")
  itemOwnerChangesTo        ServiceOrderItemOwnerChange[] @relation("OwnerChangeTo")
  itemOwnerChangesBy        ServiceOrderItemOwnerChange[] @relation("OwnerChangeBy")
  planRevisions             ProductionPlanRevision[]      @relation("PlanRevisionCreatedBy")
  assignedTasks             ProductionTask[]              @relation("TaskAssignee")
  completedTasks            ProductionTask[]              @relation("TaskCompletedBy")
  taskEvents                ProductionTaskEvent[]         @relation("TaskEventActor")
  notifications             Notification[]                @relation("UserNotifications")
  attendanceArrivals        OperationalAttendance[]       @relation("AttendanceArrivalBy")
  attendanceDepartures      OperationalAttendance[]       @relation("AttendanceDepartureBy")
  attendanceCorrections     AttendanceCorrection[]        @relation("AttendanceCorrectionActor")
  attendanceImpacts         AttendanceImpact[]            @relation("AttendanceImpactAffected")
  attendanceImpactsResolved AttendanceImpact[]            @relation("AttendanceImpactResolvedBy")
  skillsGranted             EmployeeSkill[]               @relation("SkillGrantedBy")
  helpRequested             HelpRequest[]                 @relation("HelpRequester")
  helpGiven                 HelpRequest[]                 @relation("HelpHelper")
  helpEvents                HelpRequestEvent[]            @relation("HelpEventActor")
  proposalsDecided          RescheduleProposal[]          @relation("ProposalDecidedBy")
  planningActions           PlanningAction[]              @relation("PlanningActionActor")
  issuesReported            ProductionIssue[]             @relation("IssueReporter")
  issuesAssigned            ProductionIssue[]             @relation("IssueAssignee")
  issuesResolved            ProductionIssue[]             @relation("IssueResolvedBy")
  issuesCancelled           ProductionIssue[]             @relation("IssueCancelledBy")
  issueEvents               ProductionIssueEvent[]        @relation("IssueEventActor")
  inspectionsAssigned       QualityInspection[]           @relation("InspectionInspector")
  inspectionsDecided        QualityInspection[]           @relation("InspectionDecidedBy")
  qualityEvents             QualityEvent[]                @relation("QualityEventActor")
  packagingAssigned         PackagingRecord[]             @relation("PackagingAssignee")
  locationEvents            ItemLocationEvent[]           @relation("LocationEventActor")
  deliveriesResponsible     Delivery[]                    @relation("DeliveryResponsible")
  deliveriesCreated         Delivery[]                    @relation("DeliveryCreatedBy")
  deliveryEvents            DeliveryEvent[]               @relation("DeliveryEventActor")
  pickupsLogistics          PickupRequest[]               @relation("PickupLogisticsUser")
  logisticsResponsible      LogisticsOccurrence[]         @relation("LogisticsResponsible")
  logisticsReported         LogisticsOccurrence[]         @relation("LogisticsReportedBy")
  returnsResponsible        PieceReturn[]                 @relation("ReturnResponsible")

  // Fase 11: financeiro operacional.
  commercialAdjustments CommercialAdjustment[] @relation("CommercialAdjustmentBy")
  productionPayables    ProductionPayable[]    @relation("ProductionPayableProfessional")
  financialAdjustments  FinancialAdjustment[]  @relation("FinancialAdjustmentBy")
  teamMonthlyCosts      TeamMonthlyCost[]      @relation("TeamMonthlyCostUser")

  @@map("users")
}

/// Pessoa que atua na empresa (gestor, tapeceiros, ajudante...).
model Employee {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(120)
  displayName      String   @map("display_name") @db.VarChar(40)
  jobTitle         String   @map("job_title") @db.VarChar(80)
  responsibilities String?  @db.VarChar(500)
  phone            String?  @db.VarChar(30)
  /// Cor de identificação visual nos tablets e no painel (#RRGGBB).
  color            String   @db.Char(7)
  photoFileId      String?  @unique @map("photo_file_id") @db.Uuid
  active           Boolean  @default(true)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  photo           StoredFile?             @relation("EmployeePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  assignedDevices Device[]
  receipts        Receipt[]               @relation("ReceiptReceivedBy")
  leadOf          ServiceOrder[]          @relation("ServiceOrderTechnicalLead")
  attendances     OperationalAttendance[]
  skills          EmployeeSkill[]

  @@index([active])
  @@map("employees")
}

// ─────────────────────────── Funções e permissões ───────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Chave estável das funções padrão (null para funções criadas pelo gestor).
  key         String?  @unique @db.VarChar(60)
  name        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(300)
  /// Funções do sistema não podem ser excluídas.
  system      Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String @db.VarChar(80)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Concessões individuais além das funções (ex.: medição extraordinária autorizada).
model UserPermission {
  userId     String @map("user_id") @db.Uuid
  permission String @db.VarChar(80)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

// ─────────────────────────── Dispositivos e sessões ───────────────────────────

enum DeviceKind {
  TABLET
  COMPUTADOR
  CELULAR

  @@map("device_kind")
}

enum DeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED

  @@map("device_status")
}

model Device {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String       @unique @db.VarChar(60)
  kind                 DeviceKind   @default(TABLET)
  location             String?      @db.VarChar(80)
  status               DeviceStatus @default(PENDING_PAIRING)
  assignedEmployeeId   String?      @map("assigned_employee_id") @db.Uuid
  restrictToAssigned   Boolean      @default(true) @map("restrict_to_assigned")
  /// Hash SHA-256 da credencial do dispositivo (o valor bruto fica só no cookie do tablet).
  credentialHash       String?      @unique @map("credential_hash") @db.Char(64)
  /// Hash SHA-256 do código de vinculação de uso único.
  pairingCodeHash      String?      @unique @map("pairing_code_hash") @db.Char(64)
  pairingCodeExpiresAt DateTime?    @map("pairing_code_expires_at") @db.Timestamptz(3)
  pairedAt             DateTime?    @map("paired_at") @db.Timestamptz(3)
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokedById          String?      @map("revoked_by_id") @db.Uuid
  lastSeenAt           DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  lastIp               String?      @map("last_ip") @db.VarChar(64)
  userAgent            String?      @map("user_agent") @db.VarChar(300)
  createdById          String?      @map("created_by_id") @db.Uuid
  version              Int          @default(1)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedEmployee Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  createdBy        User?     @relation("DeviceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy        User?     @relation("DeviceRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  sessions         Session[]

  @@index([status])
  @@map("devices")
}

enum SessionKind {
  WEB
  DEVICE

  @@map("session_kind")
}

model Session {
  id            String      @id @default(uuid()) @db.Uuid
  /// Hash SHA-256 do token de sessão; o token bruto existe apenas no cookie httpOnly.
  tokenHash     String      @unique @map("token_hash") @db.Char(64)
  kind          SessionKind
  userId        String      @map("user_id") @db.Uuid
  deviceId      String?     @map("device_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?     @map("revoked_reason") @db.VarChar(40)
  revokedById   String?     @map("revoked_by_id") @db.Uuid
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(300)

  user      User    @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  device    Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  revokedBy User?   @relation("SessionRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([deviceId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Controle persistente contra abuso de autenticação (por conta, IP ou dispositivo).
model AuthThrottle {
  key         String    @id @db.VarChar(200)
  failures    Int       @default(0)
  windowStart DateTime  @default(now()) @map("window_start") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("auth_throttle")
}

// ─────────────────────────────── Empresa ───────────────────────────────

/// Configurações da empresa (registro único, id = 1).
model CompanySettings {
  id                 Int      @id @default(1)
  tradeName          String   @map("trade_name") @db.VarChar(120)
  legalName          String?  @map("legal_name") @db.VarChar(160)
  document           String?  @db.VarChar(20)
  phone              String?  @db.VarChar(30)
  email              String?  @db.VarChar(254)
  address            String?  @db.VarChar(240)
  timezone           String   @default("America/Sao_Paulo") @db.VarChar(64)
  /// Horário a partir do qual o botão "Cheguei" é exibido (HH:MM).
  workdayStart       String   @default("08:30") @map("workday_start") @db.Char(5)
  /// Limite para alerta de indisponibilidade operacional presumida (HH:MM).
  arrivalAlertAt     String   @default("09:30") @map("arrival_alert_at") @db.Char(5)
  workdayEnd         String   @default("18:00") @map("workday_end") @db.Char(5)
  /// Fase 7: início da janela em que o botão "Cheguei" aceita confirmação (HH:MM).
  arrivalWindowStart String   @default("07:00") @map("arrival_window_start") @db.Char(5)
  /// Fase 7: atraso (minutos) a partir do qual o gestor é avisado.
  lateAlertMinutes   Int      @default(15) @map("late_alert_minutes")
  /// Dias úteis (0 = domingo ... 6 = sábado).
  workingDays        Int[]    @default([1, 2, 3, 4, 5]) @map("working_days")
  /// Dia habitual de programação da semana seguinte.
  planningWeekday    Int      @default(5) @map("planning_weekday")
  /// Dia habitual de medição de tecidos e espumas.
  measurementWeekday Int      @default(5) @map("measurement_weekday")
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById        String?  @map("updated_by_id") @db.Uuid

  /// Fase 10: inspetor principal da qualidade (vazio = quem tem a competência de inspeção).
  qualityInspectorUserId    String? @map("quality_inspector_user_id") @db.Uuid
  /// Evolução Fase 3: responsável padrão das etapas de preparação/desmontagem (vazio = único
  /// ajudante ativo com a competência; se houver zero ou vários, a tarefa fica pendente).
  preparationAssigneeUserId String? @map("preparation_assignee_user_id") @db.Uuid

  // Fase 11: financeiro operacional.
  /// Alíquota estimada de tributos sobre a receita (pontos-base; 600 = 6%). Vazio = não configurada.
  taxRateBps Int? @map("tax_rate_bps")

  @@map("company_settings")
}

// ─────────────────────────── Auditoria e eventos ───────────────────────────

/// Registro imutável de ações críticas (UPDATE/DELETE bloqueados por trigger).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  summary     String   @db.VarChar(300)
  /// Diferenças antes/depois, sem dados sensíveis.
  changes     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Eventos de domínio persistentes (outbox). `seq` define a ordem global.
model DomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  seq           BigInt   @unique @default(autoincrement())
  type          String   @db.VarChar(80)
  aggregateType String   @map("aggregate_type") @db.VarChar(60)
  aggregateId   String   @map("aggregate_id") @db.VarChar(64)
  payload       Json
  /// Quem pode receber em tempo real: 'all', 'permission:<p>' ou 'user:<id>'.
  audience      String   @default("all") @db.VarChar(400)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  requestId     String?  @map("request_id") @db.VarChar(64)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@map("domain_events")
}

/// Posição de cada consumidor de eventos (automações). Processamento ordenado,
/// pelo menos uma vez, com repetição após falha.
model EventConsumer {
  name           String    @id @db.VarChar(80)
  lastSeq        BigInt    @default(0) @map("last_seq")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lastError      String?   @map("last_error") @db.VarChar(1000)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_consumers")
}

/// Chaves de idempotência para operações sensíveis.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(100)
  scope          String   @db.VarChar(160)
  requestHash    String   @map("request_hash") @db.Char(64)
  /// null enquanto a operação está em andamento.
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────── Arquivos ───────────────────────────────

enum FileVisibility {
  PRIVATE

  @@map("file_visibility")
}

/// Metadados de arquivos privados (fotos e documentos). O conteúdo fica no
/// armazenamento privado e só é servido por rota autenticada.
model StoredFile {
  id           String         @id @default(uuid()) @db.Uuid
  storageKey   String         @unique @map("storage_key") @db.VarChar(200)
  purpose      String         @db.VarChar(40)
  originalName String         @map("original_name") @db.VarChar(200)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    Int            @map("size_bytes")
  sha256       String         @db.Char(64)
  visibility   FileVisibility @default(PRIVATE)
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  employeePhoto Employee?   @relation("EmployeePhoto")
  attachment    Attachment?

  @@map("stored_files")
}

// ═══════════════════════════ FASE 2 — Comercial e oficina ═══════════════════════════

enum CustomerKind {
  PF
  PJ

  @@map("customer_kind")
}

/// Cliente (pessoa física ou jurídica). Dados pessoais restritos por permissão.
model Customer {
  id          String       @id @default(uuid()) @db.Uuid
  kind        CustomerKind
  name        String       @db.VarChar(160)
  tradeName   String?      @map("trade_name") @db.VarChar(160)
  /// CPF/CNPJ somente dígitos. Único quando informado (duplicidade evidente).
  document    String?      @db.VarChar(14)
  phone       String?      @db.VarChar(13)
  whatsapp    String?      @db.VarChar(13)
  email       String?      @db.VarChar(254)
  notes       String?      @db.VarChar(2000)
  /// Texto normalizado (sem acentos, minúsculo) para pesquisa.
  searchText  String       @map("search_text") @db.VarChar(800)
  active      Boolean      @default(true)
  version     Int          @default(1)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  addresses     CustomerAddress[]
  orders        CommercialOrder[]
  serviceOrders ServiceOrder[]

  deliveries Delivery[]

  // Fase 11: financeiro operacional.
  receivables CustomerReceivable[]

  @@index([phone])
  @@index([whatsapp])
  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  label      String    @db.VarChar(40)
  street     String    @db.VarChar(160)
  number     String    @db.VarChar(20)
  complement String?   @db.VarChar(80)
  district   String?   @db.VarChar(80)
  city       String    @db.VarChar(80)
  state      String    @db.Char(2)
  postalCode String?   @map("postal_code") @db.Char(8)
  reference  String?   @db.VarChar(200)
  isPrimary  Boolean   @default(false) @map("is_primary")
  /// Endereços não são apagados (pedidos guardam cópia), apenas arquivados.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   CommercialOrder[]
  pickups  PickupRequest[]

  deliveries Delivery[]

  @@index([customerId])
  @@map("customer_addresses")
}

enum CommercialOrderStatus {
  AGUARDANDO_RETIRADA
  RETIRADA_AGENDADA
  RECEBIDO_PARCIAL
  RECEBIDO
  CANCELADO

  @@map("commercial_order_status")
}

enum PieceType {
  SOFA
  POLTRONA
  CADEIRA
  CABECEIRA
  CANTO_ALEMAO
  PUFE
  BANCO
  COLCHAO
  OUTRO

  @@map("piece_type")
}

/// Pedido comercial: criado após a aprovação do cliente; organiza a retirada e preserva a venda.
model CommercialOrder {
  id                    String                @id @default(uuid()) @db.Uuid
  number                Int                   @unique @default(autoincrement())
  customerId            String                @map("customer_id") @db.Uuid
  pickupAddressId       String?               @map("pickup_address_id") @db.Uuid
  /// Cópia do endereço no momento do pedido (preserva o combinado).
  pickupAddressSnapshot Json?                 @map("pickup_address_snapshot")
  contractedService     String                @map("contracted_service") @db.VarChar(300)
  description           String?               @db.VarChar(2000)
  agreedValueCents      Int?                  @map("agreed_value_cents")
  paymentTerms          String?               @map("payment_terms") @db.VarChar(1000)
  notes                 String?               @db.VarChar(2000)
  status                CommercialOrderStatus @default(AGUARDANDO_RETIRADA)
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?               @map("cancelled_by_id") @db.Uuid
  cancelReason          String?               @map("cancel_reason") @db.VarChar(500)
  version               Int                   @default(1)
  createdById           String?               @map("created_by_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickupAddress CustomerAddress?      @relation(fields: [pickupAddressId], references: [id], onDelete: Restrict)
  createdBy     User?                 @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?                 @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items         CommercialOrderItem[]
  pickups       PickupRequest[]
  receipts      Receipt[]
  serviceOrders ServiceOrder[]

  pieceReturns PieceReturn[]

  // Fase 11: financeiro operacional.
  adjustments CommercialAdjustment[]
  receivables CustomerReceivable[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("commercial_orders")
}

model CommercialOrderItem {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  position         Int
  pieceType        PieceType @map("piece_type")
  description      String    @db.VarChar(300)
  quantity         Int
  /// Mantido pelo registro de recebimentos (nunca maior que a quantidade).
  receivedQuantity Int       @default(0) @map("received_quantity")
  notes            String?   @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order             CommercialOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pickupItems       PickupRequestItem[]
  receiptLines      ReceiptLine[]
  serviceOrderItems ServiceOrderItem[]

  /// Fase 10: peças devolvidas ao cliente (confirmadas).
  returnedQuantity Int               @default(0) @map("returned_quantity")
  returnLines      PieceReturnLine[]

  @@unique([orderId, position])
  @@map("commercial_order_items")
}

enum PickupStatus {
  AGUARDANDO_AGENDAMENTO
  AGENDADA
  EM_EXECUCAO
  RETIRADA_REALIZADA
  RECEBIDA_NA_OFICINA
  CANCELADA
  COM_OCORRENCIA

  @@map("pickup_status")
}

enum PickupTeam {
  LOGISTICA_TERCEIRIZADA
  EQUIPE_PROPRIA

  @@map("pickup_team")
}

/// Solicitação de retirada (preparada para integração futura com a logística terceirizada).
model PickupRequest {
  id                String       @id @default(uuid()) @db.Uuid
  number            Int          @unique @default(autoincrement())
  orderId           String       @map("order_id") @db.Uuid
  addressId         String?      @map("address_id") @db.Uuid
  addressSnapshot   Json?        @map("address_snapshot")
  scheduledDate     DateTime?    @map("scheduled_date") @db.Date
  windowStart       String?      @map("window_start") @db.Char(5)
  windowEnd         String?      @map("window_end") @db.Char(5)
  team              PickupTeam   @default(LOGISTICA_TERCEIRIZADA)
  teamNotes         String?      @map("team_notes") @db.VarChar(200)
  instructions      String?      @db.VarChar(1000)
  /// Protocolo/identificador no sistema da logística (integração futura).
  externalReference String?      @map("external_reference") @db.VarChar(80)
  status            PickupStatus @default(AGUARDANDO_AGENDAMENTO)
  version           Int          @default(1)
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     CommercialOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  address   CustomerAddress?    @relation(fields: [addressId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("PickupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     PickupRequestItem[]
  events    PickupEvent[]
  receipts  Receipt[]

  /// Fase 10: responsável logístico (equipe terceirizada ou própria).
  logisticsUserId String?               @map("logistics_user_id") @db.Uuid
  logisticsUser   User?                 @relation("PickupLogisticsUser", fields: [logisticsUserId], references: [id], onDelete: SetNull)
  occurrences     LogisticsOccurrence[]

  // Fase 11: financeiro operacional.
  logisticsCosts LogisticsCost[]

  @@index([orderId])
  @@index([status])
  @@index([scheduledDate])
  @@map("pickup_requests")
}

model PickupRequestItem {
  pickupId    String @map("pickup_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  pickup    PickupRequest       @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  orderItem CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@id([pickupId, orderItemId])
  @@index([orderItemId])
  @@map("pickup_request_items")
}

enum EventSource {
  MANUAL
  SISTEMA
  INTEGRACAO

  @@map("event_source")
}

/// Linha do tempo da retirada (confirmações manuais agora; integração no futuro).
model PickupEvent {
  id           String        @id @default(uuid()) @db.Uuid
  pickupId     String        @map("pickup_id") @db.Uuid
  kind         String        @db.VarChar(40)
  fromStatus   PickupStatus? @map("from_status")
  toStatus     PickupStatus? @map("to_status")
  note         String?       @db.VarChar(1000)
  source       EventSource   @default(MANUAL)
  recordedById String?       @map("recorded_by_id") @db.Uuid
  occurredAt   DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  pickup     PickupRequest @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  recordedBy User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([pickupId, occurredAt])
  @@map("pickup_events")
}

enum ReceiptOrigin {
  RETIRADA
  ENTREGUE_PELO_CLIENTE

  @@map("receipt_origin")
}

enum PieceCondition {
  BOA
  REGULAR
  DANIFICADA

  @@map("piece_condition")
}

/// Recebimento físico das peças na oficina (pode ser parcial).
model Receipt {
  id                   String        @id @default(uuid()) @db.Uuid
  number               Int           @unique @default(autoincrement())
  orderId              String        @map("order_id") @db.Uuid
  pickupId             String?       @map("pickup_id") @db.Uuid
  origin               ReceiptOrigin
  receivedAt           DateTime      @map("received_at") @db.Timestamptz(3)
  receivedByEmployeeId String?       @map("received_by_employee_id") @db.Uuid
  registeredById       String?       @map("registered_by_id") @db.Uuid
  divergences          String?       @db.VarChar(2000)
  notes                String?       @db.VarChar(2000)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order        CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pickup       PickupRequest?  @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  receivedBy   Employee?       @relation("ReceiptReceivedBy", fields: [receivedByEmployeeId], references: [id], onDelete: SetNull)
  registeredBy User?           @relation("ReceiptRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  lines        ReceiptLine[]

  @@index([orderId])
  @@index([receivedAt(sort: Desc)])
  @@index([pickupId])
  @@map("receipts")
}

model ReceiptLine {
  id             String         @id @default(uuid()) @db.Uuid
  receiptId      String         @map("receipt_id") @db.Uuid
  orderItemId    String         @map("order_item_id") @db.Uuid
  quantity       Int
  condition      PieceCondition
  conditionNotes String?        @map("condition_notes") @db.VarChar(500)
  location       String         @db.VarChar(80)

  receipt   Receipt             @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  orderItem CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  corrections ReceiptCorrection[]

  @@unique([receiptId, orderItemId])
  @@index([orderItemId])
  @@map("receipt_lines")
}

enum ServiceOrderStatus {
  ABERTA
  CANCELADA

  @@map("service_order_status")
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  URGENTE

  @@map("priority")
}

enum ServiceType {
  REFORMA_COMPLETA
  TROCA_DE_TECIDO
  TROCA_DE_ESPUMA
  REPARO
  FABRICACAO
  INSTALACAO
  OUTRO

  @@map("service_type")
}

enum MeasurementKind {
  ROTINA
  EXTRAORDINARIA

  @@map("measurement_kind")
}

/// Ordem de serviço técnica: só existe para peças efetivamente recebidas.
model ServiceOrder {
  id                    String             @id @default(uuid()) @db.Uuid
  number                Int                @unique @default(autoincrement())
  orderId               String             @map("order_id") @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  status                ServiceOrderStatus @default(ABERTA)
  technicalInstructions String?            @map("technical_instructions") @db.VarChar(4000)
  notes                 String?            @db.VarChar(2000)
  promisedDate          DateTime?          @map("promised_date") @db.Date
  priority              Priority           @default(NORMAL)
  technicalLeadId       String?            @map("technical_lead_id") @db.Uuid
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?            @map("cancelled_by_id") @db.Uuid
  cancelReason          String?            @map("cancel_reason") @db.VarChar(500)
  version               Int                @default(1)
  createdById           String?            @map("created_by_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         CommercialOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technicalLead Employee?              @relation("ServiceOrderTechnicalLead", fields: [technicalLeadId], references: [id], onDelete: SetNull)
  createdBy     User?                  @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?                  @relation("ServiceOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items         ServiceOrderItem[]
  revisions     ServiceOrderRevision[]
  materials     MaterialRequirement[]
  measurements  Measurement[]

  // Fase 4: prontidão de materiais (calculada a partir dos registros; não libera produção).
  materialsReadiness   MaterialReadiness @default(SEM_LEVANTAMENTO) @map("materials_readiness")
  materialsReadinessAt DateTime?         @map("materials_readiness_at") @db.Timestamptz(3)

  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  purchaseItems       PurchaseOrderItem[]
  purchaseAllocations PurchaseAllocation[]
  leftovers           MaterialLeftover[]
  leftoversOut        MaterialLeftoverTransfer[] @relation("LeftoverTransferFrom")
  leftoversIn         MaterialLeftoverTransfer[] @relation("LeftoverTransferTo")

  productionPlanItems ProductionPlanItem[]
  productionTasks     ProductionTask[]
  notifications       Notification[]
  helpRequests        HelpRequest[]
  issues              ProductionIssue[]

  inspections QualityInspection[]

  // Fase 11: financeiro operacional.
  /// Receita atribuída à OS pelo gestor (vazio = proporcional às peças do pedido).
  revenueCents         Int?                      @map("revenue_cents")
  receivables          CustomerReceivable[]
  costs                ServiceOrderCost[]
  productionPayables   ProductionPayable[]
  logisticsAllocations LogisticsCostAllocation[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("service_orders")
}

/// Peça (ou conjunto de peças idênticas) da OS, com identificação individual (código OS-xxxxx/n).
model ServiceOrderItem {
  id               String           @id @default(uuid()) @db.Uuid
  serviceOrderId   String           @map("service_order_id") @db.Uuid
  orderItemId      String           @map("order_item_id") @db.Uuid
  position         Int
  pieceType        PieceType        @map("piece_type")
  description      String           @db.VarChar(300)
  quantity         Int
  serviceType      ServiceType      @map("service_type")
  fabricName       String?          @map("fabric_name") @db.VarChar(120)
  fabricColor      String?          @map("fabric_color") @db.VarChar(80)
  fabricReference  String?          @map("fabric_reference") @db.VarChar(80)
  foamSpecs        String?          @map("foam_specs") @db.VarChar(500)
  technicalNotes   String?          @map("technical_notes") @db.VarChar(2000)
  /// Lista de medidas [{ label, valueCm }].
  measurements     Json             @default("[]")
  measurementNotes String?          @map("measurement_notes") @db.VarChar(1000)
  measuredAt       DateTime?        @map("measured_at") @db.Timestamptz(3)
  measuredById     String?          @map("measured_by_id") @db.Uuid
  measurementKind  MeasurementKind? @map("measurement_kind")
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrder      ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  orderItem         CommercialOrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  measuredBy        User?                 @relation("ItemMeasuredBy", fields: [measuredById], references: [id], onDelete: SetNull)
  materials         MaterialRequirement[]
  measurementTasks  Measurement[]
  measurementPieces MeasurementPiece[]
  requestItems      MaterialRequestItem[]

  productionTasks ProductionTask[]

  /// Fase 10: etapa da peça no fluxo produção → qualidade → embalagem → entrega (derivada).
  fulfillmentStage     String                @default("EM_PRODUCAO") @map("fulfillment_stage") @db.VarChar(30)
  currentLocationId    String?               @map("current_location_id") @db.Uuid
  currentLocation      ItemLocation?         @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  inspections          QualityInspection[]
  qualityEvents        QualityEvent[]
  packaging            PackagingRecord[]
  locationEvents       ItemLocationEvent[]
  deliveryItems        DeliveryItem[]
  logisticsOccurrences LogisticsOccurrence[]

  // Fase 11: financeiro operacional.
  productionPayables ProductionPayable[]

  /// Evolução Fase 3: tapeceiro titular da peça (fonte de verdade operacional; um por peça).
  /// Não é direito financeiro: mão de obra combinada fica em production_payables.
  upholstererUserId String?                       @map("upholsterer_user_id") @db.Uuid
  upholsterer       User?                         @relation("ItemUpholsterer", fields: [upholstererUserId], references: [id], onDelete: Restrict)
  ownerChanges      ServiceOrderItemOwnerChange[]

  @@unique([serviceOrderId, position])
  @@index([orderItemId])
  @@map("service_order_items")
}

/// Histórico técnico da OS (imutável): cada alteração gera uma revisão numerada.
model ServiceOrderRevision {
  id             String   @id @default(uuid()) @db.Uuid
  serviceOrderId String   @map("service_order_id") @db.Uuid
  revision       Int
  scope          String   @db.VarChar(20)
  itemId         String?  @map("item_id") @db.Uuid
  changes        Json
  reason         String?  @db.VarChar(300)
  changedById    String?  @map("changed_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([serviceOrderId, revision])
  @@map("service_order_revisions")
}

enum MaterialKind {
  TECIDO
  ESPUMA
  OUTRO

  @@map("material_kind")
}

enum MaterialSourcing {
  EXCLUSIVO_OS
  ESTOQUE

  @@map("material_sourcing")
}

/// Necessidade de material da OS (estrutura preparatória para compras/estoque — Fase 3).
/// Tecido é sempre de compra exclusiva da OS. Não dispara produção.
model MaterialRequirement {
  id                 String           @id @default(uuid()) @db.Uuid
  serviceOrderId     String           @map("service_order_id") @db.Uuid
  serviceOrderItemId String?          @map("service_order_item_id") @db.Uuid
  kind               MaterialKind
  description        String           @db.VarChar(200)
  quantity           Decimal?         @db.Decimal(12, 3)
  unit               String?          @db.VarChar(20)
  sourcing           MaterialSourcing
  notes              String?          @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  // Fase 3: necessidades aprovadas a partir de solicitações de material.
  /// PREVISAO_MANUAL (Fase 2, não conferida) ou SOLICITACAO_APROVADA (conferida pelo gestor).
  origin                MaterialRequirementOrigin @default(PREVISAO_MANUAL)
  materialRequestItemId String?                   @unique @map("material_request_item_id") @db.Uuid
  unitCode              MaterialUnit?             @map("unit_code")
  color                 String?                   @db.VarChar(60)
  reference             String?                   @db.VarChar(80)
  foamDensity           String?                   @map("foam_density") @db.VarChar(30)
  thicknessCm           Decimal?                  @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm              Decimal?                  @map("length_cm") @db.Decimal(8, 2)
  widthCm               Decimal?                  @map("width_cm") @db.Decimal(8, 2)
  approvedAt            DateTime?                 @map("approved_at") @db.Timestamptz(3)

  serviceOrder        ServiceOrder               @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  serviceOrderItem    ServiceOrderItem?          @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  materialRequestItem MaterialRequestItem?       @relation(fields: [materialRequestItemId], references: [id], onDelete: Restrict)
  allocations         PurchaseAllocation[]
  reservations        StockReservation[]
  transfersIn         MaterialLeftoverTransfer[]
  productionTasks     ProductionTaskMaterial[]
  issues              ProductionIssue[]

  @@index([serviceOrderId])
  @@index([serviceOrderItemId])
  @@map("material_requirements")
}

enum AttachmentEntity {
  COMMERCIAL_ORDER
  PICKUP
  RECEIPT
  SERVICE_ORDER
  SERVICE_ORDER_ITEM
  PRODUCTION_TASK
  PRODUCTION_ISSUE
  QUALITY_INSPECTION
  PACKAGING
  DELIVERY
  LOGISTICS_OCCURRENCE
  FINANCE_PAYABLE

  @@map("attachment_entity")
}

/// Vínculo entre arquivo privado (stored_files) e um registro do fluxo.
model Attachment {
  id          String           @id @default(uuid()) @db.Uuid
  fileId      String           @unique @map("file_id") @db.Uuid
  entityType  AttachmentEntity @map("entity_type")
  entityId    String           @map("entity_id") @db.Uuid
  caption     String?          @db.VarChar(200)
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(3)

  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("attachments")
}

// ═══════════════════════ FASE 3 — Medições e solicitações de materiais ═══════════════════════

enum MaterialRequirementOrigin {
  PREVISAO_MANUAL
  SOLICITACAO_APROVADA

  @@map("material_requirement_origin")
}

enum MeasurementStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA

  @@map("measurement_status")
}

enum MaterialRequestStatus {
  RASCUNHO
  ENVIADA
  EM_REVISAO
  APROVADA
  DEVOLVIDA
  CANCELADA

  @@map("material_request_status")
}

enum MaterialUnit {
  METRO
  METRO_QUADRADO
  PLACA
  PECA
  UNIDADE
  EMBALAGEM

  @@map("material_unit")
}

/// Tarefa de medição (rotina de sexta ou extraordinária) de uma OS ou peça.
/// Não inicia produção: apenas registra medidas e necessidades de material.
model Measurement {
  id                 String            @id @default(uuid()) @db.Uuid
  number             Int               @unique @default(autoincrement())
  serviceOrderId     String            @map("service_order_id") @db.Uuid
  /// Peça específica; nulo = OS inteira.
  serviceOrderItemId String?           @map("service_order_item_id") @db.Uuid
  kind               MeasurementKind
  status             MeasurementStatus @default(PENDENTE)
  assigneeUserId     String            @map("assignee_user_id") @db.Uuid
  requestedById      String?           @map("requested_by_id") @db.Uuid
  requestedAt        DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  dueDate            DateTime          @map("due_date") @db.Date
  reason             String?           @db.VarChar(500)
  notes              String?           @db.VarChar(2000)
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?           @map("cancel_reason") @db.VarChar(500)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrder     ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  serviceOrderItem ServiceOrderItem?     @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  assignee         User                  @relation("MeasurementAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  requestedBy      User?                 @relation("MeasurementRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  pieces           MeasurementPiece[]
  request          MaterialRequest?
  revisions        MeasurementRevision[]

  @@index([assigneeUserId, status])
  @@index([serviceOrderId])
  @@index([status, dueDate])
  @@map("measurements")
}

/// Medidas de cada peça registradas na medição.
model MeasurementPiece {
  measurementId      String  @map("measurement_id") @db.Uuid
  serviceOrderItemId String  @map("service_order_item_id") @db.Uuid
  /// [{ label, valueCm }]
  dimensions         Json    @default("[]")
  notes              String? @db.VarChar(1000)

  measurement      Measurement      @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)

  @@id([measurementId, serviceOrderItemId])
  @@map("measurement_pieces")
}

/// Solicitação de materiais gerada pela medição (uma por medição).
/// "Aprovada" = quantidades conferidas pelo gestor; NÃO é compra nem recebimento.
model MaterialRequest {
  id            String                @id @default(uuid()) @db.Uuid
  measurementId String                @unique @map("measurement_id") @db.Uuid
  status        MaterialRequestStatus @default(RASCUNHO)
  submittedAt   DateTime?             @map("submitted_at") @db.Timestamptz(3)
  reviewedById  String?               @map("reviewed_by_id") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(3)
  returnReason  String?               @map("return_reason") @db.VarChar(500)
  version       Int                   @default(1)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  measurement Measurement           @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  reviewedBy  User?                 @relation("MaterialRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items       MaterialRequestItem[]

  @@index([status])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                 String           @id @default(uuid()) @db.Uuid
  requestId          String           @map("request_id") @db.Uuid
  position           Int
  serviceOrderItemId String?          @map("service_order_item_id") @db.Uuid
  kind               MaterialKind
  sourcing           MaterialSourcing
  description        String           @db.VarChar(160)
  color              String?          @db.VarChar(60)
  reference          String?          @db.VarChar(80)
  foamDensity        String?          @map("foam_density") @db.VarChar(30)
  thicknessCm        Decimal?         @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm           Decimal?         @map("length_cm") @db.Decimal(8, 2)
  widthCm            Decimal?         @map("width_cm") @db.Decimal(8, 2)
  quantity           Decimal          @db.Decimal(12, 3)
  unit               MaterialUnit
  notes              String?          @db.VarChar(500)

  request          MaterialRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem?    @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  requirement      MaterialRequirement?

  @@unique([requestId, position])
  @@map("material_request_items")
}

/// Histórico imutável da medição e da solicitação (com cópia dos itens a cada envio/revisão).
model MeasurementRevision {
  id            String   @id @default(uuid()) @db.Uuid
  measurementId String   @map("measurement_id") @db.Uuid
  kind          String   @db.VarChar(40)
  fromStatus    String?  @map("from_status") @db.VarChar(40)
  toStatus      String?  @map("to_status") @db.VarChar(40)
  note          String?  @db.VarChar(500)
  changes       Json?
  actorId       String?  @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([measurementId, createdAt])
  @@map("measurement_revisions")
}

// ─────────────────────────── Fase 4: compras, recebimento e estoque ───────────────────────────

enum PurchaseOrderStatus {
  RASCUNHO
  CONFIRMADO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO

  @@map("purchase_order_status")
}

enum ReceiptIssue {
  INCORRETO
  DANIFICADO
  INCOMPLETO
  OUTRO

  @@map("receipt_issue")
}

enum StockMovementType {
  ENTRADA_COMPRA
  ESTORNO_RECEBIMENTO
  SAIDA_OS
  AJUSTE_ENTRADA
  AJUSTE_SAIDA

  @@map("stock_movement_type")
}

enum ReservationStatus {
  ATIVA
  CONSUMIDA
  LIBERADA

  @@map("reservation_status")
}

enum LeftoverCondition {
  BOA
  AVARIADA

  @@map("leftover_condition")
}

enum LeftoverStatus {
  DISPONIVEL
  ESGOTADA
  DESCARTADA

  @@map("leftover_status")
}

enum MaterialReadiness {
  SEM_LEVANTAMENTO
  AGUARDANDO_APROVACAO
  AGUARDANDO_COMPRA
  AGUARDANDO_RECEBIMENTO
  PARCIALMENTE_DISPONIVEL
  COMPLETO
  COM_DIVERGENCIA

  @@map("material_readiness")
}

/// Fornecedor (cadastro simples; sem contratos nem avaliações).
model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(160)
  contactName String?        @map("contact_name") @db.VarChar(120)
  phone       String?        @db.VarChar(30)
  email       String?        @db.VarChar(160)
  address     String?        @db.VarChar(300)
  categories  MaterialKind[]
  notes       String?        @db.VarChar(1000)
  active      Boolean        @default(true)
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]

  // Fase 11: financeiro operacional.
  payables AccountPayable[]

  @@index([name])
  @@map("suppliers")
}

/// Material comum do catálogo (espumas, MDF, ferragens…), com saldo físico e reservado.
/// Tecido não entra no estoque comum: é sempre da OS que o comprou.
model StockItem {
  id          String       @id @default(uuid()) @db.Uuid
  number      Int          @unique @default(autoincrement())
  kind        MaterialKind
  description String       @db.VarChar(160)
  foamDensity String?      @map("foam_density") @db.VarChar(30)
  thicknessCm Decimal?     @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm    Decimal?     @map("length_cm") @db.Decimal(8, 2)
  widthCm     Decimal?     @map("width_cm") @db.Decimal(8, 2)
  unit        MaterialUnit
  /// Especificação normalizada: impede dois cadastros do mesmo material.
  specKey     String       @unique @map("spec_key") @db.VarChar(400)
  onHand      Decimal      @default(0) @map("on_hand") @db.Decimal(12, 3)
  reserved    Decimal      @default(0) @db.Decimal(12, 3)
  minQuantity Decimal?     @map("min_quantity") @db.Decimal(12, 3)
  location    String?      @db.VarChar(120)
  notes       String?      @db.VarChar(500)
  active      Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  movements     StockMovement[]
  reservations  StockReservation[]
  purchaseItems PurchaseOrderItem[]
  issues        ProductionIssue[]

  @@map("stock_items")
}

/// Movimentação de estoque (imutável). `quantity` com sinal; saldo após o lançamento.
model StockMovement {
  id                    String            @id @default(uuid()) @db.Uuid
  stockItemId           String            @map("stock_item_id") @db.Uuid
  type                  StockMovementType
  quantity              Decimal           @db.Decimal(12, 3)
  balanceAfter          Decimal           @map("balance_after") @db.Decimal(12, 3)
  reservedAfter         Decimal           @map("reserved_after") @db.Decimal(12, 3)
  serviceOrderId        String?           @map("service_order_id") @db.Uuid
  materialReceiptLineId String?           @map("material_receipt_line_id") @db.Uuid
  reservationId         String?           @map("reservation_id") @db.Uuid
  reason                String?           @db.VarChar(500)
  actorId               String?           @map("actor_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  stockItem    StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder?        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  receiptLine  MaterialReceiptLine? @relation(fields: [materialReceiptLineId], references: [id], onDelete: Restrict)
  reservation  StockReservation?    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actor        User?                @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
  @@index([serviceOrderId])
  @@index([reservationId])
  @@index([materialReceiptLineId])
  @@map("stock_movements")
}

/// Reserva de material comum para uma OS (impede que duas OS usem a mesma quantidade).
model StockReservation {
  id                    String            @id @default(uuid()) @db.Uuid
  stockItemId           String            @map("stock_item_id") @db.Uuid
  serviceOrderId        String            @map("service_order_id") @db.Uuid
  materialRequirementId String?           @map("material_requirement_id") @db.Uuid
  quantity              Decimal           @db.Decimal(12, 3)
  status                ReservationStatus @default(ATIVA)
  notes                 String?           @db.VarChar(300)
  createdById           String?           @map("created_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById            String?           @map("closed_by_id") @db.Uuid
  closeReason           String?           @map("close_reason") @db.VarChar(500)
  version               Int               @default(1)

  stockItem    StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder         @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  requirement  MaterialRequirement? @relation(fields: [materialRequirementId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy     User?                @relation("ReservationClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements    StockMovement[]

  @@index([serviceOrderId])
  @@index([stockItemId, status])
  @@index([materialRequirementId])
  @@map("stock_reservations")
}

/// Pedido de compra (CP-00001). Preços em centavos; sem pagamentos.
model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  number             Int                 @unique @default(autoincrement())
  supplierId         String?             @map("supplier_id") @db.Uuid
  status             PurchaseOrderStatus @default(RASCUNHO)
  expectedDate       DateTime?           @map("expected_date") @db.Date
  notes              String?             @db.VarChar(2000)
  createdById        String?             @map("created_by_id") @db.Uuid
  confirmedAt        DateTime?           @map("confirmed_at") @db.Timestamptz(3)
  confirmedById      String?             @map("confirmed_by_id") @db.Uuid
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?             @map("cancelled_by_id") @db.Uuid
  cancelReason       String?             @map("cancel_reason") @db.VarChar(500)
  /// Fase 12: saldo pendente encerrado (o recebido é preservado).
  balanceClosedAt    DateTime?           @map("balance_closed_at") @db.Timestamptz(3)
  balanceClosedById  String?             @map("balance_closed_by_id") @db.Uuid
  balanceCloseReason String?             @map("balance_close_reason") @db.VarChar(500)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier        Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  balanceClosedBy User?                  @relation("PurchaseOrderBalanceClosedBy", fields: [balanceClosedById], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy     User?                  @relation("PurchaseOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledBy     User?                  @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items           PurchaseOrderItem[]
  history         PurchaseOrderHistory[]
  receipts        MaterialReceipt[]

  @@index([status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String           @id @default(uuid()) @db.Uuid
  purchaseOrderId  String           @map("purchase_order_id") @db.Uuid
  position         Int
  kind             MaterialKind
  sourcing         MaterialSourcing
  description      String           @db.VarChar(160)
  color            String?          @db.VarChar(60)
  reference        String?          @db.VarChar(80)
  foamDensity      String?          @map("foam_density") @db.VarChar(30)
  thicknessCm      Decimal?         @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm         Decimal?         @map("length_cm") @db.Decimal(8, 2)
  widthCm          Decimal?         @map("width_cm") @db.Decimal(8, 2)
  unit             MaterialUnit
  quantity         Decimal          @db.Decimal(12, 3)
  /// Recebimento acima do pedido autorizado explicitamente pelo gestor.
  extraAuthorized  Decimal          @default(0) @map("extra_authorized") @db.Decimal(12, 3)
  /// Recebido conforme, líquido de estornos (mantido na mesma transação).
  receivedQuantity Decimal          @default(0) @map("received_quantity") @db.Decimal(12, 3)
  /// Fase 12: saldo encerrado (não será entregue). Pedido = quantidade − encerrado.
  closedQuantity   Decimal          @default(0) @map("closed_quantity") @db.Decimal(12, 3)
  unitPriceCents   Int?             @map("unit_price_cents")
  serviceOrderId   String?          @map("service_order_id") @db.Uuid
  stockItemId      String?          @map("stock_item_id") @db.Uuid
  notes            String?          @db.VarChar(500)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  serviceOrder  ServiceOrder?         @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  stockItem     StockItem?            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  allocations   PurchaseAllocation[]
  receiptLines  MaterialReceiptLine[]

  @@unique([purchaseOrderId, position])
  @@index([serviceOrderId])
  @@index([stockItemId])
  @@map("purchase_order_items")
}

/// Origem da quantidade comprada: necessidade aprovada de uma OS (preservada na compra consolidada).
model PurchaseAllocation {
  id                    String   @id @default(uuid()) @db.Uuid
  purchaseOrderItemId   String   @map("purchase_order_item_id") @db.Uuid
  materialRequirementId String   @map("material_requirement_id") @db.Uuid
  serviceOrderId        String   @map("service_order_id") @db.Uuid
  quantity              Decimal  @db.Decimal(12, 3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item         PurchaseOrderItem   @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  requirement  MaterialRequirement @relation(fields: [materialRequirementId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderItemId, materialRequirementId])
  @@index([materialRequirementId])
  @@index([serviceOrderId])
  @@map("purchase_allocations")
}

/// Histórico imutável do pedido de compra.
model PurchaseOrderHistory {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  kind            String   @db.VarChar(40)
  note            String?  @db.VarChar(500)
  changes         Json?
  actorId         String?  @map("actor_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  actor         User?         @relation("PurchaseOrderHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId, createdAt])
  @@map("purchase_order_history")
}

/// Recebimento de materiais (RM-00001), imutável; correções por estorno.
model MaterialReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  number          Int      @unique @default(autoincrement())
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  receivedById    String   @map("received_by_id") @db.Uuid
  deviceId        String?  @map("device_id") @db.Uuid
  notes           String?  @db.VarChar(1000)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy    User                  @relation("MaterialReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines         MaterialReceiptLine[]

  @@index([purchaseOrderId])
  @@map("material_receipts")
}

model MaterialReceiptLine {
  id                  String        @id @default(uuid()) @db.Uuid
  receiptId           String        @map("receipt_id") @db.Uuid
  purchaseOrderItemId String        @map("purchase_order_item_id") @db.Uuid
  acceptedQuantity    Decimal       @map("accepted_quantity") @db.Decimal(12, 3)
  rejectedQuantity    Decimal       @default(0) @map("rejected_quantity") @db.Decimal(12, 3)
  specConfirmed       Boolean       @map("spec_confirmed")
  issue               ReceiptIssue?
  issueNote           String?       @map("issue_note") @db.VarChar(500)

  receipt   MaterialReceipt           @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  item      PurchaseOrderItem         @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  reversals MaterialReceiptReversal[]
  movements StockMovement[]

  @@index([purchaseOrderItemId])
  @@index([receiptId])
  @@map("material_receipt_lines")
}

/// Estorno (lançamento compensatório) de parte do recebido conforme. Imutável.
model MaterialReceiptReversal {
  id             String   @id @default(uuid()) @db.Uuid
  receiptLineId  String   @map("receipt_line_id") @db.Uuid
  quantity       Decimal  @db.Decimal(12, 3)
  reason         String   @db.VarChar(500)
  authorizedById String   @map("authorized_by_id") @db.Uuid
  impact         Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  line         MaterialReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  authorizedBy User                @relation("ReceiptReversalAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([receiptLineId])
  @@map("material_receipt_reversals")
}

/// Sobra de material após o uso. Tecido continua da OS de origem; só sai por transferência autorizada.
model MaterialLeftover {
  id              String            @id @default(uuid()) @db.Uuid
  serviceOrderId  String            @map("service_order_id") @db.Uuid
  kind            MaterialKind
  description     String            @db.VarChar(160)
  color           String?           @db.VarChar(60)
  reference       String?           @db.VarChar(80)
  foamDensity     String?           @map("foam_density") @db.VarChar(30)
  thicknessCm     Decimal?          @map("thickness_cm") @db.Decimal(8, 2)
  quantity        Decimal           @db.Decimal(12, 3)
  initialQuantity Decimal           @map("initial_quantity") @db.Decimal(12, 3)
  unit            MaterialUnit
  location        String            @db.VarChar(120)
  condition       LeftoverCondition
  reusable        Boolean
  status          LeftoverStatus    @default(DISPONIVEL)
  notes           String?           @db.VarChar(500)
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int               @default(1)

  serviceOrder ServiceOrder               @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  createdBy    User?                      @relation("LeftoverCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  transfers    MaterialLeftoverTransfer[]

  @@index([serviceOrderId])
  @@map("material_leftovers")
}

/// Transferência de sobra entre OS — sempre autorizada pelo gestor (imutável).
model MaterialLeftoverTransfer {
  id                 String   @id @default(uuid()) @db.Uuid
  leftoverId         String   @map("leftover_id") @db.Uuid
  fromServiceOrderId String   @map("from_service_order_id") @db.Uuid
  toServiceOrderId   String   @map("to_service_order_id") @db.Uuid
  toRequirementId    String?  @map("to_requirement_id") @db.Uuid
  quantity           Decimal  @db.Decimal(12, 3)
  reason             String   @db.VarChar(500)
  authorizedById     String   @map("authorized_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  leftover         MaterialLeftover     @relation(fields: [leftoverId], references: [id], onDelete: Restrict)
  fromServiceOrder ServiceOrder         @relation("LeftoverTransferFrom", fields: [fromServiceOrderId], references: [id], onDelete: Restrict)
  toServiceOrder   ServiceOrder         @relation("LeftoverTransferTo", fields: [toServiceOrderId], references: [id], onDelete: Restrict)
  toRequirement    MaterialRequirement? @relation(fields: [toRequirementId], references: [id], onDelete: Restrict)
  authorizedBy     User                 @relation("LeftoverTransferAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([toRequirementId])
  @@index([leftoverId])
  @@map("material_leftover_transfers")
}

// ─────────────────────────── Fase 5: motor de produção ───────────────────────────

enum ProductionActivity {
  DESMONTAGEM
  PREPARACAO
  PREPARACAO_MDF
  CORTE_TECIDO
  CORTE_ESPUMA
  CORTE
  COSTURA
  REVESTIMENTO
  MONTAGEM
  ACABAMENTO
  APOIO
  OUTRA
  CORRECAO
  EMBALAGEM

  @@map("production_activity")
}

enum TaskStatus {
  RASCUNHO
  BLOQUEADA
  PROGRAMADA
  LIBERADA
  EM_EXECUCAO
  PAUSADA
  CONCLUIDA
  CANCELADA

  @@map("task_status")
}

enum TaskRole {
  PRINCIPAL
  APOIO

  @@map("task_role")
}

enum PauseReason {
  FIM_EXPEDIENTE
  AGUARDANDO_ORIENTACAO
  INTERRUPCAO_PROGRAMADA
  OUTRO

  @@map("pause_reason")
}

enum PlanStatus {
  RASCUNHO
  PUBLICADO

  @@map("plan_status")
}

/// Modelo configurável de etapas por tipo de peça (sugestão inicial; cada OS pode ser adaptada).
model ProductionTemplate {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(80)
  pieceTypes PieceType[] @map("piece_types")
  active     Boolean     @default(true)
  version    Int         @default(1)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  steps ProductionTemplateStep[]

  @@map("production_templates")
}

model ProductionTemplateStep {
  id                    String                @id @default(uuid()) @db.Uuid
  templateId            String                @map("template_id") @db.Uuid
  position              Int
  activity              ProductionActivity
  name                  String                @db.VarChar(80)
  role                  TaskRole              @default(APOIO)
  requiresMaterials     Boolean               @default(false) @map("requires_materials")
  optional              Boolean               @default(false)
  dependsOn             Int[]                 @map("depends_on")
  /// Fase 6: registro exigido para concluir a tarefa gerada por esta etapa.
  completionRequirement CompletionRequirement @default(NENHUM) @map("completion_requirement")
  /// Evolução Fase 3: classificação explícita (nula = ambígua, exige revisão do gestor).
  stepClass             StepClass?            @map("step_class")

  template ProductionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("production_template_steps")
}

/// Planejamento semanal de produção (um por semana; segunda-feira como referência).
/// Evolução Fase 2: LEGADO = programação por horário (planos antigos, intocados);
/// FILA_SEMANAL = fila contínua por funcionário, sem horário como pré-condição.
/// Evolução Fase 3: função da etapa para a distribuição automática.
enum StepClass {
  PREPARACAO
  TAPECARIA
  OUTRA

  @@map("step_class")
}

enum PlanMode {
  LEGADO
  FILA_SEMANAL

  @@map("plan_mode")
}

model ProductionPlan {
  id            String     @id @default(uuid()) @db.Uuid
  weekStart     DateTime   @unique @map("week_start") @db.Date
  status        PlanStatus @default(RASCUNHO)
  /// Imutável depois de criado (trigger). Planos existentes ficam LEGADO.
  mode          PlanMode   @default(LEGADO)
  /// Número da última revisão publicada (0 = nunca publicado).
  revision      Int        @default(0)
  notes         String?    @db.VarChar(1000)
  createdById   String?    @map("created_by_id") @db.Uuid
  publishedAt   DateTime?  @map("published_at") @db.Timestamptz(3)
  publishedById String?    @map("published_by_id") @db.Uuid
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User?                    @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy  User?                    @relation("PlanPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  items        ProductionPlanItem[]
  tasks        ProductionTask[]
  revisions    ProductionPlanRevision[]
  carriedTasks ProductionTask[]         @relation("TaskCarriedFrom")

  @@map("production_plans")
}

/// OS selecionada para a semana, com o tapeceiro principal e a prioridade.
model ProductionPlanItem {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  serviceOrderId  String   @map("service_order_id") @db.Uuid
  principalUserId String?  @map("principal_user_id") @db.Uuid
  priority        Priority @default(NORMAL)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan         ProductionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  principal    User?          @relation("PlanItemPrincipal", fields: [principalUserId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceOrderId])
  @@index([serviceOrderId])
  @@map("production_plan_items")
}

/// Revisão publicada (imutável): cópia completa das tarefas, quem publicou e por quê.
model ProductionPlanRevision {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  revision    Int
  reason      String?  @db.VarChar(500)
  offSchedule Boolean  @default(false) @map("off_schedule")
  snapshot    Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan      ProductionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("PlanRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([planId, revision])
  @@map("production_plan_revisions")
}

/// Tarefa individual de produção (TP-00001).
model ProductionTask {
  id                    String                @id @default(uuid()) @db.Uuid
  number                Int                   @unique @default(autoincrement())
  planId                String?               @map("plan_id") @db.Uuid
  serviceOrderId        String                @map("service_order_id") @db.Uuid
  serviceOrderItemId    String?               @map("service_order_item_id") @db.Uuid
  activity              ProductionActivity
  title                 String                @db.VarChar(120)
  role                  TaskRole              @default(APOIO)
  assigneeUserId        String?               @map("assignee_user_id") @db.Uuid
  priority              Priority              @default(NORMAL)
  sequence              Int                   @default(0)
  scheduledAt           DateTime?             @map("scheduled_at") @db.Timestamptz(3)
  dueDate               DateTime?             @map("due_date") @db.Date
  instructions          String?               @db.VarChar(2000)
  requiresMaterials     Boolean               @default(false) @map("requires_materials")
  status                TaskStatus            @default(RASCUNHO)
  blockers              String[]              @default([])
  blockedReason         String?               @map("blocked_reason") @db.VarChar(500)
  startedAt             DateTime?             @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(3)
  completedById         String?               @map("completed_by_id") @db.Uuid
  completedDeviceId     String?               @map("completed_device_id") @db.Uuid
  pauseReason           PauseReason?          @map("pause_reason")
  pauseNote             String?               @map("pause_note") @db.VarChar(300)
  progressNote          String?               @map("progress_note") @db.VarChar(500)
  progressPercent       Int?                  @map("progress_percent")
  progressAt            DateTime?             @map("progress_at") @db.Timestamptz(3)
  cancelReason          String?               @map("cancel_reason") @db.VarChar(500)
  /// Fase 6: andamento estruturado (etapa atual e próximo passo) e pausa por impedimento real.
  progressStep          String?               @map("progress_step") @db.VarChar(200)
  progressNext          String?               @map("progress_next") @db.VarChar(200)
  pauseImpediment       Boolean               @default(false) @map("pause_impediment")
  completionRequirement CompletionRequirement @default(NENHUM) @map("completion_requirement")
  completionNote        String?               @map("completion_note") @db.VarChar(500)
  /// Fase 8: duração estimada e vínculo da tarefa de apoio com a tarefa principal.
  estimatedMinutes      Int?                  @map("estimated_minutes")
  supportForTaskId      String?               @map("support_for_task_id") @db.Uuid
  /// Fase 9: tarefa de resolução de uma ocorrência (separada da tarefa de produção original).
  issueId               String?               @map("issue_id") @db.Uuid
  /// Fase 10: correção ou embalagem ligada a uma inspeção de qualidade.
  inspectionId          String?               @map("inspection_id") @db.Uuid
  /// Evolução Fase 2 (modo fila): posição definida pelo gestor dentro da faixa de prioridade
  /// (nula = ordem natural por prioridade, sequência e número).
  queuePosition         Int?                  @map("queue_position")
  /// Semana de origem quando a pendência foi transferida pelo gestor.
  carriedFromPlanId     String?               @map("carried_from_plan_id") @db.Uuid
  /// Calculado no banco (trigger): tarefa de plano em fila que não é apoio. No máximo uma
  /// delas EM_EXECUCAO por responsável (índice único parcial).
  queueExclusive        Boolean               @default(false) @map("queue_exclusive")
  /// Evolução Fase 3: classe da etapa e origem da geração automática (chave de idempotência).
  stepClass             StepClass?            @map("step_class")
  templateId            String?               @map("template_id") @db.Uuid
  templateVersion       Int?                  @map("template_version")
  templateStepPosition  Int?                  @map("template_step_position")
  version               Int                   @default(1)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan              ProductionPlan?          @relation(fields: [planId], references: [id], onDelete: Restrict)
  carriedFromPlan   ProductionPlan?          @relation("TaskCarriedFrom", fields: [carriedFromPlanId], references: [id], onDelete: Restrict)
  serviceOrder      ServiceOrder             @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  serviceOrderItem  ServiceOrderItem?        @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  assignee          User?                    @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  completedBy       User?                    @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  dependsOn         TaskDependency[]         @relation("TaskDependsOn")
  dependents        TaskDependency[]         @relation("TaskDependents")
  events            ProductionTaskEvent[]
  materials         ProductionTaskMaterial[]
  notifications     Notification[]
  attendanceImpacts AttendanceImpact[]
  supportFor        ProductionTask?          @relation("SupportFor", fields: [supportForTaskId], references: [id], onDelete: Restrict)
  supportTasks      ProductionTask[]         @relation("SupportFor")
  helpRequests      HelpRequest[]            @relation("HelpRequestTask")
  helpSupport       HelpRequest?             @relation("HelpRequestSupportTask")
  issues            ProductionIssue[]        @relation("IssueTask")
  issueAction       ProductionIssue?         @relation("IssueActionTask")
  issue             ProductionIssue?         @relation("IssueActions", fields: [issueId], references: [id], onDelete: Restrict)
  inspection        QualityInspection?       @relation("InspectionTasks", fields: [inspectionId], references: [id], onDelete: Restrict)
  packagingRecord   PackagingRecord?         @relation("PackagingTask")

  @@index([assigneeUserId, status])
  @@index([supportForTaskId])
  @@index([issueId])
  @@index([inspectionId])
  @@index([serviceOrderId])
  @@index([planId])
  @@index([status, scheduledAt])
  @@index([serviceOrderItemId])
  @@map("production_tasks")
}

/// Dependência explícita: `taskId` só começa depois de `dependsOnId` concluída (grafo acíclico).
model TaskDependency {
  taskId      String   @map("task_id") @db.Uuid
  dependsOnId String   @map("depends_on_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task      ProductionTask @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn ProductionTask @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("production_task_dependencies")
}

/// Histórico imutável de cada tarefa (criação, publicação, liberação, execução, revisões).
model ProductionTaskEvent {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  kind       String   @db.VarChar(40)
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String?  @map("to_status") @db.VarChar(20)
  note       String?  @db.VarChar(500)
  changes    Json?
  actorId    String?  @map("actor_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task  ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User?          @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("production_task_events")
}

/// Fase 6: registro exigido para concluir uma tarefa (somente o necessário).
enum CompletionRequirement {
  NENHUM
  OBSERVACAO
  FOTO

  @@map("completion_requirement")
}

/// Fase 6: materiais aprovados da OS dos quais uma tarefa depende (liberação por tarefa).
/// Sem vínculos, a tarefa que exige materiais continua dependendo da OS inteira (conservador).
model ProductionTaskMaterial {
  taskId        String   @map("task_id") @db.Uuid
  requirementId String   @map("requirement_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task        ProductionTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requirement MaterialRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([taskId, requirementId])
  @@index([requirementId])
  @@map("production_task_materials")
}

/// Fase 6: notificações persistentes por usuário (tablets e painel), sem duplicidade.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  kind           String    @db.VarChar(40)
  title          String    @db.VarChar(80)
  body           String    @db.VarChar(300)
  taskId         String?   @map("task_id") @db.Uuid
  serviceOrderId String?   @map("service_order_id") @db.Uuid
  dedupeKey      String    @map("dedupe_key") @db.VarChar(160)
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User            @relation("UserNotifications", fields: [userId], references: [id], onDelete: Restrict)
  task         ProductionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder?   @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([taskId])
  @@map("notifications")
}

// ─────────────────────────── Presença operacional (Fase 7) ───────────────────────────

enum AttendanceSituation {
  PRESENTE
  AUSENCIA_PRESUMIDA
  AUSENCIA_CONFIRMADA
  AUSENCIA_JUSTIFICADA
  ATESTADO
  FOLGA
  FERIAS
  TRABALHO_EXTERNO
  ENCERRADO

  @@map("attendance_situation")
}

enum ArrivalKind {
  NO_HORARIO
  ATRASO
  APOS_AUSENCIA_PRESUMIDA

  @@map("arrival_kind")
}

/// Presença operacional de um funcionário num dia (organização da produção; NÃO é ponto
/// eletrônico nem prova de jornada). Um registro por funcionário e data operacional.
model OperationalAttendance {
  id                String              @id @default(uuid()) @db.Uuid
  employeeId        String              @map("employee_id") @db.Uuid
  /// Data operacional no fuso da empresa.
  date              DateTime            @db.Date
  situation         AttendanceSituation
  arrivedAt         DateTime?           @map("arrived_at") @db.Timestamptz(3)
  arrivalKind       ArrivalKind?        @map("arrival_kind")
  lateMinutes       Int                 @default(0) @map("late_minutes")
  /// Quem registrou a chegada (o próprio funcionário ou o gestor em correção) e de qual dispositivo.
  arrivalById       String?             @map("arrival_by_id") @db.Uuid
  arrivalDeviceId   String?             @map("arrival_device_id") @db.Uuid
  departedAt        DateTime?           @map("departed_at") @db.Timestamptz(3)
  departureById     String?             @map("departure_by_id") @db.Uuid
  departureDeviceId String?             @map("departure_device_id") @db.Uuid
  earlyDeparture    Boolean             @default(false) @map("early_departure")
  departureNote     String?             @map("departure_note") @db.VarChar(500)
  presumedAbsentAt  DateTime?           @map("presumed_absent_at") @db.Timestamptz(3)
  /// Atividade externa ou justificativa (texto livre curto; sem dados médicos).
  note              String?             @db.VarChar(300)
  availability      String              @default("NAO_CONFIRMOU") @db.VarChar(30)
  availabilityAt    DateTime            @default(now()) @map("availability_at") @db.Timestamptz(3)
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  arrivalBy   User?                  @relation("AttendanceArrivalBy", fields: [arrivalById], references: [id], onDelete: SetNull)
  departureBy User?                  @relation("AttendanceDepartureBy", fields: [departureById], references: [id], onDelete: SetNull)
  corrections AttendanceCorrection[]
  impacts     AttendanceImpact[]
  proposals   RescheduleProposal[]

  @@unique([employeeId, date])
  @@index([date, situation])
  @@map("operational_attendances")
}

/// Histórico imutável de cada registro de presença (chegada, saída, ausência presumida,
/// correções e justificativas do gestor), com o estado anterior e o novo.
model AttendanceCorrection {
  id           String   @id @default(uuid()) @db.Uuid
  attendanceId String   @map("attendance_id") @db.Uuid
  action       String   @db.VarChar(40)
  reason       String?  @db.VarChar(300)
  before       Json?
  after        Json
  actorId      String?  @map("actor_id") @db.Uuid
  deviceId     String?  @map("device_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attendance OperationalAttendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  actor      User?                 @relation("AttendanceCorrectionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([attendanceId, createdAt])
  @@map("attendance_corrections")
}

/// Impactos identificados (tarefas do ausente e dependentes) e pendências de encerramento.
/// Só identifica e apresenta: nada é cancelado ou transferido automaticamente.
model AttendanceImpact {
  id             String    @id @default(uuid()) @db.Uuid
  attendanceId   String    @map("attendance_id") @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  kind           String    @db.VarChar(30)
  affectedUserId String?   @map("affected_user_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Date
  detail         String    @db.VarChar(300)
  detectedAt     DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById   String?   @map("resolved_by_id") @db.Uuid
  resolution     String?   @db.VarChar(300)

  attendance   OperationalAttendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  task         ProductionTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  affectedUser User?                 @relation("AttendanceImpactAffected", fields: [affectedUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?                 @relation("AttendanceImpactResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([attendanceId, taskId, kind])
  @@index([detectedAt])
  @@map("attendance_impacts")
}

// ─────────────────────────── Ajuda e reprogramação (Fase 8) ───────────────────────────

/// Competências cadastradas pelo gestor (base da seleção de ajudantes).
model EmployeeSkill {
  employeeId  String   @map("employee_id") @db.Uuid
  skill       String   @db.VarChar(30)
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  grantedBy User?    @relation("SkillGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([employeeId, skill])
  @@index([skill])
  @@map("employee_skills")
}

enum HelpStatus {
  PENDENTE
  ATRIBUIDA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
  ESCALADA

  @@map("help_status")
}

/// Solicitação de ajuda de um tapeceiro numa tarefa própria. A ajuda vira uma tarefa de
/// apoio separada (nunca conclui a tarefa principal).
model HelpRequest {
  id               String     @id @default(uuid()) @db.Uuid
  number           Int        @unique @default(autoincrement())
  taskId           String     @map("task_id") @db.Uuid
  serviceOrderId   String     @map("service_order_id") @db.Uuid
  requesterUserId  String     @map("requester_user_id") @db.Uuid
  kind             String     @db.VarChar(30)
  estimatedMinutes Int        @map("estimated_minutes")
  urgent           Boolean    @default(false)
  justification    String?    @db.VarChar(300)
  note             String?    @db.VarChar(300)
  status           HelpStatus @default(PENDENTE)
  helperUserId     String?    @map("helper_user_id") @db.Uuid
  supportTaskId    String?    @unique @map("support_task_id") @db.Uuid
  assignedAt       DateTime?  @map("assigned_at") @db.Timestamptz(3)
  escalatedAt      DateTime?  @map("escalated_at") @db.Timestamptz(3)
  delayAlertedAt   DateTime?  @map("delay_alerted_at") @db.Timestamptz(3)
  completedAt      DateTime?  @map("completed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?  @map("cancelled_at") @db.Timestamptz(3)
  cancelledById    String?    @map("cancelled_by_id") @db.Uuid
  cancelReason     String?    @map("cancel_reason") @db.VarChar(300)
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  task         ProductionTask       @relation("HelpRequestTask", fields: [taskId], references: [id], onDelete: Restrict)
  supportTask  ProductionTask?      @relation("HelpRequestSupportTask", fields: [supportTaskId], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder         @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  requester    User                 @relation("HelpRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  helper       User?                @relation("HelpHelper", fields: [helperUserId], references: [id], onDelete: SetNull)
  events       HelpRequestEvent[]
  proposals    RescheduleProposal[]

  @@index([status, urgent, createdAt])
  @@index([requesterUserId, createdAt])
  @@index([helperUserId, status])
  @@index([serviceOrderId])
  @@map("help_requests")
}

/// Histórico imutável de cada solicitação (inclui a avaliação dos candidatos).
model HelpRequestEvent {
  id            String   @id @default(uuid()) @db.Uuid
  helpRequestId String   @map("help_request_id") @db.Uuid
  kind          String   @db.VarChar(30)
  fromStatus    String?  @map("from_status") @db.VarChar(20)
  toStatus      String?  @map("to_status") @db.VarChar(20)
  note          String?  @db.VarChar(500)
  evaluation    Json?
  actorId       String?  @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  helpRequest HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Restrict)
  actor       User?       @relation("HelpEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([helpRequestId, createdAt])
  @@map("help_request_events")
}

enum ProposalStatus {
  PENDENTE
  APROVADA
  AJUSTADA
  REJEITADA
  OBSOLETA

  @@map("proposal_status")
}

/// Proposta de reprogramação que exige decisão do gestor (nada é aplicado antes).
model RescheduleProposal {
  id                    String         @id @default(uuid()) @db.Uuid
  number                Int            @unique @default(autoincrement())
  kind                  String         @db.VarChar(30)
  status                ProposalStatus @default(PENDENTE)
  critical              Boolean        @default(true)
  situation             String         @db.VarChar(500)
  problem               String         @db.VarChar(500)
  affectedTaskIds       String[]       @map("affected_task_ids") @db.Uuid
  alternatives          Json
  proposedAlternativeId String         @map("proposed_alternative_id") @db.VarChar(40)
  chosenAlternativeId   String?        @map("chosen_alternative_id") @db.VarChar(40)
  appliedActions        Json?          @map("applied_actions")
  /// Evita propostas duplicadas para o mesmo fato (ex.: ausência + tarefa).
  dedupeKey             String         @unique @map("dedupe_key") @db.VarChar(160)
  attendanceId          String?        @map("attendance_id") @db.Uuid
  helpRequestId         String?        @map("help_request_id") @db.Uuid
  /// Fase 9: ocorrência que originou a proposta de bloqueio.
  issueId               String?        @map("issue_id") @db.Uuid
  decidedById           String?        @map("decided_by_id") @db.Uuid
  decidedAt             DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote          String?        @map("decision_note") @db.VarChar(500)
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  attendance  OperationalAttendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  helpRequest HelpRequest?           @relation(fields: [helpRequestId], references: [id], onDelete: SetNull)
  issue       ProductionIssue?       @relation(fields: [issueId], references: [id], onDelete: SetNull)
  decidedBy   User?                  @relation("ProposalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("reschedule_proposals")
}

/// Histórico imutável de toda alteração automática ou aprovada do planejamento.
model PlanningAction {
  id            String   @id @default(uuid()) @db.Uuid
  kind          String   @db.VarChar(30)
  automatic     Boolean
  taskId        String?  @map("task_id") @db.Uuid
  helpRequestId String?  @map("help_request_id") @db.Uuid
  proposalId    String?  @map("proposal_id") @db.Uuid
  reason        String   @db.VarChar(500)
  before        Json?
  after         Json?
  actorId       String?  @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("PlanningActionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([taskId])
  @@map("planning_actions")
}

// ─────────────────────────── Ocorrências e central de atenção (Fase 9) ───────────────────────────

enum IssueStatus {
  ABERTA
  ATRIBUIDA
  EM_RESOLUCAO
  AGUARDANDO_VERIFICACAO
  RESOLVIDA
  CANCELADA

  @@map("issue_status")
}

/// Ocorrência (impedimento) registrada no tablet ou pelo gestor (OC-00001). Nunca é apagada:
/// encerra como resolvida ou cancelada (com motivo) e pode ser reaberta (com motivo).
model ProductionIssue {
  id                    String        @id @default(uuid()) @db.Uuid
  number                Int           @unique @default(autoincrement())
  kind                  String        @db.VarChar(20)
  status                IssueStatus   @default(ABERTA)
  impact                String        @db.VarChar(20)
  /// Impede a tarefa (bloqueio total ou "faz outra atividade"): a tarefa só volta com a resolução.
  blocksTask            Boolean       @map("blocks_task")
  priority              Priority      @default(NORMAL)
  description           String        @db.VarChar(1000)
  taskId                String        @map("task_id") @db.Uuid
  serviceOrderId        String        @map("service_order_id") @db.Uuid
  reporterUserId        String        @map("reporter_user_id") @db.Uuid
  reporterDeviceId      String?       @map("reporter_device_id") @db.Uuid
  // Falta de material (nada é comprado automaticamente).
  materialRequirementId String?       @map("material_requirement_id") @db.Uuid
  stockItemId           String?       @map("stock_item_id") @db.Uuid
  materialDescription   String?       @map("material_description") @db.VarChar(200)
  materialQuantity      Decimal?      @map("material_quantity") @db.Decimal(12, 3)
  materialUnit          MaterialUnit? @map("material_unit")
  // Delegação.
  assigneeUserId        String?       @map("assignee_user_id") @db.Uuid
  actionTaskId          String?       @unique @map("action_task_id") @db.Uuid
  requiredSkill         String?       @map("required_skill") @db.VarChar(30)
  dueAt                 DateTime?     @map("due_at") @db.Timestamptz(3)
  riskAlertedAt         DateTime?     @map("risk_alerted_at") @db.Timestamptz(3)
  resultNote            String?       @map("result_note") @db.VarChar(1000)
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedById          String?       @map("resolved_by_id") @db.Uuid
  cancelledAt           DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?       @map("cancelled_by_id") @db.Uuid
  cancelReason          String?       @map("cancel_reason") @db.VarChar(500)
  reopenCount           Int           @default(0) @map("reopen_count")
  version               Int           @default(1)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  task         ProductionTask         @relation("IssueTask", fields: [taskId], references: [id], onDelete: Restrict)
  actionTask   ProductionTask?        @relation("IssueActionTask", fields: [actionTaskId], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder           @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  reporter     User                   @relation("IssueReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  assignee     User?                  @relation("IssueAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?                  @relation("IssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  cancelledBy  User?                  @relation("IssueCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  requirement  MaterialRequirement?   @relation(fields: [materialRequirementId], references: [id], onDelete: Restrict)
  stockItem    StockItem?             @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  events       ProductionIssueEvent[]
  proposals    RescheduleProposal[]
  actionTasks  ProductionTask[]       @relation("IssueActions")

  @@index([status, createdAt])
  @@index([taskId, status])
  @@index([assigneeUserId, status])
  @@index([serviceOrderId])
  @@index([materialRequirementId])
  @@map("production_issues")
}

/// Histórico imutável da ocorrência (abertura, atribuições, ações, verificação, reabertura...).
model ProductionIssueEvent {
  id         String   @id @default(uuid()) @db.Uuid
  issueId    String   @map("issue_id") @db.Uuid
  kind       String   @db.VarChar(30)
  fromStatus String?  @map("from_status") @db.VarChar(30)
  toStatus   String?  @map("to_status") @db.VarChar(30)
  note       String?  @db.VarChar(1000)
  data       Json?
  actorId    String?  @map("actor_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  issue ProductionIssue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  actor User?           @relation("IssueEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@map("production_issue_events")
}

// ─────────────────────────── Qualidade, embalagem e logística (Fase 10) ───────────────────────────

enum InspectionStatus {
  PENDENTE
  EM_ANDAMENTO
  APROVADA
  REPROVADA
  INVALIDADA
  CANCELADA

  @@map("inspection_status")
}

/// Modelo de checklist de inspeção por tipo de peça (configurável pelo gestor).
model QualityTemplate {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(80)
  pieceTypes PieceType[] @map("piece_types")
  active     Boolean     @default(true)
  version    Int         @default(1)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  items       QualityTemplateItem[]
  inspections QualityInspection[]

  @@map("quality_templates")
}

model QualityTemplateItem {
  id           String        @id @default(uuid()) @db.Uuid
  templateId   String        @map("template_id") @db.Uuid
  position     Int
  label        String        @db.VarChar(120)
  guidance     String?       @db.VarChar(300)
  required     Boolean       @default(true)
  /// Tipos de serviço em que o item se aplica (vazio = todos): não exige o irrelevante.
  serviceTypes ServiceType[] @map("service_types")

  template QualityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("quality_template_items")
}

/// Inspeção de qualidade de uma peça (IQ-00001). Rodadas: 1ª após a produção, nova após correção
/// ou alteração técnica. Decisões nunca são apagadas.
model QualityInspection {
  id                     String           @id @default(uuid()) @db.Uuid
  number                 Int              @unique @default(autoincrement())
  serviceOrderItemId     String           @map("service_order_item_id") @db.Uuid
  serviceOrderId         String           @map("service_order_id") @db.Uuid
  templateId             String?          @map("template_id") @db.Uuid
  round                  Int
  reason                 String           @db.VarChar(30)
  status                 InspectionStatus @default(PENDENTE)
  inspectorUserId        String?          @map("inspector_user_id") @db.Uuid
  /// Por que precisa de substituto (inspetor ausente ou executou o serviço).
  substituteReason       String?          @map("substitute_reason") @db.VarChar(300)
  executorAuthorizedById String?          @map("executor_authorized_by_id") @db.Uuid
  priority               Priority         @default(NORMAL)
  dueDate                DateTime?        @map("due_date") @db.Date
  itemVersion            Int              @map("item_version")
  osRevision             Int?             @map("os_revision")
  previousInspectionId   String?          @map("previous_inspection_id") @db.Uuid
  startedAt              DateTime?        @map("started_at") @db.Timestamptz(3)
  decidedAt              DateTime?        @map("decided_at") @db.Timestamptz(3)
  decidedById            String?          @map("decided_by_id") @db.Uuid
  decidedDeviceId        String?          @map("decided_device_id") @db.Uuid
  decisionNote           String?          @map("decision_note") @db.VarChar(1000)
  invalidatedAt          DateTime?        @map("invalidated_at") @db.Timestamptz(3)
  invalidReason          String?          @map("invalid_reason") @db.VarChar(500)
  version                Int              @default(1)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrderItem ServiceOrderItem        @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  serviceOrder     ServiceOrder            @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  template         QualityTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  inspector        User?                   @relation("InspectionInspector", fields: [inspectorUserId], references: [id], onDelete: SetNull)
  decidedBy        User?                   @relation("InspectionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  items            QualityInspectionItem[]
  tasks            ProductionTask[]        @relation("InspectionTasks")
  packaging        PackagingRecord?

  @@unique([serviceOrderItemId, round])
  @@index([status, createdAt])
  @@index([inspectorUserId, status])
  @@index([serviceOrderId])
  @@map("quality_inspections")
}

model QualityInspectionItem {
  id           String    @id @default(uuid()) @db.Uuid
  inspectionId String    @map("inspection_id") @db.Uuid
  position     Int
  label        String    @db.VarChar(120)
  guidance     String?   @db.VarChar(300)
  required     Boolean   @default(true)
  /// OK, NAO_CONFORME ou NAO_SE_APLICA (null = não conferido).
  result       String?   @db.VarChar(20)
  note         String?   @db.VarChar(500)
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(3)
  checkedById  String?   @map("checked_by_id") @db.Uuid

  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, position])
  @@map("quality_inspection_items")
}

/// Histórico imutável da peça no fluxo de qualidade, embalagem e expedição.
model QualityEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  serviceOrderItemId String   @map("service_order_item_id") @db.Uuid
  inspectionId       String?  @map("inspection_id") @db.Uuid
  kind               String   @db.VarChar(40)
  note               String?  @db.VarChar(1000)
  data               Json?
  actorId            String?  @map("actor_id") @db.Uuid
  deviceId           String?  @map("device_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  actor            User?            @relation("QualityEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([serviceOrderItemId, createdAt])
  @@map("quality_events")
}

enum PackagingStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  INVALIDADA
  CANCELADA

  @@map("packaging_status")
}

/// Embalagem (EB-00001): só existe a partir de uma inspeção aprovada.
model PackagingRecord {
  id                      String          @id @default(uuid()) @db.Uuid
  number                  Int             @unique @default(autoincrement())
  serviceOrderItemId      String          @map("service_order_item_id") @db.Uuid
  serviceOrderId          String          @map("service_order_id") @db.Uuid
  inspectionId            String          @unique @map("inspection_id") @db.Uuid
  taskId                  String?         @unique @map("task_id") @db.Uuid
  status                  PackagingStatus @default(PENDENTE)
  assigneeUserId          String?         @map("assignee_user_id") @db.Uuid
  tapeceiroAuthorizedById String?         @map("tapeceiro_authorized_by_id") @db.Uuid
  protection              String?         @db.VarChar(30)
  locationId              String?         @map("location_id") @db.Uuid
  notes                   String?         @db.VarChar(500)
  startedAt               DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(3)
  completedById           String?         @map("completed_by_id") @db.Uuid
  invalidatedAt           DateTime?       @map("invalidated_at") @db.Timestamptz(3)
  invalidReason           String?         @map("invalid_reason") @db.VarChar(500)
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrderItem ServiceOrderItem  @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  inspection       QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  task             ProductionTask?   @relation("PackagingTask", fields: [taskId], references: [id], onDelete: SetNull)
  assignee         User?             @relation("PackagingAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  location         ItemLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([serviceOrderItemId])
  @@map("packaging_records")
}

/// Localizações internas configuráveis (recebimento, mesa de produção, expedição...).
model ItemLocation {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(30)
  label     String   @db.VarChar(80)
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items     ServiceOrderItem[]
  events    ItemLocationEvent[]
  packaging PackagingRecord[]

  @@map("item_locations")
}

/// Movimentações registradas da peça (imutável; não exige cada pequeno deslocamento).
model ItemLocationEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  serviceOrderItemId String   @map("service_order_item_id") @db.Uuid
  locationId         String   @map("location_id") @db.Uuid
  note               String?  @db.VarChar(300)
  actorId            String?  @map("actor_id") @db.Uuid
  deviceId           String?  @map("device_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  location         ItemLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor            User?            @relation("LocationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([serviceOrderItemId, createdAt])
  @@map("item_location_events")
}

enum DeliveryStatus {
  PROVISORIA
  AGENDADA
  EM_TRANSPORTE
  NO_DESTINO
  CONCLUIDA
  FRUSTRADA
  CANCELADA

  @@map("delivery_status")
}

/// Entrega (EN-00001) combinada pelo gestor; provisória não é confirmada ao cliente.
model Delivery {
  id                   String         @id @default(uuid()) @db.Uuid
  number               Int            @unique @default(autoincrement())
  customerId           String         @map("customer_id") @db.Uuid
  addressId            String?        @map("address_id") @db.Uuid
  addressSnapshot      Json           @map("address_snapshot")
  contactName          String?        @map("contact_name") @db.VarChar(120)
  contactPhone         String?        @map("contact_phone") @db.VarChar(30)
  scheduledDate        DateTime       @map("scheduled_date") @db.Date
  windowStart          String?        @map("window_start") @db.Char(5)
  windowEnd            String?        @map("window_end") @db.Char(5)
  team                 PickupTeam     @default(EQUIPE_PROPRIA)
  responsibleUserId    String?        @map("responsible_user_id") @db.Uuid
  requiresInstallation Boolean        @default(false) @map("requires_installation")
  instructions         String?        @db.VarChar(1000)
  notes                String?        @db.VarChar(1000)
  status               DeliveryStatus @default(PROVISORIA)
  attempts             Int            @default(0)
  departedAt           DateTime?      @map("departed_at") @db.Timestamptz(3)
  arrivedAt            DateTime?      @map("arrived_at") @db.Timestamptz(3)
  installedAt          DateTime?      @map("installed_at") @db.Timestamptz(3)
  installationNote     String?        @map("installation_note") @db.VarChar(1000)
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz(3)
  completionNote       String?        @map("completion_note") @db.VarChar(1000)
  cancelReason         String?        @map("cancel_reason") @db.VarChar(500)
  version              Int            @default(1)
  createdById          String?        @map("created_by_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address     CustomerAddress?      @relation(fields: [addressId], references: [id], onDelete: Restrict)
  responsible User?                 @relation("DeliveryResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdBy   User?                 @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       DeliveryItem[]
  events      DeliveryEvent[]
  occurrences LogisticsOccurrence[]

  // Fase 11: financeiro operacional.
  logisticsCosts LogisticsCost[]

  @@index([scheduledDate])
  @@index([status])
  @@index([responsibleUserId, status])
  @@index([customerId])
  @@map("deliveries")
}

model DeliveryItem {
  deliveryId         String    @map("delivery_id") @db.Uuid
  serviceOrderItemId String    @map("service_order_item_id") @db.Uuid
  /// Uma peça só fica em uma entrega ativa (índice único parcial).
  active             Boolean   @default(true)
  /// PENDENTE, ENTREGUE, DIVERGENTE ou NAO_ENTREGUE.
  status             String    @default("PENDENTE") @db.VarChar(20)
  note               String?   @db.VarChar(500)
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(3)

  delivery         Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)

  @@id([deliveryId, serviceOrderItemId])
  @@index([serviceOrderItemId])
  @@map("delivery_items")
}

/// Histórico imutável da entrega (agendamento, saída, chegada, entrega, instalação, tentativa).
model DeliveryEvent {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  kind       String   @db.VarChar(40)
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String?  @map("to_status") @db.VarChar(20)
  note       String?  @db.VarChar(1000)
  data       Json?
  actorId    String?  @map("actor_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  actor    User?    @relation("DeliveryEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

/// Ocorrência logística (OL-00001): cliente indisponível, peça danificada, endereço incorreto...
model LogisticsOccurrence {
  id                 String    @id @default(uuid()) @db.Uuid
  number             Int       @unique @default(autoincrement())
  kind               String    @db.VarChar(30)
  deliveryId         String?   @map("delivery_id") @db.Uuid
  pickupId           String?   @map("pickup_id") @db.Uuid
  serviceOrderItemId String?   @map("service_order_item_id") @db.Uuid
  description        String    @db.VarChar(1000)
  /// Impede a expedição da peça até resolver (peça danificada, divergência).
  blocksShipping     Boolean   @default(false) @map("blocks_shipping")
  status             String    @default("ABERTA") @db.VarChar(20)
  responsibleUserId  String?   @map("responsible_user_id") @db.Uuid
  reportedById       String?   @map("reported_by_id") @db.Uuid
  deviceId           String?   @map("device_id") @db.Uuid
  resolution         String?   @db.VarChar(1000)
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById       String?   @map("resolved_by_id") @db.Uuid
  cancelReason       String?   @map("cancel_reason") @db.VarChar(500)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  delivery    Delivery?                  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  pickup      PickupRequest?             @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  item        ServiceOrderItem?          @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  responsible User?                      @relation("LogisticsResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  reportedBy  User?                      @relation("LogisticsReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  events      LogisticsOccurrenceEvent[]

  @@index([status, createdAt])
  @@index([deliveryId])
  @@map("logistics_occurrences")
}

model LogisticsOccurrenceEvent {
  id           String   @id @default(uuid()) @db.Uuid
  occurrenceId String   @map("occurrence_id") @db.Uuid
  kind         String   @db.VarChar(30)
  fromStatus   String?  @map("from_status") @db.VarChar(20)
  toStatus     String?  @map("to_status") @db.VarChar(20)
  note         String?  @db.VarChar(1000)
  actorId      String?  @map("actor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  occurrence LogisticsOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  @@index([occurrenceId, createdAt])
  @@map("logistics_occurrence_events")
}

/// Devolução de peças ao cliente (DV-00001): registrada e confirmada; nunca apaga o recebimento.
model PieceReturn {
  id                String    @id @default(uuid()) @db.Uuid
  number            Int       @unique @default(autoincrement())
  orderId           String    @map("order_id") @db.Uuid
  status            String    @default("REGISTRADA") @db.VarChar(20)
  reason            String    @db.VarChar(500)
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  /// Fase 12: destino das peças (ex.: entregue ao cliente no endereço X, retirada na oficina).
  destination       String?   @db.VarChar(200)
  returnDate        DateTime  @map("return_date") @db.Date
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById     String?   @map("confirmed_by_id") @db.Uuid
  confirmationNote  String?   @map("confirmation_note") @db.VarChar(500)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?   @map("cancel_reason") @db.VarChar(500)
  version           Int       @default(1)
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       CommercialOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  responsible User?             @relation("ReturnResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  lines       PieceReturnLine[]

  @@index([orderId])
  @@map("piece_returns")
}

model PieceReturnLine {
  returnId            String   @map("return_id") @db.Uuid
  orderItemId         String   @map("order_item_id") @db.Uuid
  quantity            Int
  /// Peças de OS devolvidas inteiras (as demais vêm das não alocadas em OS).
  serviceOrderItemIds String[] @map("service_order_item_ids") @db.Uuid

  pieceReturn PieceReturn         @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem   CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@id([returnId, orderItemId])
  @@index([orderItemId])
  @@map("piece_return_lines")
}

/// Correção auditável de recebimento físico (o recebimento original é imutável).
model ReceiptCorrection {
  id               String   @id @default(uuid()) @db.Uuid
  receiptLineId    String   @map("receipt_line_id") @db.Uuid
  orderItemId      String   @map("order_item_id") @db.Uuid
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  reason           String   @db.VarChar(500)
  actorId          String?  @map("actor_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receiptLine ReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)

  @@index([receiptLineId])
  @@map("receipt_corrections")
}

// ─────────────────────────── Financeiro operacional (Fase 11) ───────────────────────────

/// Ajuste comercial autorizado do valor do pedido (desconto, acréscimo, ajuste) — imutável.
model CommercialAdjustment {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  /// DESCONTO (negativo), ACRESCIMO (positivo) ou AJUSTE (com sinal).
  kind           String   @db.VarChar(20)
  amountCents    Int      @map("amount_cents")
  reason         String   @db.VarChar(500)
  authorizedById String   @map("authorized_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order        CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  authorizedBy User            @relation("CommercialAdjustmentBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("commercial_adjustments")
}

/// Conta a receber (RC-00001) do cliente, por pedido (e opcionalmente OS).
model CustomerReceivable {
  id             String    @id @default(uuid()) @db.Uuid
  number         Int       @unique @default(autoincrement())
  customerId     String    @map("customer_id") @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  serviceOrderId String?   @map("service_order_id") @db.Uuid
  description    String    @db.VarChar(200)
  amountCents    Int       @map("amount_cents")
  receivedCents  Int       @default(0) @map("received_cents")
  dueDate        DateTime  @map("due_date") @db.Date
  /// PIX, DINHEIRO, CARTAO_CREDITO, CARTAO_DEBITO, BOLETO, TRANSFERENCIA, CHEQUE, OUTRO.
  expectedMethod String    @map("expected_method") @db.VarChar(20)
  /// ABERTO, PARCIAL, RECEBIDO, CANCELADO.
  status         String    @default("ABERTO") @db.VarChar(20)
  notes          String?   @db.VarChar(1000)
  cancelReason   String?   @map("cancel_reason") @db.VarChar(500)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  version        Int       @default(1)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        CommercialOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder?     @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  payments     CustomerPayment[]

  @@index([orderId])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([serviceOrderId])
  @@map("customer_receivables")
}

/// Recebimento (parcial ou total) de uma conta a receber — imutável; estorno por lançamento.
model CustomerPayment {
  id           String   @id @default(uuid()) @db.Uuid
  receivableId String   @map("receivable_id") @db.Uuid
  amountCents  Int      @map("amount_cents")
  receivedAt   DateTime @map("received_at") @db.Date
  method       String   @db.VarChar(20)
  note         String?  @db.VarChar(500)
  /// Estorno de outro recebimento (valor negativo).
  reversalOfId String?  @unique @map("reversal_of_id") @db.Uuid
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receivable CustomerReceivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)

  @@index([receivableId])
  @@index([receivedAt])
  @@map("customer_payments")
}

/// Custo de material por OS (razão imutável derivada de compras, saídas de estoque e sobras;
/// a chave de origem impede duplicar o mesmo fato).
model ServiceOrderCost {
  id                 String   @id @default(uuid()) @db.Uuid
  serviceOrderId     String   @map("service_order_id") @db.Uuid
  serviceOrderItemId String?  @map("service_order_item_id") @db.Uuid
  /// MATERIAL, OUTRO_VARIAVEL.
  category           String   @db.VarChar(20)
  /// COMPRA_EXCLUSIVA, ESTORNO_COMPRA, SAIDA_ESTOQUE, DEVOLUCAO_ESTOQUE, SOBRA_SAIDA, SOBRA_ENTRADA, AJUSTE_MANUAL.
  source             String   @db.VarChar(30)
  sourceKey          String   @unique @map("source_key") @db.VarChar(120)
  description        String   @db.VarChar(200)
  quantity           Decimal? @db.Decimal(12, 3)
  unitCostCents      Int?     @map("unit_cost_cents")
  amountCents        Int      @map("amount_cents")
  /// Sem preço conhecido: valor 0 até o gestor ajustar (sinalizado).
  priced             Boolean  @default(true)
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)
  note               String?  @db.VarChar(500)
  actorId            String?  @map("actor_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId, occurredAt])
  @@map("service_order_costs")
}

/// Mão de obra por produção (MO-00001): valor combinado com o tapeceiro principal por OS/peça.
model ProductionPayable {
  id                 String    @id @default(uuid()) @db.Uuid
  number             Int       @unique @default(autoincrement())
  professionalUserId String    @map("professional_user_id") @db.Uuid
  serviceOrderId     String    @map("service_order_id") @db.Uuid
  serviceOrderItemId String?   @map("service_order_item_id") @db.Uuid
  service            String    @db.VarChar(200)
  agreedCents        Int       @map("agreed_cents")
  adjustmentsCents   Int       @default(0) @map("adjustments_cents")
  paidCents          Int       @default(0) @map("paid_cents")
  /// PRODUCAO_CONCLUIDA, QUALIDADE_APROVADA, ENTREGA_CONCLUIDA.
  eligibility        String    @default("QUALIDADE_APROVADA") @db.VarChar(30)
  /// PREVISTO, LIBERADO, PAGO_PARCIAL, PAGO, CANCELADO.
  status             String    @default("PREVISTO") @db.VarChar(20)
  eligibleAt         DateTime? @map("eligible_at") @db.Timestamptz(3)
  notes              String?   @db.VarChar(500)
  cancelReason       String?   @map("cancel_reason") @db.VarChar(500)
  version            Int       @default(1)
  createdById        String?   @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional User                  @relation("ProductionPayableProfessional", fields: [professionalUserId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  item         ServiceOrderItem?     @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  adjustments  FinancialAdjustment[]
  payments     ProfessionalPayment[]

  @@index([professionalUserId, status])
  @@index([serviceOrderId])
  @@map("production_payables")
}

/// Ajuste autorizado (mão de obra ou custo) — imutável, com motivo e autor.
model FinancialAdjustment {
  id                  String   @id @default(uuid()) @db.Uuid
  productionPayableId String?  @map("production_payable_id") @db.Uuid
  amountCents         Int      @map("amount_cents")
  reason              String   @db.VarChar(500)
  authorizedById      String   @map("authorized_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payable      ProductionPayable? @relation(fields: [productionPayableId], references: [id], onDelete: Restrict)
  authorizedBy User               @relation("FinancialAdjustmentBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([productionPayableId])
  @@map("financial_adjustments")
}

/// Pagamento ao profissional por produção — imutável (registro; nenhuma transferência é feita).
model ProfessionalPayment {
  id                  String   @id @default(uuid()) @db.Uuid
  productionPayableId String   @map("production_payable_id") @db.Uuid
  amountCents         Int      @map("amount_cents")
  paidAt              DateTime @map("paid_at") @db.Date
  method              String   @db.VarChar(20)
  note                String?  @db.VarChar(500)
  /// Pagamento antes da elegibilidade: só com autorização explícita (motivo).
  earlyReason         String?  @map("early_reason") @db.VarChar(500)
  createdById         String?  @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payable ProductionPayable @relation(fields: [productionPayableId], references: [id], onDelete: Restrict)

  @@index([productionPayableId])
  @@index([paidAt])
  @@map("professional_payments")
}

/// Custo mensal de equipe de remuneração fixa (João, Thiago) — não é pagamento por produção.
model TeamMonthlyCost {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  month       DateTime @db.Date
  amountCents Int      @map("amount_cents")
  notes       String?  @db.VarChar(500)
  version     Int      @default(1)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation("TeamMonthlyCostUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, month])
  @@map("team_monthly_costs")
}

/// Custo de logística (LG-00001): uma viagem pode atender várias OS (rateio documentado).
model LogisticsCost {
  id           String    @id @default(uuid()) @db.Uuid
  number       Int       @unique @default(autoincrement())
  /// RETIRADA, ENTREGA, INSTALACAO, TRANSPORTE_TERCEIRIZADO, DESLOCAMENTO.
  kind         String    @db.VarChar(30)
  description  String    @db.VarChar(200)
  amountCents  Int       @map("amount_cents")
  date         DateTime  @db.Date
  deliveryId   String?   @map("delivery_id") @db.Uuid
  pickupId     String?   @map("pickup_id") @db.Uuid
  beneficiary  String?   @db.VarChar(160)
  /// IGUAL, POR_PECA, MANUAL.
  splitMethod  String    @map("split_method") @db.VarChar(20)
  splitNote    String?   @map("split_note") @db.VarChar(500)
  payableId    String?   @unique @map("payable_id") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason") @db.VarChar(500)
  version      Int       @default(1)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  delivery    Delivery?                 @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  pickup      PickupRequest?            @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  payable     AccountPayable?           @relation(fields: [payableId], references: [id], onDelete: Restrict)
  allocations LogisticsCostAllocation[]

  @@index([date])
  @@map("logistics_costs")
}

model LogisticsCostAllocation {
  id                 String  @id @default(uuid()) @db.Uuid
  logisticsCostId    String  @map("logistics_cost_id") @db.Uuid
  serviceOrderId     String  @map("service_order_id") @db.Uuid
  serviceOrderItemId String? @map("service_order_item_id") @db.Uuid
  amountCents        Int     @map("amount_cents")

  cost         LogisticsCost @relation(fields: [logisticsCostId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  @@unique([logisticsCostId, serviceOrderId])
  @@index([serviceOrderId])
  @@map("logistics_cost_allocations")
}

/// Modelo de despesa recorrente mensal (aluguel, energia...).
model RecurringExpense {
  id          String    @id @default(uuid()) @db.Uuid
  category    String    @db.VarChar(30)
  description String    @db.VarChar(200)
  amountCents Int       @map("amount_cents")
  dayOfMonth  Int       @map("day_of_month")
  beneficiary String?   @db.VarChar(160)
  startMonth  DateTime  @map("start_month") @db.Date
  endMonth    DateTime? @map("end_month") @db.Date
  active      Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  expenses OperationalExpense[]

  @@map("recurring_expenses")
}

/// Despesa operacional (DP-00001) por competência; gera a conta a pagar correspondente.
model OperationalExpense {
  id           String    @id @default(uuid()) @db.Uuid
  number       Int       @unique @default(autoincrement())
  category     String    @db.VarChar(30)
  description  String    @db.VarChar(200)
  amountCents  Int       @map("amount_cents")
  /// Mês de competência (primeiro dia).
  competence   DateTime  @db.Date
  recurringId  String?   @map("recurring_id") @db.Uuid
  payableId    String?   @unique @map("payable_id") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason") @db.VarChar(500)
  version      Int       @default(1)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  recurring RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: Restrict)
  payable   AccountPayable?   @relation(fields: [payableId], references: [id], onDelete: Restrict)

  @@unique([recurringId, competence])
  @@index([competence])
  @@map("operational_expenses")
}

/// Conta a pagar (CPG-00001): obrigação com fornecedor ou beneficiário. Registro apenas.
model AccountPayable {
  id           String    @id @default(uuid()) @db.Uuid
  number       Int       @unique @default(autoincrement())
  beneficiary  String    @db.VarChar(160)
  supplierId   String?   @map("supplier_id") @db.Uuid
  category     String    @db.VarChar(30)
  description  String    @db.VarChar(200)
  amountCents  Int       @map("amount_cents")
  paidCents    Int       @default(0) @map("paid_cents")
  dueDate      DateTime  @map("due_date") @db.Date
  /// ABERTO, PARCIAL, PAGO, CANCELADO.
  status       String    @default("ABERTO") @db.VarChar(20)
  notes        String?   @db.VarChar(1000)
  cancelReason String?   @map("cancel_reason") @db.VarChar(500)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  version      Int       @default(1)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  payments      PayablePayment[]
  expense       OperationalExpense?
  logisticsCost LogisticsCost?

  @@index([status, dueDate])
  @@map("account_payables")
}

model PayablePayment {
  id          String   @id @default(uuid()) @db.Uuid
  payableId   String   @map("payable_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  paidAt      DateTime @map("paid_at") @db.Date
  method      String   @db.VarChar(20)
  note        String?  @db.VarChar(500)
  /// Comprovante opcional (anexo privado FINANCIAL_PAYMENT).
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payable AccountPayable @relation(fields: [payableId], references: [id], onDelete: Restrict)

  @@index([payableId])
  @@index([paidAt])
  @@map("payable_payments")
}

/// Histórico imutável dos registros financeiros (quem, quando, o quê).
model FinancialEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  kind       String   @db.VarChar(40)
  note       String?  @db.VarChar(1000)
  data       Json?
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@map("financial_events")
}

/// Evolução Fase 3: definição e substituição do titular da peça (imutável).
model ServiceOrderItemOwnerChange {
  id                      String   @id @default(uuid()) @db.Uuid
  serviceOrderItemId      String   @map("service_order_item_id") @db.Uuid
  /// DEFINICAO (primeiro titular) ou SUBSTITUICAO (troca autorizada).
  kind                    String   @db.VarChar(20)
  fromUserId              String?  @map("from_user_id") @db.Uuid
  toUserId                String   @map("to_user_id") @db.Uuid
  reason                  String?  @db.VarChar(500)
  /// Tarefas pendentes que passaram ao novo titular (concluídas nunca mudam).
  movedTaskIds            String[] @map("moved_task_ids") @db.Uuid
  /// Há mão de obra combinada com outra pessoa: revisão financeira manual (Fase 5).
  financialReviewRequired Boolean  @default(false) @map("financial_review_required")
  createdById             String?  @map("created_by_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item      ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  fromUser  User?            @relation("OwnerChangeFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser    User             @relation("OwnerChangeTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("OwnerChangeBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([serviceOrderItemId, createdAt])
  @@map("service_order_item_owner_changes")
}
