/// Reformulação, Fase 0: funcionalidade operacional ligada/desligada (chave do catálogo
/// `MODULES` em @cenario/shared). Só existem as linhas alteradas: sem linha = valor padrão, que
/// preserva o comportamento anterior. Nada é apagado ao desligar — o histórico continua legível.
model ModuleSetting {
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeModuleSetting", fields: [companyId], references: [id])
  key         String          @db.VarChar(40)
  enabled     Boolean
  version     Int             @default(1)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?         @map("updated_by_id") @db.Uuid
  updatedBy   User?           @relation("ModuleSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([companyId, key])
  @@map("module_settings")
}

// ─────────────────────────── Auditoria e eventos ───────────────────────────

/// Registro imutável de ações críticas (UPDATE/DELETE bloqueados por trigger).
model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeAuditLog", fields: [companyId], references: [id])
  actorUserId String?         @map("actor_user_id") @db.Uuid
  sessionId   String?         @map("session_id") @db.Uuid
  action      String          @db.VarChar(80)
  entityType  String          @map("entity_type") @db.VarChar(60)
  entityId    String?         @map("entity_id") @db.VarChar(64)
  summary     String          @db.VarChar(300)
  /// Diferenças antes/depois, sem dados sensíveis.
  changes     Json?
  ipAddress   String?         @map("ip_address") @db.VarChar(64)
  requestId   String?         @map("request_id") @db.VarChar(64)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Eventos de domínio persistentes (outbox). `seq` define a ordem global.
model DomainEvent {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company       CompanySettings @relation("EmpresaDeDomainEvent", fields: [companyId], references: [id])
  seq           BigInt          @unique @default(autoincrement())
  type          String          @db.VarChar(80)
  aggregateType String          @map("aggregate_type") @db.VarChar(60)
  aggregateId   String          @map("aggregate_id") @db.VarChar(64)
  payload       Json
  /// Quem pode receber em tempo real: 'all', 'permission:<p>' ou 'user:<id>'.
  audience      String          @default("all") @db.VarChar(400)
  actorUserId   String?         @map("actor_user_id") @db.Uuid
  requestId     String?         @map("request_id") @db.VarChar(64)
  occurredAt    DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@map("domain_events")
}

/// Posição de cada consumidor de eventos (automações). Processamento ordenado,
/// pelo menos uma vez, com repetição após falha.
model EventConsumer {
  name           String    @id @db.VarChar(80)
  lastSeq        BigInt    @default(0) @map("last_seq")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lastError      String?   @map("last_error") @db.VarChar(1000)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_consumers")
}

/// Chaves de idempotência para operações sensíveis.
model IdempotencyKey {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company        CompanySettings @relation("EmpresaDeIdempotencyKey", fields: [companyId], references: [id])
  userId         String          @map("user_id") @db.Uuid
  key            String          @db.VarChar(100)
  scope          String          @db.VarChar(160)
  requestHash    String          @map("request_hash") @db.Char(64)
  /// null enquanto a operação está em andamento.
  responseStatus Int?            @map("response_status")
  responseBody   Json?           @map("response_body")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime        @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────── Arquivos ───────────────────────────────

enum FileVisibility {
  PRIVATE

  @@map("file_visibility")
}

/// Metadados de arquivos privados (fotos e documentos). O conteúdo fica no
/// armazenamento privado e só é servido por rota autenticada.
model StoredFile {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company           CompanySettings @relation("EmpresaDeStoredFile", fields: [companyId], references: [id])
  storageKey        String          @unique @map("storage_key") @db.VarChar(200)
  purpose           String          @db.VarChar(40)
  originalName      String          @map("original_name") @db.VarChar(200)
  mimeType          String          @map("mime_type") @db.VarChar(100)
  sizeBytes         Int             @map("size_bytes")
  sha256            String          @db.Char(64)
  visibility        FileVisibility  @default(PRIVATE)
  uploadedById      String?         @map("uploaded_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  /// Reformulação, Fase 2: foto tratada (orientada, sem metadados, reduzida). NULL = anterior.
  processedAt       DateTime?       @map("processed_at") @db.Timestamptz(3)
  width             Int?
  height            Int?
  thumbKey          String?         @unique @map("thumb_key") @db.VarChar(200)
  thumbSizeBytes    Int?            @map("thumb_size_bytes")
  originalSizeBytes Int?            @map("original_size_bytes")

  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  employeePhoto Employee?   @relation("EmployeePhoto")
  attachment    Attachment?

  @@map("stored_files")
}

// ═══════════════════════════ FASE 2 — Comercial e oficina ═══════════════════════════

enum CustomerKind {
  PF
  PJ

  @@map("customer_kind")
}

/// Cliente (pessoa física ou jurídica). Dados pessoais restritos por permissão.
model Customer {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeCustomer", fields: [companyId], references: [id])
  kind        CustomerKind
  name        String          @db.VarChar(160)
  tradeName   String?         @map("trade_name") @db.VarChar(160)
  /// CPF/CNPJ somente dígitos. Único quando informado (duplicidade evidente).
  document    String?         @db.VarChar(14)
  phone       String?         @db.VarChar(13)
  whatsapp    String?         @db.VarChar(13)
  email       String?         @db.VarChar(254)
  notes       String?         @db.VarChar(2000)
  /// Texto normalizado (sem acentos, minúsculo) para pesquisa.
  searchText  String          @map("search_text") @db.VarChar(800)
  active      Boolean         @default(true)
  version     Int             @default(1)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  addresses     CustomerAddress[]
  orders        CommercialOrder[]
  serviceOrders ServiceOrder[]

  deliveries Delivery[]

  // Fase 11: financeiro operacional.
  receivables        CustomerReceivable[]
  inboxConversations InboxConversation[]

  @@index([phone])
  @@index([whatsapp])
  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company    CompanySettings @relation("EmpresaDeCustomerAddress", fields: [companyId], references: [id])
  customerId String          @map("customer_id") @db.Uuid
  label      String          @db.VarChar(40)
  street     String          @db.VarChar(160)
  number     String          @db.VarChar(20)
  complement String?         @db.VarChar(80)
  district   String?         @db.VarChar(80)
  city       String          @db.VarChar(80)
  state      String          @db.Char(2)
  postalCode String?         @map("postal_code") @db.Char(8)
  reference  String?         @db.VarChar(200)
  isPrimary  Boolean         @default(false) @map("is_primary")
  /// Endereços não são apagados (pedidos guardam cópia), apenas arquivados.
  archivedAt DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   CommercialOrder[]
  pickups  PickupRequest[]

  deliveries Delivery[]

  @@index([customerId])
  @@map("customer_addresses")
}

enum CommercialOrderStatus {
  AGUARDANDO_RETIRADA
  RETIRADA_AGENDADA
  RECEBIDO_PARCIAL
  RECEBIDO
  CANCELADO

  @@map("commercial_order_status")
}

enum PieceType {
  SOFA
  POLTRONA
  CADEIRA
  CABECEIRA
  CANTO_ALEMAO
  PUFE
  BANCO
  COLCHAO
  OUTRO

  @@map("piece_type")
}

/// Pedido comercial: criado após a aprovação do cliente; organiza a retirada e preserva a venda.
model CommercialOrder {
  id                    String                @id @default(uuid()) @db.Uuid
  companyId             Int                   @default(dbgenerated("app_company_id()")) @map("company_id")
  company               CompanySettings       @relation("EmpresaDeCommercialOrder", fields: [companyId], references: [id])
  number                Int                   @default(dbgenerated())
  customerId            String                @map("customer_id") @db.Uuid
  pickupAddressId       String?               @map("pickup_address_id") @db.Uuid
  /// Cópia do endereço no momento do pedido (preserva o combinado).
  pickupAddressSnapshot Json?                 @map("pickup_address_snapshot")
  contractedService     String                @map("contracted_service") @db.VarChar(300)
  description           String?               @db.VarChar(2000)
  agreedValueCents      Int?                  @map("agreed_value_cents")
  paymentTerms          String?               @map("payment_terms") @db.VarChar(1000)
  notes                 String?               @db.VarChar(2000)
  status                CommercialOrderStatus @default(AGUARDANDO_RETIRADA)
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?               @map("cancelled_by_id") @db.Uuid
  cancelReason          String?               @map("cancel_reason") @db.VarChar(500)
  version               Int                   @default(1)
  createdById           String?               @map("created_by_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickupAddress CustomerAddress?      @relation(fields: [pickupAddressId], references: [id], onDelete: Restrict)
  createdBy     User?                 @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?                 @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items         CommercialOrderItem[]
  pickups       PickupRequest[]
  receipts      Receipt[]
  serviceOrders ServiceOrder[]

  pieceReturns PieceReturn[]

  /// 2026-11-18: este pedido é o de um retrabalho (serviço a refazer de outro pedido).
  rework        Rework?  @relation("ReworkOrder")
  /// Retrabalhos abertos a partir deste pedido (o serviço original).
  reworksOfThis Rework[] @relation("ReworkOriginal")

  // Fase 11: financeiro operacional.
  adjustments CommercialAdjustment[]
  receivables CustomerReceivable[]

  // Simplificação Fase 2 — "Novo serviço": o pedido é o registro do serviço fechado antes da
  // chegada. Com `autoServiceOrder`, cada recebimento confirmado gera a OS das peças recebidas.
  /// Pedido criado pelo fluxo Novo serviço: a OS nasce automaticamente na chegada das peças.
  autoServiceOrder     Boolean          @default(false) @map("auto_service_order")
  /// Estabilização da Fase 2: o cliente entrega as peças na tapeçaria (Novo serviço sem retirada).
  customerDropOff      Boolean          @default(false) @map("customer_drop_off")
  /// Prazo de entrega combinado com o cliente (copiado para a OS gerada).
  promisedDate         DateTime?        @map("promised_date") @db.Date
  /// 2026-11-18: prazo combinado em dias úteis a partir da retirada (null = data informada à mão).
  deliveryBusinessDays Int?             @map("delivery_business_days")
  /// Observações técnicas conhecidas no fechamento (copiadas para a OS gerada).
  technicalNotes       String?          @map("technical_notes") @db.VarChar(4000)
  contracts            Contract[]
  fiscalDocs           FiscalDocument[]

  @@unique([companyId, number])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("commercial_orders")
}

model CommercialOrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company          CompanySettings @relation("EmpresaDeCommercialOrderItem", fields: [companyId], references: [id])
  orderId          String          @map("order_id") @db.Uuid
  position         Int
  pieceType        PieceType       @map("piece_type")
  description      String          @db.VarChar(300)
  quantity         Int
  /// Mantido pelo registro de recebimentos (nunca maior que a quantidade).
  receivedQuantity Int             @default(0) @map("received_quantity")
  notes            String?         @db.VarChar(500)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order             CommercialOrder       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pickupItems       PickupRequestItem[]
  receiptLines      ReceiptLine[]
  serviceOrderItems ServiceOrderItem[]
  materialForecasts MaterialRequirement[]
  leftovers         MaterialLeftover[]

  /// Fase 10: peças devolvidas ao cliente (confirmadas).
  returnedQuantity Int               @default(0) @map("returned_quantity")
  returnLines      PieceReturnLine[]

  // Simplificação Fase 2: especificações conhecidas no fechamento (opcionais), usadas na OS
  // gerada automaticamente na chegada. Nada técnico é exigido antes da peça chegar.
  serviceType     ServiceType? @map("service_type")
  fabricName      String?      @map("fabric_name") @db.VarChar(120)
  fabricColor     String?      @map("fabric_color") @db.VarChar(80)
  fabricReference String?      @map("fabric_reference") @db.VarChar(80)
  technicalNotes  String?      @map("technical_notes") @db.VarChar(2000)

  // Estabilização da Fase 2 (Fase 1 §4.3 B): titular e mão de obra PREVISTOS no fechamento.
  // Intenção, não obrigação: a mão de obra combinada nasce com a OS, na chegada
  // (valor por unidade × quantidade que chegou). CHECK no banco: mão de obra exige titular.
  plannedUpholstererUserId String? @map("planned_upholsterer_user_id") @db.Uuid
  plannedLaborUnitCents    Int?    @map("planned_labor_unit_cents")
  plannedUpholsterer       User?   @relation("PlannedUpholsterer", fields: [plannedUpholstererUserId], references: [id], onDelete: Restrict)

  /// Cobrança: valor fechado da peça (opcional). Usado, a soma das peças é igual ao valor final
  /// do pedido (validado no domínio) e a receita da OS é a soma das peças que estão nela.
  agreedValueCents Int? @map("agreed_value_cents")

  @@unique([orderId, position])
  @@index([plannedUpholstererUserId])
  @@map("commercial_order_items")
}

enum PickupStatus {
  AGUARDANDO_AGENDAMENTO
  AGENDADA
  EM_EXECUCAO
  RETIRADA_REALIZADA
  RECEBIDA_NA_OFICINA
  CANCELADA
  COM_OCORRENCIA

  @@map("pickup_status")
}

enum PickupTeam {
  LOGISTICA_TERCEIRIZADA
  EQUIPE_PROPRIA

  @@map("pickup_team")
}

/// Solicitação de retirada (preparada para integração futura com a logística terceirizada).
model PickupRequest {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company             CompanySettings @relation("EmpresaDePickupRequest", fields: [companyId], references: [id])
  number              Int             @default(dbgenerated())
  orderId             String          @map("order_id") @db.Uuid
  addressId           String?         @map("address_id") @db.Uuid
  addressSnapshot     Json?           @map("address_snapshot")
  scheduledDate       DateTime?       @map("scheduled_date") @db.Date
  windowStart         String?         @map("window_start") @db.Char(5)
  windowEnd           String?         @map("window_end") @db.Char(5)
  /// Melhoria 130: dia e turno escolhidos pelo próprio cliente no link.
  customerScheduledAt DateTime?       @map("customer_scheduled_at") @db.Timestamptz(3)
  /// Correção global: posição no roteiro do dia (null = ainda não ordenada; vai ao fim).
  routeSequence       Int?            @map("route_sequence")
  team                PickupTeam      @default(LOGISTICA_TERCEIRIZADA)
  teamNotes           String?         @map("team_notes") @db.VarChar(200)
  instructions        String?         @db.VarChar(1000)
  /// Protocolo/identificador no sistema da logística (integração futura).
  externalReference   String?         @map("external_reference") @db.VarChar(80)
  status              PickupStatus    @default(AGUARDANDO_AGENDAMENTO)
  /// Agenda de Retiradas: levar mostruário ao cliente (e qual) e levar a maquininha de cartão.
  bringSamples        Boolean         @default(false) @map("bring_samples")
  samplesDescription  String?         @map("samples_description") @db.VarChar(200)
  bringCardMachine    Boolean         @default(false) @map("bring_card_machine")
  version             Int             @default(1)
  createdById         String?         @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order            CommercialOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  address          CustomerAddress?           @relation(fields: [addressId], references: [id], onDelete: Restrict)
  createdBy        User?                      @relation("PickupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items            PickupRequestItem[]
  events           PickupEvent[]
  receipts         Receipt[]
  /// Simplificação Fase 3: participantes OPERACIONAIS (veem a parada; não são credores).
  tripParticipants LogisticsTripParticipant[]

  /// Fase 10: responsável logístico (equipe terceirizada ou própria).
  logisticsUserId String?               @map("logistics_user_id") @db.Uuid
  logisticsUser   User?                 @relation("PickupLogisticsUser", fields: [logisticsUserId], references: [id], onDelete: SetNull)
  occurrences     LogisticsOccurrence[]

  // Fase 11: financeiro operacional.
  logisticsCosts LogisticsCost[]
  paymentReports CustomerPaymentReport[]

  @@unique([companyId, number])
  @@index([orderId])
  @@index([status])
  @@index([scheduledDate])
  @@map("pickup_requests")
}

model PickupRequestItem {
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDePickupRequestItem", fields: [companyId], references: [id])
  pickupId    String          @map("pickup_id") @db.Uuid
  orderItemId String          @map("order_item_id") @db.Uuid
  quantity    Int

  pickup    PickupRequest       @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  orderItem CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@id([pickupId, orderItemId])
  @@index([orderItemId])
  @@map("pickup_request_items")
}

enum EventSource {
  MANUAL
  SISTEMA
  INTEGRACAO

  @@map("event_source")
}

/// Linha do tempo da retirada (confirmações manuais agora; integração no futuro).
model PickupEvent {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDePickupEvent", fields: [companyId], references: [id])
  pickupId     String          @map("pickup_id") @db.Uuid
  kind         String          @db.VarChar(40)
  fromStatus   PickupStatus?   @map("from_status")
  toStatus     PickupStatus?   @map("to_status")
  note         String?         @db.VarChar(1000)
  source       EventSource     @default(MANUAL)
  recordedById String?         @map("recorded_by_id") @db.Uuid
  occurredAt   DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)

  pickup     PickupRequest @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  recordedBy User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([pickupId, occurredAt])
  @@map("pickup_events")
}

enum ReceiptOrigin {
  RETIRADA
  ENTREGUE_PELO_CLIENTE

  @@map("receipt_origin")
}

enum PieceCondition {
  BOA
  REGULAR
  DANIFICADA

  @@map("piece_condition")
}

/// Recebimento físico das peças na oficina (pode ser parcial).
model Receipt {
  id                   String          @id @default(uuid()) @db.Uuid
  companyId            Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company              CompanySettings @relation("EmpresaDeReceipt", fields: [companyId], references: [id])
  number               Int             @default(dbgenerated())
  orderId              String          @map("order_id") @db.Uuid
  pickupId             String?         @map("pickup_id") @db.Uuid
  origin               ReceiptOrigin
  receivedAt           DateTime        @map("received_at") @db.Timestamptz(3)
  receivedByEmployeeId String?         @map("received_by_employee_id") @db.Uuid
  registeredById       String?         @map("registered_by_id") @db.Uuid
  divergences          String?         @db.VarChar(2000)
  notes                String?         @db.VarChar(2000)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order        CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pickup       PickupRequest?  @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  receivedBy   Employee?       @relation("ReceiptReceivedBy", fields: [receivedByEmployeeId], references: [id], onDelete: SetNull)
  registeredBy User?           @relation("ReceiptRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  lines        ReceiptLine[]
  /// Simplificação Fase 2: OS gerada automaticamente por este recebimento (no máximo uma).
  serviceOrder ServiceOrder?
  /// Simplificação Fase 3: dispositivo (tablet) usado na confirmação da chegada.
  deviceId     String?         @map("device_id") @db.Uuid
  device       Device?         @relation("ReceiptDevice", fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([orderId])
  @@index([receivedAt(sort: Desc)])
  @@index([pickupId])
  @@map("receipts")
}

model ReceiptLine {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company        CompanySettings @relation("EmpresaDeReceiptLine", fields: [companyId], references: [id])
  receiptId      String          @map("receipt_id") @db.Uuid
  orderItemId    String          @map("order_item_id") @db.Uuid
  quantity       Int
  condition      PieceCondition
  conditionNotes String?         @map("condition_notes") @db.VarChar(500)
  location       String          @db.VarChar(80)

  receipt   Receipt             @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  orderItem CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  corrections ReceiptCorrection[]

  @@unique([receiptId, orderItemId])
  @@index([orderItemId])
  @@map("receipt_lines")
}

enum ServiceOrderStatus {
  ABERTA
  CANCELADA

  @@map("service_order_status")
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  URGENTE

  @@map("priority")
}

enum ServiceType {
  REFORMA_COMPLETA
  TROCA_DE_TECIDO
  TROCA_DE_ESPUMA
  REPARO
  FABRICACAO
  INSTALACAO
  OUTRO

  @@map("service_type")
}

enum MeasurementKind {
  ROTINA
  EXTRAORDINARIA

  @@map("measurement_kind")
}

/// Ordem de serviço técnica: só existe para peças efetivamente recebidas.
model ServiceOrder {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             Int                @default(dbgenerated("app_company_id()")) @map("company_id")
  company               CompanySettings    @relation("EmpresaDeServiceOrder", fields: [companyId], references: [id])
  number                Int                @default(dbgenerated())
  orderId               String             @map("order_id") @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  status                ServiceOrderStatus @default(ABERTA)
  technicalInstructions String?            @map("technical_instructions") @db.VarChar(4000)
  notes                 String?            @db.VarChar(2000)
  promisedDate          DateTime?          @map("promised_date") @db.Date
  priority              Priority           @default(NORMAL)
  technicalLeadId       String?            @map("technical_lead_id") @db.Uuid
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?            @map("cancelled_by_id") @db.Uuid
  cancelReason          String?            @map("cancel_reason") @db.VarChar(500)
  /// Fluxo da OS (2026-11-18): "Material comprado" libera a OS para a programação da semana.
  materialPurchasedAt   DateTime?          @map("material_purchased_at") @db.Timestamptz(3)
  materialPurchasedById String?            @map("material_purchased_by_id") @db.Uuid
  version               Int                @default(1)
  createdById           String?            @map("created_by_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  order               CommercialOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer            Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technicalLead       Employee?              @relation("ServiceOrderTechnicalLead", fields: [technicalLeadId], references: [id], onDelete: SetNull)
  createdBy           User?                  @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy         User?                  @relation("ServiceOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  materialPurchasedBy User?                  @relation("ServiceOrderMaterialPurchasedBy", fields: [materialPurchasedById], references: [id], onDelete: SetNull)
  items               ServiceOrderItem[]
  revisions           ServiceOrderRevision[]
  materials           MaterialRequirement[]
  measurements        Measurement[]

  // Fase 4: prontidão de materiais (calculada a partir dos registros; não libera produção).
  materialsReadiness   MaterialReadiness @default(SEM_LEVANTAMENTO) @map("materials_readiness")
  materialsReadinessAt DateTime?         @map("materials_readiness_at") @db.Timestamptz(3)

  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  purchaseItems       PurchaseOrderItem[]
  purchaseAllocations PurchaseAllocation[]
  leftovers           MaterialLeftover[]
  leftoversOut        MaterialLeftoverTransfer[] @relation("LeftoverTransferFrom")
  leftoversIn         MaterialLeftoverTransfer[] @relation("LeftoverTransferTo")

  productionPlanItems ProductionPlanItem[]
  productionTasks     ProductionTask[]
  notifications       Notification[]
  helpRequests        HelpRequest[]
  issues              ProductionIssue[]

  inspections QualityInspection[]

  // Fase 11: financeiro operacional.
  /// Receita atribuída à OS pelo gestor (vazio = proporcional às peças do pedido).
  revenueCents         Int?                      @map("revenue_cents")
  receivables          CustomerReceivable[]
  costs                ServiceOrderCost[]
  productionPayables   ProductionPayable[]
  logisticsAllocations LogisticsCostAllocation[]
  laborReviews         LaborReview[]
  /// Reformulação, Fase 1: lista simples de materiais necessários (comprado/na oficina).
  simpleMaterials      ServiceOrderMaterial[]

  /// Simplificação Fase 2: recebimento que gerou esta OS automaticamente (único). Vazio = OS
  /// criada manualmente (fluxo anterior, preservado).
  sourceReceiptId    String?             @unique @map("source_receipt_id") @db.Uuid
  sourceReceipt      Receipt?            @relation(fields: [sourceReceiptId], references: [id], onDelete: Restrict)
  contracts          Contract[]
  fiscalDocs         FiscalDocument[]
  inboxConversations InboxConversation[]
  /// Quadro de Metas: lançamentos manuais vinculados à OS.
  cashEntries        CashEntry[]

  @@unique([companyId, number])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("service_orders")
}

/// Peça (ou conjunto de peças idênticas) da OS, com identificação individual (código OS-xxxxx/n).
model ServiceOrderItem {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        Int              @default(dbgenerated("app_company_id()")) @map("company_id")
  company          CompanySettings  @relation("EmpresaDeServiceOrderItem", fields: [companyId], references: [id])
  serviceOrderId   String           @map("service_order_id") @db.Uuid
  orderItemId      String           @map("order_item_id") @db.Uuid
  position         Int
  pieceType        PieceType        @map("piece_type")
  description      String           @db.VarChar(300)
  quantity         Int
  serviceType      ServiceType      @map("service_type")
  fabricName       String?          @map("fabric_name") @db.VarChar(120)
  fabricColor      String?          @map("fabric_color") @db.VarChar(80)
  fabricReference  String?          @map("fabric_reference") @db.VarChar(80)
  foamSpecs        String?          @map("foam_specs") @db.VarChar(500)
  technicalNotes   String?          @map("technical_notes") @db.VarChar(2000)
  /// Lista de medidas [{ label, valueCm }].
  measurements     Json             @default("[]")
  measurementNotes String?          @map("measurement_notes") @db.VarChar(1000)
  measuredAt       DateTime?        @map("measured_at") @db.Timestamptz(3)
  measuredById     String?          @map("measured_by_id") @db.Uuid
  measurementKind  MeasurementKind? @map("measurement_kind")
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrder      ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  orderItem         CommercialOrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  measuredBy        User?                 @relation("ItemMeasuredBy", fields: [measuredById], references: [id], onDelete: SetNull)
  materials         MaterialRequirement[]
  measurementTasks  Measurement[]
  measurementPieces MeasurementPiece[]
  requestItems      MaterialRequestItem[]

  productionTasks ProductionTask[]

  /// Fase 10: etapa da peça no fluxo produção → qualidade → embalagem → entrega (derivada).
  fulfillmentStage     String                @default("EM_PRODUCAO") @map("fulfillment_stage") @db.VarChar(30)
  currentLocationId    String?               @map("current_location_id") @db.Uuid
  currentLocation      ItemLocation?         @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  inspections          QualityInspection[]
  qualityEvents        QualityEvent[]
  packaging            PackagingRecord[]
  locationEvents       ItemLocationEvent[]
  deliveryItems        DeliveryItem[]
  logisticsOccurrences LogisticsOccurrence[]

  // Fase 11: financeiro operacional.
  productionPayables ProductionPayable[]

  /// Evolução Fase 3: tapeceiro titular da peça (fonte de verdade operacional; um por peça).
  /// Não é direito financeiro: mão de obra combinada fica em production_payables.
  upholstererUserId String?                       @map("upholsterer_user_id") @db.Uuid
  upholsterer       User?                         @relation("ItemUpholsterer", fields: [upholstererUserId], references: [id], onDelete: Restrict)
  ownerChanges      ServiceOrderItemOwnerChange[]
  laborReviews      LaborReview[]

  @@unique([serviceOrderId, position])
  @@index([orderItemId])
  @@map("service_order_items")
}

/// Histórico técnico da OS (imutável): cada alteração gera uma revisão numerada.
model ServiceOrderRevision {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company        CompanySettings @relation("EmpresaDeServiceOrderRevision", fields: [companyId], references: [id])
  serviceOrderId String          @map("service_order_id") @db.Uuid
  revision       Int
  scope          String          @db.VarChar(20)
  itemId         String?         @map("item_id") @db.Uuid
  changes        Json
  reason         String?         @db.VarChar(300)
  changedById    String?         @map("changed_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([serviceOrderId, revision])
  @@map("service_order_revisions")
}

enum MaterialKind {
  TECIDO
  ESPUMA
  OUTRO

  @@map("material_kind")
}

enum MaterialSourcing {
  EXCLUSIVO_OS
  ESTOQUE

  @@map("material_sourcing")
}

/// Necessidade de material da OS (estrutura preparatória para compras/estoque — Fase 3).
/// Tecido é sempre de compra exclusiva da OS. Não dispara produção.
model MaterialRequirement {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          Int              @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings  @relation("EmpresaDeMaterialRequirement", fields: [companyId], references: [id])
  serviceOrderId     String?          @map("service_order_id") @db.Uuid
  serviceOrderItemId String?          @map("service_order_item_id") @db.Uuid
  kind               MaterialKind
  description        String           @db.VarChar(200)
  quantity           Decimal?         @db.Decimal(12, 3)
  unit               String?          @db.VarChar(20)
  sourcing           MaterialSourcing
  notes              String?          @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  // Fase 3: necessidades aprovadas a partir de solicitações de material.
  /// PREVISAO_MANUAL (Fase 2, não conferida) ou SOLICITACAO_APROVADA (conferida pelo gestor).
  origin                MaterialRequirementOrigin @default(PREVISAO_MANUAL)
  materialRequestItemId String?                   @unique @map("material_request_item_id") @db.Uuid
  unitCode              MaterialUnit?             @map("unit_code")
  color                 String?                   @db.VarChar(60)
  reference             String?                   @db.VarChar(80)
  foamDensity           String?                   @map("foam_density") @db.VarChar(30)
  thicknessCm           Decimal?                  @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm              Decimal?                  @map("length_cm") @db.Decimal(8, 2)
  widthCm               Decimal?                  @map("width_cm") @db.Decimal(8, 2)
  approvedAt            DateTime?                 @map("approved_at") @db.Timestamptz(3)
  // Etapa 2 (compras sem duplicidade): substituição/cancelamento sem apagar histórico.
  status                MaterialRequirementStatus @default(ATIVA)
  /// Necessidade anterior que esta substitui (no máximo uma sucessora por necessidade).
  replacesRequirementId String?                   @unique @map("replaces_requirement_id") @db.Uuid
  closedAt              DateTime?                 @map("closed_at") @db.Timestamptz(3)
  closedById            String?                   @map("closed_by_id") @db.Uuid
  closeReason           String?                   @map("close_reason") @db.VarChar(500)
  /// Etapa 3: peça do pedido (identidade antes da OS) da previsão de compra.
  orderItemId           String?                   @map("order_item_id") @db.Uuid

  serviceOrder        ServiceOrder?              @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  orderItem           CommercialOrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  leftoversFrom       MaterialLeftover[]         @relation("LeftoverSourceRequirement")
  replaces            MaterialRequirement?       @relation("RequirementSubstitution", fields: [replacesRequirementId], references: [id], onDelete: Restrict)
  replacedBy          MaterialRequirement?       @relation("RequirementSubstitution")
  closedBy            User?                      @relation("RequirementClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  serviceOrderItem    ServiceOrderItem?          @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  materialRequestItem MaterialRequestItem?       @relation(fields: [materialRequestItemId], references: [id], onDelete: Restrict)
  allocations         PurchaseAllocation[]
  reservations        StockReservation[]
  transfersIn         MaterialLeftoverTransfer[]
  productionTasks     ProductionTaskMaterial[]
  issues              ProductionIssue[]

  @@index([serviceOrderId])
  @@index([serviceOrderItemId])
  @@index([serviceOrderId, status])
  @@index([orderItemId, status])
  @@map("material_requirements")
}

enum AttachmentEntity {
  COMMERCIAL_ORDER
  PICKUP
  RECEIPT
  SERVICE_ORDER
  SERVICE_ORDER_ITEM
  PRODUCTION_TASK
  PRODUCTION_ISSUE
  QUALITY_INSPECTION
  PACKAGING
  DELIVERY
  LOGISTICS_OCCURRENCE
  FINANCE_PAYABLE

  @@map("attachment_entity")
}

/// Vínculo entre arquivo privado (stored_files) e um registro do fluxo.
model Attachment {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   Int              @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings  @relation("EmpresaDeAttachment", fields: [companyId], references: [id])
  fileId      String           @unique @map("file_id") @db.Uuid
  entityType  AttachmentEntity @map("entity_type")
  entityId    String           @map("entity_id") @db.Uuid
  caption     String?          @db.VarChar(200)
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(3)

  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("attachments")
}

// ═══════════════════════ FASE 3 — Medições e solicitações de materiais ═══════════════════════

enum MaterialRequirementStatus {
  ATIVA
  SUBSTITUIDA
  CANCELADA

  @@map("material_requirement_status")
}

enum MaterialRequirementOrigin {
  PREVISAO_MANUAL
  SOLICITACAO_APROVADA
  PREVISAO_COMPRA

  @@map("material_requirement_origin")
}

enum MeasurementStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA

  @@map("measurement_status")
}

enum MaterialRequestStatus {
  RASCUNHO
  ENVIADA
  EM_REVISAO
  APROVADA
  DEVOLVIDA
  CANCELADA

  @@map("material_request_status")
}

enum MaterialUnit {
  METRO
  METRO_QUADRADO
  PLACA
  PECA
  UNIDADE
  EMBALAGEM

  @@map("material_unit")
}

/// Tarefa de medição (rotina de sexta ou extraordinária) de uma OS ou peça.
/// Não inicia produção: apenas registra medidas e necessidades de material.
model Measurement {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          Int               @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings   @relation("EmpresaDeMeasurement", fields: [companyId], references: [id])
  number             Int               @default(dbgenerated())
  serviceOrderId     String            @map("service_order_id") @db.Uuid
  /// Peça específica; nulo = OS inteira.
  serviceOrderItemId String?           @map("service_order_item_id") @db.Uuid
  kind               MeasurementKind
  status             MeasurementStatus @default(PENDENTE)
  assigneeUserId     String            @map("assignee_user_id") @db.Uuid
  requestedById      String?           @map("requested_by_id") @db.Uuid
  requestedAt        DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  dueDate            DateTime          @map("due_date") @db.Date
  reason             String?           @db.VarChar(500)
  notes              String?           @db.VarChar(2000)
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?           @map("cancel_reason") @db.VarChar(500)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrder     ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  serviceOrderItem ServiceOrderItem?     @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  assignee         User                  @relation("MeasurementAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  requestedBy      User?                 @relation("MeasurementRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  pieces           MeasurementPiece[]
  request          MaterialRequest?
  revisions        MeasurementRevision[]

  @@unique([companyId, number])
  @@index([assigneeUserId, status])
  @@index([serviceOrderId])
  @@index([status, dueDate])
  @@map("measurements")
}

/// Medidas de cada peça registradas na medição.
model MeasurementPiece {
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeMeasurementPiece", fields: [companyId], references: [id])
  measurementId      String          @map("measurement_id") @db.Uuid
  serviceOrderItemId String          @map("service_order_item_id") @db.Uuid
  /// [{ label, valueCm }]
  dimensions         Json            @default("[]")
  notes              String?         @db.VarChar(1000)

  measurement      Measurement      @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)

  @@id([measurementId, serviceOrderItemId])
  @@map("measurement_pieces")
}

/// Solicitação de materiais gerada pela medição (uma por medição).
/// "Aprovada" = quantidades conferidas pelo gestor; NÃO é compra nem recebimento.
model MaterialRequest {
  id            String                @id @default(uuid()) @db.Uuid
  companyId     Int                   @default(dbgenerated("app_company_id()")) @map("company_id")
  company       CompanySettings       @relation("EmpresaDeMaterialRequest", fields: [companyId], references: [id])
  measurementId String                @unique @map("measurement_id") @db.Uuid
  status        MaterialRequestStatus @default(RASCUNHO)
  submittedAt   DateTime?             @map("submitted_at") @db.Timestamptz(3)
  reviewedById  String?               @map("reviewed_by_id") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(3)
  returnReason  String?               @map("return_reason") @db.VarChar(500)
  version       Int                   @default(1)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  measurement Measurement           @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  reviewedBy  User?                 @relation("MaterialRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items       MaterialRequestItem[]

  @@index([status])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          Int              @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings  @relation("EmpresaDeMaterialRequestItem", fields: [companyId], references: [id])
  requestId          String           @map("request_id") @db.Uuid
  position           Int
  serviceOrderItemId String?          @map("service_order_item_id") @db.Uuid
  kind               MaterialKind
  sourcing           MaterialSourcing
  description        String           @db.VarChar(160)
  color              String?          @db.VarChar(60)
  reference          String?          @db.VarChar(80)
  foamDensity        String?          @map("foam_density") @db.VarChar(30)
  thicknessCm        Decimal?         @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm           Decimal?         @map("length_cm") @db.Decimal(8, 2)
  widthCm            Decimal?         @map("width_cm") @db.Decimal(8, 2)
  quantity           Decimal          @db.Decimal(12, 3)
  unit               MaterialUnit
  notes              String?          @db.VarChar(500)

  request          MaterialRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem?    @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  requirement      MaterialRequirement?

  @@unique([requestId, position])
  @@map("material_request_items")
}

/// Histórico imutável da medição e da solicitação (com cópia dos itens a cada envio/revisão).
model MeasurementRevision {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company       CompanySettings @relation("EmpresaDeMeasurementRevision", fields: [companyId], references: [id])
  measurementId String          @map("measurement_id") @db.Uuid
  kind          String          @db.VarChar(40)
  fromStatus    String?         @map("from_status") @db.VarChar(40)
  toStatus      String?         @map("to_status") @db.VarChar(40)
  note          String?         @db.VarChar(500)
  changes       Json?
  actorId       String?         @map("actor_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([measurementId, createdAt])
  @@map("measurement_revisions")
}

// ─────────────────────────── Fase 4: compras, recebimento e estoque ───────────────────────────

enum PurchaseOrderStatus {
  RASCUNHO
  CONFIRMADO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO

  @@map("purchase_order_status")
}

enum ReceiptIssue {
  INCORRETO
  DANIFICADO
  INCOMPLETO
  OUTRO

  @@map("receipt_issue")
}

enum StockMovementType {
  ENTRADA_COMPRA
  ESTORNO_RECEBIMENTO
  SAIDA_OS
  AJUSTE_ENTRADA
  AJUSTE_SAIDA

  @@map("stock_movement_type")
}

enum ReservationStatus {
  ATIVA
  CONSUMIDA
  LIBERADA

  @@map("reservation_status")
}

enum LeftoverCondition {
  BOA
  AVARIADA

  @@map("leftover_condition")
}

enum LeftoverStatus {
  DISPONIVEL
  ESGOTADA
  DESCARTADA

  @@map("leftover_status")
}

enum MaterialReadiness {
  SEM_LEVANTAMENTO
  AGUARDANDO_APROVACAO
  AGUARDANDO_COMPRA
  AGUARDANDO_RECEBIMENTO
  PARCIALMENTE_DISPONIVEL
  COMPLETO
