// ─────────────────────────── Qualidade, embalagem e logística (Fase 10) ───────────────────────────

enum InspectionStatus {
  PENDENTE
  EM_ANDAMENTO
  APROVADA
  REPROVADA
  INVALIDADA
  CANCELADA

  @@map("inspection_status")
}

/// Modelo de checklist de inspeção por tipo de peça (configurável pelo gestor).
model QualityTemplate {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company    CompanySettings @relation("EmpresaDeQualityTemplate", fields: [companyId], references: [id])
  name       String          @db.VarChar(80)
  pieceTypes PieceType[]     @map("piece_types")
  active     Boolean         @default(true)
  version    Int             @default(1)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items       QualityTemplateItem[]
  inspections QualityInspection[]

  @@map("quality_templates")
}

model QualityTemplateItem {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDeQualityTemplateItem", fields: [companyId], references: [id])
  templateId   String          @map("template_id") @db.Uuid
  position     Int
  label        String          @db.VarChar(120)
