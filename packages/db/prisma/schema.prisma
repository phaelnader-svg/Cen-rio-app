// Cenário Gestão — esquema do banco de dados (Fase 1: fundação).
//
// Convenções:
// - Tabelas e colunas em snake_case no banco; modelos em PascalCase no código.
// - Identificadores UUID.
// - Entidades editáveis têm coluna `version` para controle otimista de concorrência.
// - Toda alteração relevante gera registro de auditoria e evento de domínio na
//   mesma transação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identidade ───────────────────────────────

/// Identidade de acesso. Credenciais ficam aqui; dados da pessoa ficam em Employee.
model User {
  id                   String    @id @default(uuid()) @db.Uuid
  /// E-mail de acesso ao painel (opcional). Sempre armazenado em minúsculas.
  email                String?   @unique @db.VarChar(254)
  passwordHash         String?   @map("password_hash")
  /// PIN de 6 dígitos para os tablets (hash argon2id).
  pinHash              String?   @map("pin_hash")
  displayName          String    @map("display_name") @db.VarChar(60)
  active               Boolean   @default(true)
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz(3)
  credentialsChangedAt DateTime? @map("credentials_changed_at") @db.Timestamptz(3)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee        Employee?
  roles           UserRole[]
  permissions     UserPermission[]
  sessions        Session[]        @relation("SessionUser")
  revokedSessions Session[]        @relation("SessionRevokedBy")
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]
  uploadedFiles   StoredFile[]
  createdDevices  Device[]         @relation("DeviceCreatedBy")
  revokedDevices  Device[]         @relation("DeviceRevokedBy")

  createdCustomers       Customer[]             @relation("CustomerCreatedBy")
  createdOrders          CommercialOrder[]      @relation("OrderCreatedBy")
  cancelledOrders        CommercialOrder[]      @relation("OrderCancelledBy")
  createdPickups         PickupRequest[]        @relation("PickupCreatedBy")
  pickupEvents           PickupEvent[]
  registeredReceipts     Receipt[]              @relation("ReceiptRegisteredBy")
  createdServiceOrders   ServiceOrder[]         @relation("ServiceOrderCreatedBy")
  cancelledServiceOrders ServiceOrder[]         @relation("ServiceOrderCancelledBy")
  measuredItems          ServiceOrderItem[]     @relation("ItemMeasuredBy")
  serviceOrderRevisions  ServiceOrderRevision[]
  attachments            Attachment[]

  assignedMeasurements  Measurement[]         @relation("MeasurementAssignee")
  requestedMeasurements Measurement[]         @relation("MeasurementRequestedBy")
  measurementRevisions  MeasurementRevision[]
  reviewedRequests      MaterialRequest[]     @relation("MaterialRequestReviewedBy")

  stockMovements          StockMovement[]            @relation("StockMovementActor")
  createdReservations     StockReservation[]         @relation("ReservationCreatedBy")
  closedReservations      StockReservation[]         @relation("ReservationClosedBy")
  createdPurchaseOrders   PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  confirmedPurchaseOrders PurchaseOrder[]            @relation("PurchaseOrderConfirmedBy")
  cancelledPurchaseOrders PurchaseOrder[]            @relation("PurchaseOrderCancelledBy")
  purchaseOrderHistory    PurchaseOrderHistory[]     @relation("PurchaseOrderHistoryActor")
  materialReceipts        MaterialReceipt[]          @relation("MaterialReceiptReceivedBy")
  receiptReversals        MaterialReceiptReversal[]  @relation("ReceiptReversalAuthorizedBy")
  createdLeftovers        MaterialLeftover[]         @relation("LeftoverCreatedBy")
  authorizedLeftoverMoves MaterialLeftoverTransfer[] @relation("LeftoverTransferAuthorizedBy")

  createdPlans       ProductionPlan[]         @relation("PlanCreatedBy")
  publishedPlans     ProductionPlan[]         @relation("PlanPublishedBy")
  principalPlanItems ProductionPlanItem[]     @relation("PlanItemPrincipal")
  planRevisions      ProductionPlanRevision[] @relation("PlanRevisionCreatedBy")
  assignedTasks      ProductionTask[]         @relation("TaskAssignee")
  completedTasks     ProductionTask[]         @relation("TaskCompletedBy")
  taskEvents         ProductionTaskEvent[]    @relation("TaskEventActor")

  @@map("users")
}

/// Pessoa que atua na empresa (gestor, tapeceiros, ajudante...).
model Employee {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(120)
  displayName      String   @map("display_name") @db.VarChar(40)
  jobTitle         String   @map("job_title") @db.VarChar(80)
  responsibilities String?  @db.VarChar(500)
  phone            String?  @db.VarChar(30)
  /// Cor de identificação visual nos tablets e no painel (#RRGGBB).
  color            String   @db.Char(7)
  photoFileId      String?  @unique @map("photo_file_id") @db.Uuid
  active           Boolean  @default(true)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  photo           StoredFile?    @relation("EmployeePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  assignedDevices Device[]
  receipts        Receipt[]      @relation("ReceiptReceivedBy")
  leadOf          ServiceOrder[] @relation("ServiceOrderTechnicalLead")

  @@index([active])
  @@map("employees")
}

// ─────────────────────────── Funções e permissões ───────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Chave estável das funções padrão (null para funções criadas pelo gestor).
  key         String?  @unique @db.VarChar(60)
  name        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(300)
  /// Funções do sistema não podem ser excluídas.
  system      Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String @db.VarChar(80)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Concessões individuais além das funções (ex.: medição extraordinária autorizada).
model UserPermission {
  userId     String @map("user_id") @db.Uuid
  permission String @db.VarChar(80)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

// ─────────────────────────── Dispositivos e sessões ───────────────────────────

enum DeviceKind {
  TABLET
  COMPUTADOR
  CELULAR

  @@map("device_kind")
}

enum DeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED

  @@map("device_status")
}

model Device {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String       @unique @db.VarChar(60)
  kind                 DeviceKind   @default(TABLET)
  location             String?      @db.VarChar(80)
  status               DeviceStatus @default(PENDING_PAIRING)
  assignedEmployeeId   String?      @map("assigned_employee_id") @db.Uuid
  restrictToAssigned   Boolean      @default(true) @map("restrict_to_assigned")
  /// Hash SHA-256 da credencial do dispositivo (o valor bruto fica só no cookie do tablet).
  credentialHash       String?      @unique @map("credential_hash") @db.Char(64)
  /// Hash SHA-256 do código de vinculação de uso único.
  pairingCodeHash      String?      @unique @map("pairing_code_hash") @db.Char(64)
  pairingCodeExpiresAt DateTime?    @map("pairing_code_expires_at") @db.Timestamptz(3)
  pairedAt             DateTime?    @map("paired_at") @db.Timestamptz(3)
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokedById          String?      @map("revoked_by_id") @db.Uuid
  lastSeenAt           DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  lastIp               String?      @map("last_ip") @db.VarChar(64)
  userAgent            String?      @map("user_agent") @db.VarChar(300)
  createdById          String?      @map("created_by_id") @db.Uuid
  version              Int          @default(1)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedEmployee Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  createdBy        User?     @relation("DeviceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy        User?     @relation("DeviceRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  sessions         Session[]

  @@index([status])
  @@map("devices")
}

enum SessionKind {
  WEB
  DEVICE

  @@map("session_kind")
}

model Session {
  id            String      @id @default(uuid()) @db.Uuid
  /// Hash SHA-256 do token de sessão; o token bruto existe apenas no cookie httpOnly.
  tokenHash     String      @unique @map("token_hash") @db.Char(64)
  kind          SessionKind
  userId        String      @map("user_id") @db.Uuid
  deviceId      String?     @map("device_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?     @map("revoked_reason") @db.VarChar(40)
  revokedById   String?     @map("revoked_by_id") @db.Uuid
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(300)

  user      User    @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  device    Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  revokedBy User?   @relation("SessionRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([deviceId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Controle persistente contra abuso de autenticação (por conta, IP ou dispositivo).
model AuthThrottle {
  key         String    @id @db.VarChar(200)
  failures    Int       @default(0)
  windowStart DateTime  @default(now()) @map("window_start") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("auth_throttle")
}

// ─────────────────────────────── Empresa ───────────────────────────────

/// Configurações da empresa (registro único, id = 1).
model CompanySettings {
  id                 Int      @id @default(1)
  tradeName          String   @map("trade_name") @db.VarChar(120)
  legalName          String?  @map("legal_name") @db.VarChar(160)
  document           String?  @db.VarChar(20)
  phone              String?  @db.VarChar(30)
  email              String?  @db.VarChar(254)
  address            String?  @db.VarChar(240)
  timezone           String   @default("America/Sao_Paulo") @db.VarChar(64)
  /// Horário a partir do qual o botão "Cheguei" é exibido (HH:MM).
  workdayStart       String   @default("08:30") @map("workday_start") @db.Char(5)
  /// Limite para alerta de indisponibilidade operacional presumida (HH:MM).
  arrivalAlertAt     String   @default("09:30") @map("arrival_alert_at") @db.Char(5)
  workdayEnd         String   @default("18:00") @map("workday_end") @db.Char(5)
  /// Dias úteis (0 = domingo ... 6 = sábado).
  workingDays        Int[]    @default([1, 2, 3, 4, 5]) @map("working_days")
  /// Dia habitual de programação da semana seguinte.
  planningWeekday    Int      @default(5) @map("planning_weekday")
  /// Dia habitual de medição de tecidos e espumas.
  measurementWeekday Int      @default(5) @map("measurement_weekday")
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById        String?  @map("updated_by_id") @db.Uuid

  @@map("company_settings")
}

// ─────────────────────────── Auditoria e eventos ───────────────────────────

/// Registro imutável de ações críticas (UPDATE/DELETE bloqueados por trigger).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  summary     String   @db.VarChar(300)
  /// Diferenças antes/depois, sem dados sensíveis.
  changes     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Eventos de domínio persistentes (outbox). `seq` define a ordem global.
model DomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  seq           BigInt   @unique @default(autoincrement())
  type          String   @db.VarChar(80)
  aggregateType String   @map("aggregate_type") @db.VarChar(60)
  aggregateId   String   @map("aggregate_id") @db.VarChar(64)
  payload       Json
  /// Quem pode receber em tempo real: 'all', 'permission:<p>' ou 'user:<id>'.
  audience      String   @default("all") @db.VarChar(400)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  requestId     String?  @map("request_id") @db.VarChar(64)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@map("domain_events")
}

/// Posição de cada consumidor de eventos (automações). Processamento ordenado,
/// pelo menos uma vez, com repetição após falha.
model EventConsumer {
  name           String    @id @db.VarChar(80)
  lastSeq        BigInt    @default(0) @map("last_seq")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lastError      String?   @map("last_error") @db.VarChar(1000)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_consumers")
}

/// Chaves de idempotência para operações sensíveis.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(100)
  scope          String   @db.VarChar(160)
  requestHash    String   @map("request_hash") @db.Char(64)
  /// null enquanto a operação está em andamento.
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────── Arquivos ───────────────────────────────

enum FileVisibility {
  PRIVATE

  @@map("file_visibility")
}

/// Metadados de arquivos privados (fotos e documentos). O conteúdo fica no
/// armazenamento privado e só é servido por rota autenticada.
model StoredFile {
  id           String         @id @default(uuid()) @db.Uuid
  storageKey   String         @unique @map("storage_key") @db.VarChar(200)
  purpose      String         @db.VarChar(40)
  originalName String         @map("original_name") @db.VarChar(200)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    Int            @map("size_bytes")
  sha256       String         @db.Char(64)
  visibility   FileVisibility @default(PRIVATE)
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  employeePhoto Employee?   @relation("EmployeePhoto")
  attachment    Attachment?

  @@map("stored_files")
}

// ═══════════════════════════ FASE 2 — Comercial e oficina ═══════════════════════════

enum CustomerKind {
  PF
  PJ

  @@map("customer_kind")
}

/// Cliente (pessoa física ou jurídica). Dados pessoais restritos por permissão.
model Customer {
  id          String       @id @default(uuid()) @db.Uuid
  kind        CustomerKind
  name        String       @db.VarChar(160)
  tradeName   String?      @map("trade_name") @db.VarChar(160)
  /// CPF/CNPJ somente dígitos. Único quando informado (duplicidade evidente).
  document    String?      @db.VarChar(14)
  phone       String?      @db.VarChar(13)
  whatsapp    String?      @db.VarChar(13)
  email       String?      @db.VarChar(254)
  notes       String?      @db.VarChar(2000)
  /// Texto normalizado (sem acentos, minúsculo) para pesquisa.
  searchText  String       @map("search_text") @db.VarChar(800)
  active      Boolean      @default(true)
  version     Int          @default(1)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  addresses     CustomerAddress[]
  orders        CommercialOrder[]
  serviceOrders ServiceOrder[]

  @@index([phone])
  @@index([whatsapp])
  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  label      String    @db.VarChar(40)
  street     String    @db.VarChar(160)
  number     String    @db.VarChar(20)
  complement String?   @db.VarChar(80)
  district   String?   @db.VarChar(80)
  city       String    @db.VarChar(80)
  state      String    @db.Char(2)
  postalCode String?   @map("postal_code") @db.Char(8)
  reference  String?   @db.VarChar(200)
  isPrimary  Boolean   @default(false) @map("is_primary")
  /// Endereços não são apagados (pedidos guardam cópia), apenas arquivados.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   CommercialOrder[]
  pickups  PickupRequest[]

  @@index([customerId])
  @@map("customer_addresses")
}

enum CommercialOrderStatus {
  AGUARDANDO_RETIRADA
  RETIRADA_AGENDADA
  RECEBIDO_PARCIAL
  RECEBIDO
  CANCELADO

  @@map("commercial_order_status")
}

enum PieceType {
  SOFA
  POLTRONA
  CADEIRA
  CABECEIRA
  CANTO_ALEMAO
  PUFE
  BANCO
  COLCHAO
  OUTRO

  @@map("piece_type")
}

/// Pedido comercial: criado após a aprovação do cliente; organiza a retirada e preserva a venda.
model CommercialOrder {
  id                    String                @id @default(uuid()) @db.Uuid
  number                Int                   @unique @default(autoincrement())
  customerId            String                @map("customer_id") @db.Uuid
  pickupAddressId       String?               @map("pickup_address_id") @db.Uuid
  /// Cópia do endereço no momento do pedido (preserva o combinado).
  pickupAddressSnapshot Json?                 @map("pickup_address_snapshot")
  contractedService     String                @map("contracted_service") @db.VarChar(300)
  description           String?               @db.VarChar(2000)
  agreedValueCents      Int?                  @map("agreed_value_cents")
  paymentTerms          String?               @map("payment_terms") @db.VarChar(1000)
  notes                 String?               @db.VarChar(2000)
  status                CommercialOrderStatus @default(AGUARDANDO_RETIRADA)
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?               @map("cancelled_by_id") @db.Uuid
  cancelReason          String?               @map("cancel_reason") @db.VarChar(500)
  version               Int                   @default(1)
  createdById           String?               @map("created_by_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickupAddress CustomerAddress?      @relation(fields: [pickupAddressId], references: [id], onDelete: Restrict)
  createdBy     User?                 @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?                 @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items         CommercialOrderItem[]
  pickups       PickupRequest[]
  receipts      Receipt[]
  serviceOrders ServiceOrder[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("commercial_orders")
}

model CommercialOrderItem {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  position         Int
  pieceType        PieceType @map("piece_type")
  description      String    @db.VarChar(300)
  quantity         Int
  /// Mantido pelo registro de recebimentos (nunca maior que a quantidade).
  receivedQuantity Int       @default(0) @map("received_quantity")
  notes            String?   @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order             CommercialOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pickupItems       PickupRequestItem[]
  receiptLines      ReceiptLine[]
  serviceOrderItems ServiceOrderItem[]

  @@unique([orderId, position])
  @@map("commercial_order_items")
}

enum PickupStatus {
  AGUARDANDO_AGENDAMENTO
  AGENDADA
  EM_EXECUCAO
  RETIRADA_REALIZADA
  RECEBIDA_NA_OFICINA
  CANCELADA
  COM_OCORRENCIA

  @@map("pickup_status")
}

enum PickupTeam {
  LOGISTICA_TERCEIRIZADA
  EQUIPE_PROPRIA

  @@map("pickup_team")
}

/// Solicitação de retirada (preparada para integração futura com a logística terceirizada).
model PickupRequest {
  id                String       @id @default(uuid()) @db.Uuid
  number            Int          @unique @default(autoincrement())
  orderId           String       @map("order_id") @db.Uuid
  addressId         String?      @map("address_id") @db.Uuid
  addressSnapshot   Json?        @map("address_snapshot")
  scheduledDate     DateTime?    @map("scheduled_date") @db.Date
  windowStart       String?      @map("window_start") @db.Char(5)
  windowEnd         String?      @map("window_end") @db.Char(5)
  team              PickupTeam   @default(LOGISTICA_TERCEIRIZADA)
  teamNotes         String?      @map("team_notes") @db.VarChar(200)
  instructions      String?      @db.VarChar(1000)
  /// Protocolo/identificador no sistema da logística (integração futura).
  externalReference String?      @map("external_reference") @db.VarChar(80)
  status            PickupStatus @default(AGUARDANDO_AGENDAMENTO)
  version           Int          @default(1)
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     CommercialOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  address   CustomerAddress?    @relation(fields: [addressId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("PickupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     PickupRequestItem[]
  events    PickupEvent[]
  receipts  Receipt[]

  @@index([orderId])
  @@index([status])
  @@index([scheduledDate])
  @@map("pickup_requests")
}

model PickupRequestItem {
  pickupId    String @map("pickup_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  pickup    PickupRequest       @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  orderItem CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@id([pickupId, orderItemId])
  @@map("pickup_request_items")
}

enum EventSource {
  MANUAL
  SISTEMA
  INTEGRACAO

  @@map("event_source")
}

/// Linha do tempo da retirada (confirmações manuais agora; integração no futuro).
model PickupEvent {
  id           String        @id @default(uuid()) @db.Uuid
  pickupId     String        @map("pickup_id") @db.Uuid
  kind         String        @db.VarChar(40)
  fromStatus   PickupStatus? @map("from_status")
  toStatus     PickupStatus? @map("to_status")
  note         String?       @db.VarChar(1000)
  source       EventSource   @default(MANUAL)
  recordedById String?       @map("recorded_by_id") @db.Uuid
  occurredAt   DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  pickup     PickupRequest @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  recordedBy User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([pickupId, occurredAt])
  @@map("pickup_events")
}

enum ReceiptOrigin {
  RETIRADA
  ENTREGUE_PELO_CLIENTE

  @@map("receipt_origin")
}

enum PieceCondition {
  BOA
  REGULAR
  DANIFICADA

  @@map("piece_condition")
}

/// Recebimento físico das peças na oficina (pode ser parcial).
model Receipt {
  id                   String        @id @default(uuid()) @db.Uuid
  number               Int           @unique @default(autoincrement())
  orderId              String        @map("order_id") @db.Uuid
  pickupId             String?       @map("pickup_id") @db.Uuid
  origin               ReceiptOrigin
  receivedAt           DateTime      @map("received_at") @db.Timestamptz(3)
  receivedByEmployeeId String?       @map("received_by_employee_id") @db.Uuid
  registeredById       String?       @map("registered_by_id") @db.Uuid
  divergences          String?       @db.VarChar(2000)
  notes                String?       @db.VarChar(2000)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order        CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pickup       PickupRequest?  @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  receivedBy   Employee?       @relation("ReceiptReceivedBy", fields: [receivedByEmployeeId], references: [id], onDelete: SetNull)
  registeredBy User?           @relation("ReceiptRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  lines        ReceiptLine[]

  @@index([orderId])
  @@index([receivedAt(sort: Desc)])
  @@map("receipts")
}

model ReceiptLine {
  id             String         @id @default(uuid()) @db.Uuid
  receiptId      String         @map("receipt_id") @db.Uuid
  orderItemId    String         @map("order_item_id") @db.Uuid
  quantity       Int
  condition      PieceCondition
  conditionNotes String?        @map("condition_notes") @db.VarChar(500)
  location       String         @db.VarChar(80)

  receipt   Receipt             @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  orderItem CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([receiptId, orderItemId])
  @@index([orderItemId])
  @@map("receipt_lines")
}

enum ServiceOrderStatus {
  ABERTA
  CANCELADA

  @@map("service_order_status")
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  URGENTE

  @@map("priority")
}

enum ServiceType {
  REFORMA_COMPLETA
  TROCA_DE_TECIDO
  TROCA_DE_ESPUMA
  REPARO
  FABRICACAO
  INSTALACAO
  OUTRO

  @@map("service_type")
}

enum MeasurementKind {
  ROTINA
  EXTRAORDINARIA

  @@map("measurement_kind")
}

/// Ordem de serviço técnica: só existe para peças efetivamente recebidas.
model ServiceOrder {
  id                    String             @id @default(uuid()) @db.Uuid
  number                Int                @unique @default(autoincrement())
  orderId               String             @map("order_id") @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  status                ServiceOrderStatus @default(ABERTA)
  technicalInstructions String?            @map("technical_instructions") @db.VarChar(4000)
  notes                 String?            @db.VarChar(2000)
  promisedDate          DateTime?          @map("promised_date") @db.Date
  priority              Priority           @default(NORMAL)
  technicalLeadId       String?            @map("technical_lead_id") @db.Uuid
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?            @map("cancelled_by_id") @db.Uuid
  cancelReason          String?            @map("cancel_reason") @db.VarChar(500)
  version               Int                @default(1)
  createdById           String?            @map("created_by_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         CommercialOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technicalLead Employee?              @relation("ServiceOrderTechnicalLead", fields: [technicalLeadId], references: [id], onDelete: SetNull)
  createdBy     User?                  @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?                  @relation("ServiceOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items         ServiceOrderItem[]
  revisions     ServiceOrderRevision[]
  materials     MaterialRequirement[]
  measurements  Measurement[]

  // Fase 4: prontidão de materiais (calculada a partir dos registros; não libera produção).
  materialsReadiness   MaterialReadiness @default(SEM_LEVANTAMENTO) @map("materials_readiness")
  materialsReadinessAt DateTime?         @map("materials_readiness_at") @db.Timestamptz(3)

  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  purchaseItems       PurchaseOrderItem[]
  purchaseAllocations PurchaseAllocation[]
  leftovers           MaterialLeftover[]
  leftoversOut        MaterialLeftoverTransfer[] @relation("LeftoverTransferFrom")
  leftoversIn         MaterialLeftoverTransfer[] @relation("LeftoverTransferTo")

  productionPlanItems ProductionPlanItem[]
  productionTasks     ProductionTask[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("service_orders")
}

/// Peça (ou conjunto de peças idênticas) da OS, com identificação individual (código OS-xxxxx/n).
model ServiceOrderItem {
  id               String           @id @default(uuid()) @db.Uuid
  serviceOrderId   String           @map("service_order_id") @db.Uuid
  orderItemId      String           @map("order_item_id") @db.Uuid
  position         Int
  pieceType        PieceType        @map("piece_type")
  description      String           @db.VarChar(300)
  quantity         Int
  serviceType      ServiceType      @map("service_type")
  fabricName       String?          @map("fabric_name") @db.VarChar(120)
  fabricColor      String?          @map("fabric_color") @db.VarChar(80)
  fabricReference  String?          @map("fabric_reference") @db.VarChar(80)
  foamSpecs        String?          @map("foam_specs") @db.VarChar(500)
  technicalNotes   String?          @map("technical_notes") @db.VarChar(2000)
  /// Lista de medidas [{ label, valueCm }].
  measurements     Json             @default("[]")
  measurementNotes String?          @map("measurement_notes") @db.VarChar(1000)
  measuredAt       DateTime?        @map("measured_at") @db.Timestamptz(3)
  measuredById     String?          @map("measured_by_id") @db.Uuid
  measurementKind  MeasurementKind? @map("measurement_kind")
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrder      ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  orderItem         CommercialOrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  measuredBy        User?                 @relation("ItemMeasuredBy", fields: [measuredById], references: [id], onDelete: SetNull)
  materials         MaterialRequirement[]
  measurementTasks  Measurement[]
  measurementPieces MeasurementPiece[]
  requestItems      MaterialRequestItem[]

  productionTasks ProductionTask[]

  @@unique([serviceOrderId, position])
  @@index([orderItemId])
  @@map("service_order_items")
}

/// Histórico técnico da OS (imutável): cada alteração gera uma revisão numerada.
model ServiceOrderRevision {
  id             String   @id @default(uuid()) @db.Uuid
  serviceOrderId String   @map("service_order_id") @db.Uuid
  revision       Int
  scope          String   @db.VarChar(20)
  itemId         String?  @map("item_id") @db.Uuid
  changes        Json
  reason         String?  @db.VarChar(300)
  changedById    String?  @map("changed_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([serviceOrderId, revision])
  @@map("service_order_revisions")
}

enum MaterialKind {
  TECIDO
  ESPUMA
  OUTRO

  @@map("material_kind")
}

enum MaterialSourcing {
  EXCLUSIVO_OS
  ESTOQUE

  @@map("material_sourcing")
}

/// Necessidade de material da OS (estrutura preparatória para compras/estoque — Fase 3).
/// Tecido é sempre de compra exclusiva da OS. Não dispara produção.
model MaterialRequirement {
  id                 String           @id @default(uuid()) @db.Uuid
  serviceOrderId     String           @map("service_order_id") @db.Uuid
  serviceOrderItemId String?          @map("service_order_item_id") @db.Uuid
  kind               MaterialKind
  description        String           @db.VarChar(200)
  quantity           Decimal?         @db.Decimal(12, 3)
  unit               String?          @db.VarChar(20)
  sourcing           MaterialSourcing
  notes              String?          @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  // Fase 3: necessidades aprovadas a partir de solicitações de material.
  /// PREVISAO_MANUAL (Fase 2, não conferida) ou SOLICITACAO_APROVADA (conferida pelo gestor).
  origin                MaterialRequirementOrigin @default(PREVISAO_MANUAL)
  materialRequestItemId String?                   @unique @map("material_request_item_id") @db.Uuid
  unitCode              MaterialUnit?             @map("unit_code")
  color                 String?                   @db.VarChar(60)
  reference             String?                   @db.VarChar(80)
  foamDensity           String?                   @map("foam_density") @db.VarChar(30)
  thicknessCm           Decimal?                  @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm              Decimal?                  @map("length_cm") @db.Decimal(8, 2)
  widthCm               Decimal?                  @map("width_cm") @db.Decimal(8, 2)
  approvedAt            DateTime?                 @map("approved_at") @db.Timestamptz(3)

  serviceOrder        ServiceOrder               @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  serviceOrderItem    ServiceOrderItem?          @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  materialRequestItem MaterialRequestItem?       @relation(fields: [materialRequestItemId], references: [id], onDelete: Restrict)
  allocations         PurchaseAllocation[]
  reservations        StockReservation[]
  transfersIn         MaterialLeftoverTransfer[]

  @@index([serviceOrderId])
  @@map("material_requirements")
}

enum AttachmentEntity {
  COMMERCIAL_ORDER
  PICKUP
  RECEIPT
  SERVICE_ORDER
  SERVICE_ORDER_ITEM

  @@map("attachment_entity")
}

/// Vínculo entre arquivo privado (stored_files) e um registro do fluxo.
model Attachment {
  id          String           @id @default(uuid()) @db.Uuid
  fileId      String           @unique @map("file_id") @db.Uuid
  entityType  AttachmentEntity @map("entity_type")
  entityId    String           @map("entity_id") @db.Uuid
  caption     String?          @db.VarChar(200)
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(3)

  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("attachments")
}

// ═══════════════════════ FASE 3 — Medições e solicitações de materiais ═══════════════════════

enum MaterialRequirementOrigin {
  PREVISAO_MANUAL
  SOLICITACAO_APROVADA

  @@map("material_requirement_origin")
}

enum MeasurementStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA

  @@map("measurement_status")
}

enum MaterialRequestStatus {
  RASCUNHO
  ENVIADA
  EM_REVISAO
  APROVADA
  DEVOLVIDA
  CANCELADA

  @@map("material_request_status")
}

enum MaterialUnit {
  METRO
  METRO_QUADRADO
  PLACA
  PECA
  UNIDADE
  EMBALAGEM

  @@map("material_unit")
}

/// Tarefa de medição (rotina de sexta ou extraordinária) de uma OS ou peça.
/// Não inicia produção: apenas registra medidas e necessidades de material.
model Measurement {
  id                 String            @id @default(uuid()) @db.Uuid
  number             Int               @unique @default(autoincrement())
  serviceOrderId     String            @map("service_order_id") @db.Uuid
  /// Peça específica; nulo = OS inteira.
  serviceOrderItemId String?           @map("service_order_item_id") @db.Uuid
  kind               MeasurementKind
  status             MeasurementStatus @default(PENDENTE)
  assigneeUserId     String            @map("assignee_user_id") @db.Uuid
  requestedById      String?           @map("requested_by_id") @db.Uuid
  requestedAt        DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  dueDate            DateTime          @map("due_date") @db.Date
  reason             String?           @db.VarChar(500)
  notes              String?           @db.VarChar(2000)
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?           @map("cancel_reason") @db.VarChar(500)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceOrder     ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  serviceOrderItem ServiceOrderItem?     @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  assignee         User                  @relation("MeasurementAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  requestedBy      User?                 @relation("MeasurementRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  pieces           MeasurementPiece[]
  request          MaterialRequest?
  revisions        MeasurementRevision[]

  @@index([assigneeUserId, status])
  @@index([serviceOrderId])
  @@index([status, dueDate])
  @@map("measurements")
}

/// Medidas de cada peça registradas na medição.
model MeasurementPiece {
  measurementId      String  @map("measurement_id") @db.Uuid
  serviceOrderItemId String  @map("service_order_item_id") @db.Uuid
  /// [{ label, valueCm }]
  dimensions         Json    @default("[]")
  notes              String? @db.VarChar(1000)

  measurement      Measurement      @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)

  @@id([measurementId, serviceOrderItemId])
  @@map("measurement_pieces")
}

/// Solicitação de materiais gerada pela medição (uma por medição).
/// "Aprovada" = quantidades conferidas pelo gestor; NÃO é compra nem recebimento.
model MaterialRequest {
  id            String                @id @default(uuid()) @db.Uuid
  measurementId String                @unique @map("measurement_id") @db.Uuid
  status        MaterialRequestStatus @default(RASCUNHO)
  submittedAt   DateTime?             @map("submitted_at") @db.Timestamptz(3)
  reviewedById  String?               @map("reviewed_by_id") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(3)
  returnReason  String?               @map("return_reason") @db.VarChar(500)
  version       Int                   @default(1)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  measurement Measurement           @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  reviewedBy  User?                 @relation("MaterialRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items       MaterialRequestItem[]

  @@index([status])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                 String           @id @default(uuid()) @db.Uuid
  requestId          String           @map("request_id") @db.Uuid
  position           Int
  serviceOrderItemId String?          @map("service_order_item_id") @db.Uuid
  kind               MaterialKind
  sourcing           MaterialSourcing
  description        String           @db.VarChar(160)
  color              String?          @db.VarChar(60)
  reference          String?          @db.VarChar(80)
  foamDensity        String?          @map("foam_density") @db.VarChar(30)
  thicknessCm        Decimal?         @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm           Decimal?         @map("length_cm") @db.Decimal(8, 2)
  widthCm            Decimal?         @map("width_cm") @db.Decimal(8, 2)
  quantity           Decimal          @db.Decimal(12, 3)
  unit               MaterialUnit
  notes              String?          @db.VarChar(500)

  request          MaterialRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceOrderItem ServiceOrderItem?    @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  requirement      MaterialRequirement?

  @@unique([requestId, position])
  @@map("material_request_items")
}

/// Histórico imutável da medição e da solicitação (com cópia dos itens a cada envio/revisão).
model MeasurementRevision {
  id            String   @id @default(uuid()) @db.Uuid
  measurementId String   @map("measurement_id") @db.Uuid
  kind          String   @db.VarChar(40)
  fromStatus    String?  @map("from_status") @db.VarChar(40)
  toStatus      String?  @map("to_status") @db.VarChar(40)
  note          String?  @db.VarChar(500)
  changes       Json?
  actorId       String?  @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Restrict)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([measurementId, createdAt])
  @@map("measurement_revisions")
}

// ─────────────────────────── Fase 4: compras, recebimento e estoque ───────────────────────────

enum PurchaseOrderStatus {
  RASCUNHO
  CONFIRMADO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO

  @@map("purchase_order_status")
}

enum ReceiptIssue {
  INCORRETO
  DANIFICADO
  INCOMPLETO
  OUTRO

  @@map("receipt_issue")
}

enum StockMovementType {
  ENTRADA_COMPRA
  ESTORNO_RECEBIMENTO
  SAIDA_OS
  AJUSTE_ENTRADA
  AJUSTE_SAIDA

  @@map("stock_movement_type")
}

enum ReservationStatus {
  ATIVA
  CONSUMIDA
  LIBERADA

  @@map("reservation_status")
}

enum LeftoverCondition {
  BOA
  AVARIADA

  @@map("leftover_condition")
}

enum LeftoverStatus {
  DISPONIVEL
  ESGOTADA
  DESCARTADA

  @@map("leftover_status")
}

enum MaterialReadiness {
  SEM_LEVANTAMENTO
  AGUARDANDO_APROVACAO
  AGUARDANDO_COMPRA
  AGUARDANDO_RECEBIMENTO
  PARCIALMENTE_DISPONIVEL
  COMPLETO
  COM_DIVERGENCIA

  @@map("material_readiness")
}

/// Fornecedor (cadastro simples; sem contratos nem avaliações).
model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(160)
  contactName String?        @map("contact_name") @db.VarChar(120)
  phone       String?        @db.VarChar(30)
  email       String?        @db.VarChar(160)
  address     String?        @db.VarChar(300)
  categories  MaterialKind[]
  notes       String?        @db.VarChar(1000)
  active      Boolean        @default(true)
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

/// Material comum do catálogo (espumas, MDF, ferragens…), com saldo físico e reservado.
/// Tecido não entra no estoque comum: é sempre da OS que o comprou.
model StockItem {
  id          String       @id @default(uuid()) @db.Uuid
  number      Int          @unique @default(autoincrement())
  kind        MaterialKind
  description String       @db.VarChar(160)
  foamDensity String?      @map("foam_density") @db.VarChar(30)
  thicknessCm Decimal?     @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm    Decimal?     @map("length_cm") @db.Decimal(8, 2)
  widthCm     Decimal?     @map("width_cm") @db.Decimal(8, 2)
  unit        MaterialUnit
  /// Especificação normalizada: impede dois cadastros do mesmo material.
  specKey     String       @unique @map("spec_key") @db.VarChar(400)
  onHand      Decimal      @default(0) @map("on_hand") @db.Decimal(12, 3)
  reserved    Decimal      @default(0) @db.Decimal(12, 3)
  minQuantity Decimal?     @map("min_quantity") @db.Decimal(12, 3)
  location    String?      @db.VarChar(120)
  notes       String?      @db.VarChar(500)
  active      Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  movements     StockMovement[]
  reservations  StockReservation[]
  purchaseItems PurchaseOrderItem[]

  @@map("stock_items")
}

/// Movimentação de estoque (imutável). `quantity` com sinal; saldo após o lançamento.
model StockMovement {
  id                    String            @id @default(uuid()) @db.Uuid
  stockItemId           String            @map("stock_item_id") @db.Uuid
  type                  StockMovementType
  quantity              Decimal           @db.Decimal(12, 3)
  balanceAfter          Decimal           @map("balance_after") @db.Decimal(12, 3)
  reservedAfter         Decimal           @map("reserved_after") @db.Decimal(12, 3)
  serviceOrderId        String?           @map("service_order_id") @db.Uuid
  materialReceiptLineId String?           @map("material_receipt_line_id") @db.Uuid
  reservationId         String?           @map("reservation_id") @db.Uuid
  reason                String?           @db.VarChar(500)
  actorId               String?           @map("actor_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  stockItem    StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder?        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  receiptLine  MaterialReceiptLine? @relation(fields: [materialReceiptLineId], references: [id], onDelete: Restrict)
  reservation  StockReservation?    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actor        User?                @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
  @@index([serviceOrderId])
  @@map("stock_movements")
}

/// Reserva de material comum para uma OS (impede que duas OS usem a mesma quantidade).
model StockReservation {
  id                    String            @id @default(uuid()) @db.Uuid
  stockItemId           String            @map("stock_item_id") @db.Uuid
  serviceOrderId        String            @map("service_order_id") @db.Uuid
  materialRequirementId String?           @map("material_requirement_id") @db.Uuid
  quantity              Decimal           @db.Decimal(12, 3)
  status                ReservationStatus @default(ATIVA)
  notes                 String?           @db.VarChar(300)
  createdById           String?           @map("created_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById            String?           @map("closed_by_id") @db.Uuid
  closeReason           String?           @map("close_reason") @db.VarChar(500)
  version               Int               @default(1)

  stockItem    StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder         @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  requirement  MaterialRequirement? @relation(fields: [materialRequirementId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy     User?                @relation("ReservationClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements    StockMovement[]

  @@index([serviceOrderId])
  @@index([stockItemId, status])
  @@index([materialRequirementId])
  @@map("stock_reservations")
}

/// Pedido de compra (CP-00001). Preços em centavos; sem pagamentos.
model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  number        Int                 @unique @default(autoincrement())
  supplierId    String?             @map("supplier_id") @db.Uuid
  status        PurchaseOrderStatus @default(RASCUNHO)
  expectedDate  DateTime?           @map("expected_date") @db.Date
  notes         String?             @db.VarChar(2000)
  createdById   String?             @map("created_by_id") @db.Uuid
  confirmedAt   DateTime?           @map("confirmed_at") @db.Timestamptz(3)
  confirmedById String?             @map("confirmed_by_id") @db.Uuid
  cancelledAt   DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?             @map("cancelled_by_id") @db.Uuid
  cancelReason  String?             @map("cancel_reason") @db.VarChar(500)
  version       Int                 @default(1)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier    Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User?                  @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy User?                  @relation("PurchaseOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledBy User?                  @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]
  history     PurchaseOrderHistory[]
  receipts    MaterialReceipt[]

  @@index([status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String           @id @default(uuid()) @db.Uuid
  purchaseOrderId  String           @map("purchase_order_id") @db.Uuid
  position         Int
  kind             MaterialKind
  sourcing         MaterialSourcing
  description      String           @db.VarChar(160)
  color            String?          @db.VarChar(60)
  reference        String?          @db.VarChar(80)
  foamDensity      String?          @map("foam_density") @db.VarChar(30)
  thicknessCm      Decimal?         @map("thickness_cm") @db.Decimal(8, 2)
  lengthCm         Decimal?         @map("length_cm") @db.Decimal(8, 2)
  widthCm          Decimal?         @map("width_cm") @db.Decimal(8, 2)
  unit             MaterialUnit
  quantity         Decimal          @db.Decimal(12, 3)
  /// Recebimento acima do pedido autorizado explicitamente pelo gestor.
  extraAuthorized  Decimal          @default(0) @map("extra_authorized") @db.Decimal(12, 3)
  /// Recebido conforme, líquido de estornos (mantido na mesma transação).
  receivedQuantity Decimal          @default(0) @map("received_quantity") @db.Decimal(12, 3)
  unitPriceCents   Int?             @map("unit_price_cents")
  serviceOrderId   String?          @map("service_order_id") @db.Uuid
  stockItemId      String?          @map("stock_item_id") @db.Uuid
  notes            String?          @db.VarChar(500)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  serviceOrder  ServiceOrder?         @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  stockItem     StockItem?            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  allocations   PurchaseAllocation[]
  receiptLines  MaterialReceiptLine[]

  @@unique([purchaseOrderId, position])
  @@index([serviceOrderId])
  @@map("purchase_order_items")
}

/// Origem da quantidade comprada: necessidade aprovada de uma OS (preservada na compra consolidada).
model PurchaseAllocation {
  id                    String   @id @default(uuid()) @db.Uuid
  purchaseOrderItemId   String   @map("purchase_order_item_id") @db.Uuid
  materialRequirementId String   @map("material_requirement_id") @db.Uuid
  serviceOrderId        String   @map("service_order_id") @db.Uuid
  quantity              Decimal  @db.Decimal(12, 3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item         PurchaseOrderItem   @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  requirement  MaterialRequirement @relation(fields: [materialRequirementId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderItemId, materialRequirementId])
  @@index([materialRequirementId])
  @@index([serviceOrderId])
  @@map("purchase_allocations")
}

/// Histórico imutável do pedido de compra.
model PurchaseOrderHistory {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  kind            String   @db.VarChar(40)
  note            String?  @db.VarChar(500)
  changes         Json?
  actorId         String?  @map("actor_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  actor         User?         @relation("PurchaseOrderHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId, createdAt])
  @@map("purchase_order_history")
}

/// Recebimento de materiais (RM-00001), imutável; correções por estorno.
model MaterialReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  number          Int      @unique @default(autoincrement())
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  receivedById    String   @map("received_by_id") @db.Uuid
  deviceId        String?  @map("device_id") @db.Uuid
  notes           String?  @db.VarChar(1000)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy    User                  @relation("MaterialReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines         MaterialReceiptLine[]

  @@index([purchaseOrderId])
  @@map("material_receipts")
}

model MaterialReceiptLine {
  id                  String        @id @default(uuid()) @db.Uuid
  receiptId           String        @map("receipt_id") @db.Uuid
  purchaseOrderItemId String        @map("purchase_order_item_id") @db.Uuid
  acceptedQuantity    Decimal       @map("accepted_quantity") @db.Decimal(12, 3)
  rejectedQuantity    Decimal       @default(0) @map("rejected_quantity") @db.Decimal(12, 3)
  specConfirmed       Boolean       @map("spec_confirmed")
  issue               ReceiptIssue?
  issueNote           String?       @map("issue_note") @db.VarChar(500)

  receipt   MaterialReceipt           @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  item      PurchaseOrderItem         @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  reversals MaterialReceiptReversal[]
  movements StockMovement[]

  @@index([purchaseOrderItemId])
  @@map("material_receipt_lines")
}

/// Estorno (lançamento compensatório) de parte do recebido conforme. Imutável.
model MaterialReceiptReversal {
  id             String   @id @default(uuid()) @db.Uuid
  receiptLineId  String   @map("receipt_line_id") @db.Uuid
  quantity       Decimal  @db.Decimal(12, 3)
  reason         String   @db.VarChar(500)
  authorizedById String   @map("authorized_by_id") @db.Uuid
  impact         Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  line         MaterialReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  authorizedBy User                @relation("ReceiptReversalAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([receiptLineId])
  @@map("material_receipt_reversals")
}

/// Sobra de material após o uso. Tecido continua da OS de origem; só sai por transferência autorizada.
model MaterialLeftover {
  id              String            @id @default(uuid()) @db.Uuid
  serviceOrderId  String            @map("service_order_id") @db.Uuid
  kind            MaterialKind
  description     String            @db.VarChar(160)
  color           String?           @db.VarChar(60)
  reference       String?           @db.VarChar(80)
  foamDensity     String?           @map("foam_density") @db.VarChar(30)
  thicknessCm     Decimal?          @map("thickness_cm") @db.Decimal(8, 2)
  quantity        Decimal           @db.Decimal(12, 3)
  initialQuantity Decimal           @map("initial_quantity") @db.Decimal(12, 3)
  unit            MaterialUnit
  location        String            @db.VarChar(120)
  condition       LeftoverCondition
  reusable        Boolean
  status          LeftoverStatus    @default(DISPONIVEL)
  notes           String?           @db.VarChar(500)
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int               @default(1)

  serviceOrder ServiceOrder               @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  createdBy    User?                      @relation("LeftoverCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  transfers    MaterialLeftoverTransfer[]

  @@index([serviceOrderId])
  @@map("material_leftovers")
}

/// Transferência de sobra entre OS — sempre autorizada pelo gestor (imutável).
model MaterialLeftoverTransfer {
  id                 String   @id @default(uuid()) @db.Uuid
  leftoverId         String   @map("leftover_id") @db.Uuid
  fromServiceOrderId String   @map("from_service_order_id") @db.Uuid
  toServiceOrderId   String   @map("to_service_order_id") @db.Uuid
  toRequirementId    String?  @map("to_requirement_id") @db.Uuid
  quantity           Decimal  @db.Decimal(12, 3)
  reason             String   @db.VarChar(500)
  authorizedById     String   @map("authorized_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  leftover         MaterialLeftover     @relation(fields: [leftoverId], references: [id], onDelete: Restrict)
  fromServiceOrder ServiceOrder         @relation("LeftoverTransferFrom", fields: [fromServiceOrderId], references: [id], onDelete: Restrict)
  toServiceOrder   ServiceOrder         @relation("LeftoverTransferTo", fields: [toServiceOrderId], references: [id], onDelete: Restrict)
  toRequirement    MaterialRequirement? @relation(fields: [toRequirementId], references: [id], onDelete: Restrict)
  authorizedBy     User                 @relation("LeftoverTransferAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([toRequirementId])
  @@map("material_leftover_transfers")
}

// ─────────────────────────── Fase 5: motor de produção ───────────────────────────

enum ProductionActivity {
  DESMONTAGEM
  PREPARACAO
  PREPARACAO_MDF
  CORTE_TECIDO
  CORTE_ESPUMA
  CORTE
  COSTURA
  REVESTIMENTO
  MONTAGEM
  ACABAMENTO
  APOIO
  OUTRA

  @@map("production_activity")
}

enum TaskStatus {
  RASCUNHO
  BLOQUEADA
  PROGRAMADA
  LIBERADA
  EM_EXECUCAO
  PAUSADA
  CONCLUIDA
  CANCELADA

  @@map("task_status")
}

enum TaskRole {
  PRINCIPAL
  APOIO

  @@map("task_role")
}

enum PauseReason {
  FIM_EXPEDIENTE
  AGUARDANDO_ORIENTACAO
  INTERRUPCAO_PROGRAMADA
  OUTRO

  @@map("pause_reason")
}

enum PlanStatus {
  RASCUNHO
  PUBLICADO

  @@map("plan_status")
}

/// Modelo configurável de etapas por tipo de peça (sugestão inicial; cada OS pode ser adaptada).
model ProductionTemplate {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(80)
  pieceTypes PieceType[] @map("piece_types")
  active     Boolean     @default(true)
  version    Int         @default(1)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  steps ProductionTemplateStep[]

  @@map("production_templates")
}

model ProductionTemplateStep {
  id                String             @id @default(uuid()) @db.Uuid
  templateId        String             @map("template_id") @db.Uuid
  position          Int
  activity          ProductionActivity
  name              String             @db.VarChar(80)
  role              TaskRole           @default(APOIO)
  requiresMaterials Boolean            @default(false) @map("requires_materials")
  optional          Boolean            @default(false)
  dependsOn         Int[]              @map("depends_on")

  template ProductionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("production_template_steps")
}

/// Planejamento semanal de produção (um por semana; segunda-feira como referência).
model ProductionPlan {
  id            String     @id @default(uuid()) @db.Uuid
  weekStart     DateTime   @unique @map("week_start") @db.Date
  status        PlanStatus @default(RASCUNHO)
  /// Número da última revisão publicada (0 = nunca publicado).
  revision      Int        @default(0)
  notes         String?    @db.VarChar(1000)
  createdById   String?    @map("created_by_id") @db.Uuid
  publishedAt   DateTime?  @map("published_at") @db.Timestamptz(3)
  publishedById String?    @map("published_by_id") @db.Uuid
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?                    @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User?                    @relation("PlanPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  items       ProductionPlanItem[]
  tasks       ProductionTask[]
  revisions   ProductionPlanRevision[]

  @@map("production_plans")
}

/// OS selecionada para a semana, com o tapeceiro principal e a prioridade.
model ProductionPlanItem {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  serviceOrderId  String   @map("service_order_id") @db.Uuid
  principalUserId String?  @map("principal_user_id") @db.Uuid
  priority        Priority @default(NORMAL)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan         ProductionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  principal    User?          @relation("PlanItemPrincipal", fields: [principalUserId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceOrderId])
  @@map("production_plan_items")
}

/// Revisão publicada (imutável): cópia completa das tarefas, quem publicou e por quê.
model ProductionPlanRevision {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  revision    Int
  reason      String?  @db.VarChar(500)
  offSchedule Boolean  @default(false) @map("off_schedule")
  snapshot    Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan      ProductionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("PlanRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([planId, revision])
  @@map("production_plan_revisions")
}

/// Tarefa individual de produção (TP-00001).
model ProductionTask {
  id                 String             @id @default(uuid()) @db.Uuid
  number             Int                @unique @default(autoincrement())
  planId             String?            @map("plan_id") @db.Uuid
  serviceOrderId     String             @map("service_order_id") @db.Uuid
  serviceOrderItemId String?            @map("service_order_item_id") @db.Uuid
  activity           ProductionActivity
  title              String             @db.VarChar(120)
  role               TaskRole           @default(APOIO)
  assigneeUserId     String?            @map("assignee_user_id") @db.Uuid
  priority           Priority           @default(NORMAL)
  sequence           Int                @default(0)
  scheduledAt        DateTime?          @map("scheduled_at") @db.Timestamptz(3)
  dueDate            DateTime?          @map("due_date") @db.Date
  instructions       String?            @db.VarChar(2000)
  requiresMaterials  Boolean            @default(false) @map("requires_materials")
  status             TaskStatus         @default(RASCUNHO)
  blockers           String[]           @default([])
  blockedReason      String?            @map("blocked_reason") @db.VarChar(500)
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(3)
  completedById      String?            @map("completed_by_id") @db.Uuid
  completedDeviceId  String?            @map("completed_device_id") @db.Uuid
  pauseReason        PauseReason?       @map("pause_reason")
  pauseNote          String?            @map("pause_note") @db.VarChar(300)
  progressNote       String?            @map("progress_note") @db.VarChar(500)
  progressPercent    Int?               @map("progress_percent")
  progressAt         DateTime?          @map("progress_at") @db.Timestamptz(3)
  cancelReason       String?            @map("cancel_reason") @db.VarChar(500)
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan             ProductionPlan?       @relation(fields: [planId], references: [id], onDelete: Restrict)
  serviceOrder     ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  serviceOrderItem ServiceOrderItem?     @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  assignee         User?                 @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  completedBy      User?                 @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  dependsOn        TaskDependency[]      @relation("TaskDependsOn")
  dependents       TaskDependency[]      @relation("TaskDependents")
  events           ProductionTaskEvent[]

  @@index([assigneeUserId, status])
  @@index([serviceOrderId])
  @@index([planId])
  @@index([status, scheduledAt])
  @@map("production_tasks")
}

/// Dependência explícita: `taskId` só começa depois de `dependsOnId` concluída (grafo acíclico).
model TaskDependency {
  taskId      String   @map("task_id") @db.Uuid
  dependsOnId String   @map("depends_on_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task      ProductionTask @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn ProductionTask @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("production_task_dependencies")
}

/// Histórico imutável de cada tarefa (criação, publicação, liberação, execução, revisões).
model ProductionTaskEvent {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  kind       String   @db.VarChar(40)
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String?  @map("to_status") @db.VarChar(20)
  note       String?  @db.VarChar(500)
  changes    Json?
  actorId    String?  @map("actor_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task  ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User?          @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("production_task_events")
}
