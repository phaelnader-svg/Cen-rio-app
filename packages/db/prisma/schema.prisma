/// Agente de IA do escritório. Função, instruções, dados consultáveis e política de ações.
model AiAgent {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company        CompanySettings @relation("EmpresaDeAiAgent", fields: [companyId], references: [id])
  deskStationId  String?         @map("desk_station_id") @db.Uuid
  name           String          @db.VarChar(60)
  /// GERENTE | COMPRAS | WHATSAPP | ORCAMENTOS | FINANCEIRO | INSTAGRAM | PERSONALIZADA
  roleKey        String          @map("role_key") @db.VarChar(40)
  roleLabel      String          @map("role_label") @db.VarChar(80)
  instructions   String          @db.VarChar(4000)
  dataScopes     String[]        @default([]) @map("data_scopes")
  /// { acao: 'NUNCA' | 'PROPOR' | 'EXECUTAR_APROVADO' }
  actionPolicies Json            @default("{}") @map("action_policies")
  /// ATIVO | PAUSADO | DESATIVADO
  status         String          @default("ATIVO") @db.VarChar(15)
  color          String          @default("#7c3aed") @db.VarChar(9)
  version        Int             @default(1)
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  desk            GameStation?      @relation(fields: [deskStationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdBy       User?             @relation("AiAgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  messages        AiAgentMessage[]
  proposals       AiAgentProposal[]
  /// Canais que o agente acessa: { canal: 'CONSULTAR' | 'RASCUNHO' | 'EXECUTAR' }.
  channelPolicies Json              @default("{}") @map("channel_policies")
  /// Casos de envio automático liberados pelo gestor (ex.: confirmação de recebimento de fotos).
  autoSendRules   Json              @default("[]") @map("auto_send_rules")
  /// Nível de cada tarefa (2026-11-25): { tarefa: { nivel: 1-4, limiteCents? } }. Vazio = 2 (pede).
  autonomy        Json              @default("{}")
  actions         AgentAction[]

  @@map("ai_agents")
}

