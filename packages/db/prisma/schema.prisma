}

/// Movimentações registradas da peça (imutável; não exige cada pequeno deslocamento).
model ItemLocationEvent {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeItemLocationEvent", fields: [companyId], references: [id])
  serviceOrderItemId String          @map("service_order_item_id") @db.Uuid
  locationId         String          @map("location_id") @db.Uuid
  note               String?         @db.VarChar(300)
  actorId            String?         @map("actor_id") @db.Uuid
  deviceId           String?         @map("device_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  location         ItemLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor            User?            @relation("LocationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([serviceOrderItemId, createdAt])
  @@map("item_location_events")
}

enum DeliveryStatus {
  PROVISORIA
  AGENDADA
  EM_TRANSPORTE
  NO_DESTINO
  CONCLUIDA
  FRUSTRADA
  CANCELADA

  @@map("delivery_status")
}

/// Entrega (EN-00001) combinada pelo gestor; provisória não é confirmada ao cliente.
model Delivery {
  id                   String                     @id @default(uuid()) @db.Uuid
  companyId            Int                        @default(dbgenerated("app_company_id()")) @map("company_id")
  company              CompanySettings            @relation("EmpresaDeDelivery", fields: [companyId], references: [id])
  number               Int                        @default(dbgenerated())
  customerId           String                     @map("customer_id") @db.Uuid
  addressId            String?                    @map("address_id") @db.Uuid
  addressSnapshot      Json                       @map("address_snapshot")
  contactName          String?                    @map("contact_name") @db.VarChar(120)
  contactPhone         String?                    @map("contact_phone") @db.VarChar(30)
  scheduledDate        DateTime                   @map("scheduled_date") @db.Date
  windowStart          String?                    @map("window_start") @db.Char(5)
  windowEnd            String?                    @map("window_end") @db.Char(5)
  /// Correção global: posição no roteiro do dia (null = ainda não ordenada; vai ao fim).
  routeSequence        Int?                       @map("route_sequence")
  /// Simplificação Fase 3: participantes OPERACIONAIS (veem a parada; não são credores).
  tripParticipants     LogisticsTripParticipant[]
  team                 PickupTeam                 @default(EQUIPE_PROPRIA)
  responsibleUserId    String?                    @map("responsible_user_id") @db.Uuid
  requiresInstallation Boolean                    @default(false) @map("requires_installation")
  instructions         String?                    @db.VarChar(1000)
  notes                String?                    @db.VarChar(1000)
  status               DeliveryStatus             @default(PROVISORIA)
  attempts             Int                        @default(0)
  departedAt           DateTime?                  @map("departed_at") @db.Timestamptz(3)
  arrivedAt            DateTime?                  @map("arrived_at") @db.Timestamptz(3)
  installedAt          DateTime?                  @map("installed_at") @db.Timestamptz(3)
  installationNote     String?                    @map("installation_note") @db.VarChar(1000)
  completedAt          DateTime?                  @map("completed_at") @db.Timestamptz(3)
  completionNote       String?                    @map("completion_note") @db.VarChar(1000)
  cancelReason         String?                    @map("cancel_reason") @db.VarChar(500)
  /// Reformulação, Fase 1: LOGISTICA (roteiro/viagem) ou DIRETA (confirmada pela OS, sem viagem).
  origin               String                     @default("LOGISTICA") @db.VarChar(20)
  version              Int                        @default(1)
  createdById          String?                    @map("created_by_id") @db.Uuid
  /// Reformulação Fase 3 (D5): entrega direta desfeita (continua registrada, marcada).
  revertedAt           DateTime?                  @map("reverted_at") @db.Timestamptz(3)
  revertedById         String?                    @map("reverted_by_id") @db.Uuid
  revertReason         String?                    @map("revert_reason") @db.VarChar(500)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address     CustomerAddress?      @relation(fields: [addressId], references: [id], onDelete: Restrict)
  responsible User?                 @relation("DeliveryResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdBy   User?                 @relation("DeliveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revertedBy  User?                 @relation("DeliveryRevertedBy", fields: [revertedById], references: [id], onDelete: SetNull)
  items       DeliveryItem[]
  events      DeliveryEvent[]
  occurrences LogisticsOccurrence[]

  // Fase 11: financeiro operacional.
  logisticsCosts LogisticsCost[]
  paymentReports CustomerPaymentReport[]

  @@unique([companyId, number])
  @@index([scheduledDate])
  @@index([status])
  @@index([responsibleUserId, status])
  @@index([customerId])
  @@map("deliveries")
}

model DeliveryItem {
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeDeliveryItem", fields: [companyId], references: [id])
  deliveryId         String          @map("delivery_id") @db.Uuid
  serviceOrderItemId String          @map("service_order_item_id") @db.Uuid
  /// Uma peça só fica em uma entrega ativa (índice único parcial).
  active             Boolean         @default(true)
  /// PENDENTE, ENTREGUE, DIVERGENTE ou NAO_ENTREGUE.
  status             String          @default("PENDENTE") @db.VarChar(20)
  note               String?         @db.VarChar(500)
  deliveredAt        DateTime?       @map("delivered_at") @db.Timestamptz(3)

  delivery         Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)

  @@id([deliveryId, serviceOrderItemId])
  @@index([serviceOrderItemId])
  @@map("delivery_items")
}

/// Histórico imutável da entrega (agendamento, saída, chegada, entrega, instalação, tentativa).
model DeliveryEvent {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company    CompanySettings @relation("EmpresaDeDeliveryEvent", fields: [companyId], references: [id])
  deliveryId String          @map("delivery_id") @db.Uuid
  kind       String          @db.VarChar(40)
  fromStatus String?         @map("from_status") @db.VarChar(20)
  toStatus   String?         @map("to_status") @db.VarChar(20)
  note       String?         @db.VarChar(1000)
  data       Json?
  actorId    String?         @map("actor_id") @db.Uuid
  deviceId   String?         @map("device_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  actor    User?    @relation("DeliveryEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

/// Ocorrência logística (OL-00001): cliente indisponível, peça danificada, endereço incorreto...
model LogisticsOccurrence {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeLogisticsOccurrence", fields: [companyId], references: [id])
  number             Int             @default(dbgenerated())
  kind               String          @db.VarChar(30)
  deliveryId         String?         @map("delivery_id") @db.Uuid
  pickupId           String?         @map("pickup_id") @db.Uuid
  serviceOrderItemId String?         @map("service_order_item_id") @db.Uuid
  description        String          @db.VarChar(1000)
  /// Impede a expedição da peça até resolver (peça danificada, divergência).
  blocksShipping     Boolean         @default(false) @map("blocks_shipping")
  status             String          @default("ABERTA") @db.VarChar(20)
  responsibleUserId  String?         @map("responsible_user_id") @db.Uuid
  reportedById       String?         @map("reported_by_id") @db.Uuid
  deviceId           String?         @map("device_id") @db.Uuid
  resolution         String?         @db.VarChar(1000)
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz(3)
  resolvedById       String?         @map("resolved_by_id") @db.Uuid
  cancelReason       String?         @map("cancel_reason") @db.VarChar(500)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  delivery    Delivery?                  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  pickup      PickupRequest?             @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  item        ServiceOrderItem?          @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  responsible User?                      @relation("LogisticsResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  reportedBy  User?                      @relation("LogisticsReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  events      LogisticsOccurrenceEvent[]

  @@unique([companyId, number])
  @@index([status, createdAt])
  @@index([deliveryId])
  @@map("logistics_occurrences")
}

model LogisticsOccurrenceEvent {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDeLogisticsOccurrenceEvent", fields: [companyId], references: [id])
  occurrenceId String          @map("occurrence_id") @db.Uuid
  kind         String          @db.VarChar(30)
  fromStatus   String?         @map("from_status") @db.VarChar(20)
  toStatus     String?         @map("to_status") @db.VarChar(20)
  note         String?         @db.VarChar(1000)
  actorId      String?         @map("actor_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  occurrence LogisticsOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  @@index([occurrenceId, createdAt])
  @@map("logistics_occurrence_events")
}

/// Devolução de peças ao cliente (DV-00001): registrada e confirmada; nunca apaga o recebimento.
model PieceReturn {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company           CompanySettings @relation("EmpresaDePieceReturn", fields: [companyId], references: [id])
  number            Int             @default(dbgenerated())
  orderId           String          @map("order_id") @db.Uuid
  status            String          @default("REGISTRADA") @db.VarChar(20)
  reason            String          @db.VarChar(500)
  responsibleUserId String?         @map("responsible_user_id") @db.Uuid
  /// Fase 12: destino das peças (ex.: entregue ao cliente no endereço X, retirada na oficina).
  destination       String?         @db.VarChar(200)
  returnDate        DateTime        @map("return_date") @db.Date
  confirmedAt       DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  confirmedById     String?         @map("confirmed_by_id") @db.Uuid
  confirmationNote  String?         @map("confirmation_note") @db.VarChar(500)
  cancelledAt       DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?         @map("cancel_reason") @db.VarChar(500)
  version           Int             @default(1)
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       CommercialOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  responsible User?             @relation("ReturnResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  lines       PieceReturnLine[]

  @@unique([companyId, number])
  @@index([orderId])
  @@map("piece_returns")
}

model PieceReturnLine {
  companyId           Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company             CompanySettings @relation("EmpresaDePieceReturnLine", fields: [companyId], references: [id])
  returnId            String          @map("return_id") @db.Uuid
  orderItemId         String          @map("order_item_id") @db.Uuid
  quantity            Int
  /// Peças de OS devolvidas inteiras (as demais vêm das não alocadas em OS).
  serviceOrderItemIds String[]        @map("service_order_item_ids") @db.Uuid

  pieceReturn PieceReturn         @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem   CommercialOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@id([returnId, orderItemId])
  @@index([orderItemId])
  @@map("piece_return_lines")
}

/// Correção auditável de recebimento físico (o recebimento original é imutável).
model ReceiptCorrection {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company          CompanySettings @relation("EmpresaDeReceiptCorrection", fields: [companyId], references: [id])
  receiptLineId    String          @map("receipt_line_id") @db.Uuid
  orderItemId      String          @map("order_item_id") @db.Uuid
  previousQuantity Int             @map("previous_quantity")
  newQuantity      Int             @map("new_quantity")
  reason           String          @db.VarChar(500)
  actorId          String?         @map("actor_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  receiptLine ReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)

  @@index([receiptLineId])
  @@map("receipt_corrections")
}

// ─────────────────────────── Financeiro operacional (Fase 11) ───────────────────────────

/// Ajuste comercial autorizado do valor do pedido (desconto, acréscimo, ajuste) — imutável.
model CommercialAdjustment {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company        CompanySettings @relation("EmpresaDeCommercialAdjustment", fields: [companyId], references: [id])
  orderId        String          @map("order_id") @db.Uuid
  /// DESCONTO (negativo), ACRESCIMO (positivo) ou AJUSTE (com sinal).
  kind           String          @db.VarChar(20)
  amountCents    Int             @map("amount_cents")
  reason         String          @db.VarChar(500)
  authorizedById String          @map("authorized_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order        CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  authorizedBy User            @relation("CommercialAdjustmentBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("commercial_adjustments")
}

/// Conta a receber (RC-00001) do cliente, por pedido (e opcionalmente OS).
model CustomerReceivable {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company        CompanySettings @relation("EmpresaDeCustomerReceivable", fields: [companyId], references: [id])
  number         Int             @default(dbgenerated())
  customerId     String          @map("customer_id") @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  serviceOrderId String?         @map("service_order_id") @db.Uuid
  description    String          @db.VarChar(200)
  amountCents    Int             @map("amount_cents")
  receivedCents  Int             @default(0) @map("received_cents")
  /// Obrigatória para o gatilho DATA; RETIRADA/ENTREGA vencem na conclusão real do evento.
  dueDate        DateTime?       @map("due_date") @db.Date
  /// DATA, RETIRADA, ENTREGA.
  dueTrigger     String          @default("DATA") @map("due_trigger") @db.VarChar(10)
  /// Parcelas do cartão (1..12), só para cartão. Uma cobrança, nunca N contas.
  installments   Int?            @db.SmallInt
  /// PIX, DINHEIRO, CARTAO_CREDITO, CARTAO_DEBITO, BOLETO, TRANSFERENCIA, CHEQUE, OUTRO.
  expectedMethod String          @map("expected_method") @db.VarChar(20)
  /// ABERTO, PARCIAL, RECEBIDO, CANCELADO.
  status         String          @default("ABERTO") @db.VarChar(20)
  notes          String?         @db.VarChar(1000)
  cancelReason   String?         @map("cancel_reason") @db.VarChar(500)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  version        Int             @default(1)
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        CommercialOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder?           @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  payments     CustomerPayment[]
  reports      CustomerPaymentReport[]
  /// Escritório do jogo: cobranças no provedor (Pix/boleto/cartão).
  charges      PaymentCharge[]

  @@unique([companyId, number])
  @@index([orderId])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([serviceOrderId])
  @@map("customer_receivables")
}

/// Recebimento (parcial ou total) de uma conta a receber — imutável; estorno por lançamento.
model CustomerPayment {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDeCustomerPayment", fields: [companyId], references: [id])
  receivableId String          @map("receivable_id") @db.Uuid
  amountCents  Int             @map("amount_cents")
  receivedAt   DateTime        @map("received_at") @db.Date
  method       String          @db.VarChar(20)
  note         String?         @db.VarChar(500)
  /// Estorno de outro recebimento (valor negativo).
  reversalOfId String?         @unique @map("reversal_of_id") @db.Uuid
  /// Parcelas do cartão (1..12), só para cartão.
  installments Int?            @db.SmallInt
  /// Reembolso: dinheiro que entrou e saiu (valor negativo, sem estorno vinculado).
  refund       Boolean         @default(false)
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  receivable CustomerReceivable     @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  report     CustomerPaymentReport?

  @@index([receivableId])
  @@index([receivedAt])
  @@map("customer_payments")
}

/// Pagamento informado pela equipe numa retirada/entrega — registro operacional; só o escritório
/// confirma (cria o recebimento real) ou descarta. Nunca apagado.
model CustomerPaymentReport {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDeCustomerPaymentReport", fields: [companyId], references: [id])
  receivableId String          @map("receivable_id") @db.Uuid
  pickupId     String?         @map("pickup_id") @db.Uuid
  deliveryId   String?         @map("delivery_id") @db.Uuid
  collected    Boolean
  method       String?         @db.VarChar(20)
  note         String?         @db.VarChar(500)
  reportedById String          @map("reported_by_id") @db.Uuid
  reportedAt   DateTime        @default(now()) @map("reported_at") @db.Timestamptz(3)
  /// PENDENTE, CONFIRMADO, DESCARTADO.
  status       String          @default("PENDENTE") @db.VarChar(12)
  paymentId    String?         @unique @map("payment_id") @db.Uuid
  decidedById  String?         @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?       @map("decided_at") @db.Timestamptz(3)
  decisionNote String?         @map("decision_note") @db.VarChar(500)
  version      Int             @default(1)

  receivable CustomerReceivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  pickup     PickupRequest?     @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  delivery   Delivery?          @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  payment    CustomerPayment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reportedBy User               @relation("PaymentReportBy", fields: [reportedById], references: [id], onDelete: Restrict)
  decidedBy  User?              @relation("PaymentReportDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([receivableId])
  @@index([status])
  @@map("customer_payment_reports")
}

/// Custo de material por OS (razão imutável derivada de compras, saídas de estoque e sobras;
/// a chave de origem impede duplicar o mesmo fato).
model ServiceOrderCost {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeServiceOrderCost", fields: [companyId], references: [id])
  serviceOrderId     String          @map("service_order_id") @db.Uuid
  serviceOrderItemId String?         @map("service_order_item_id") @db.Uuid
  /// MATERIAL, OUTRO_VARIAVEL.
  category           String          @db.VarChar(20)
  /// COMPRA_EXCLUSIVA, ESTORNO_COMPRA, SAIDA_ESTOQUE, DEVOLUCAO_ESTOQUE, SOBRA_SAIDA, SOBRA_ENTRADA, AJUSTE_MANUAL.
  source             String          @db.VarChar(30)
  sourceKey          String          @unique @map("source_key") @db.VarChar(120)
  description        String          @db.VarChar(200)
  quantity           Decimal?        @db.Decimal(12, 3)
  unitCostCents      Int?            @map("unit_cost_cents")
  amountCents        Int             @map("amount_cents")
  /// Sem preço conhecido: valor 0 até o gestor ajustar (sinalizado).
  priced             Boolean         @default(true)
  occurredAt         DateTime        @map("occurred_at") @db.Timestamptz(3)
  note               String?         @db.VarChar(500)
  actorId            String?         @map("actor_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceOrder    ServiceOrder           @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  /// Reformulação, Fase 1: materiais da OS conciliados com este lançamento formal.
  osMaterialLinks ServiceOrderMaterial[] @relation("OsMaterialLinkedCost")

  @@index([serviceOrderId, occurredAt])
  @@map("service_order_costs")
}

/// Mão de obra por produção (MO-00001): valor combinado com o tapeceiro principal por OS/peça.
model ProductionPayable {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeProductionPayable", fields: [companyId], references: [id])
  number             Int             @default(dbgenerated())
  professionalUserId String          @map("professional_user_id") @db.Uuid
  serviceOrderId     String          @map("service_order_id") @db.Uuid
  serviceOrderItemId String?         @map("service_order_item_id") @db.Uuid
  service            String          @db.VarChar(200)
  agreedCents        Int             @map("agreed_cents")
  adjustmentsCents   Int             @default(0) @map("adjustments_cents")
  paidCents          Int             @default(0) @map("paid_cents")
  /// PRODUCAO_CONCLUIDA, QUALIDADE_APROVADA, ENTREGA_CONCLUIDA.
  eligibility        String          @default("QUALIDADE_APROVADA") @db.VarChar(30)
  /// PREVISTO, LIBERADO, PAGO_PARCIAL, PAGO, CANCELADO.
  status             String          @default("PREVISTO") @db.VarChar(20)
  eligibleAt         DateTime?       @map("eligible_at") @db.Timestamptz(3)
  notes              String?         @db.VarChar(500)
  cancelReason       String?         @map("cancel_reason") @db.VarChar(500)
  version            Int             @default(1)
  createdById        String?         @map("created_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional        User                  @relation("ProductionPayableProfessional", fields: [professionalUserId], references: [id], onDelete: Restrict)
  serviceOrder        ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  item                ServiceOrderItem?     @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  adjustments         FinancialAdjustment[]
  /// R2: solicitações de alteração de valor do próprio profissional.
  valueChangeRequests ValueChangeRequest[]
  payments            ProfessionalPayment[]

  /// Evolução Fase 5: criada na resolução de uma revisão financeira (divisão entre titulares).
  reviewId String?      @map("review_id") @db.Uuid
  review   LaborReview? @relation("LaborReviewPayables", fields: [reviewId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([professionalUserId, status])
  @@index([serviceOrderId])
  @@map("production_payables")
}

/// Ajuste autorizado (mão de obra ou custo) — imutável, com motivo e autor.
model FinancialAdjustment {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company             CompanySettings @relation("EmpresaDeFinancialAdjustment", fields: [companyId], references: [id])
  productionPayableId String?         @map("production_payable_id") @db.Uuid
  amountCents         Int             @map("amount_cents")
  reason              String          @db.VarChar(500)
  authorizedById      String          @map("authorized_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  payable      ProductionPayable? @relation(fields: [productionPayableId], references: [id], onDelete: Restrict)
  authorizedBy User               @relation("FinancialAdjustmentBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([productionPayableId])
  @@map("financial_adjustments")
}

/// Pagamento ao profissional por produção — imutável (registro; nenhuma transferência é feita).
model ProfessionalPayment {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company             CompanySettings @relation("EmpresaDeProfessionalPayment", fields: [companyId], references: [id])
  productionPayableId String          @map("production_payable_id") @db.Uuid
  amountCents         Int             @map("amount_cents")
  paidAt              DateTime        @map("paid_at") @db.Date
  method              String          @db.VarChar(20)
  note                String?         @db.VarChar(500)
  /// Pagamento antes da elegibilidade: só com autorização explícita (motivo).
  earlyReason         String?         @map("early_reason") @db.VarChar(500)
  createdById         String?         @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  payable     ProductionPayable            @relation(fields: [productionPayableId], references: [id], onDelete: Restrict)
  /// Evolução Fase 7: estorno (o pagamento original permanece).
  reversal    ProfessionalPaymentReversal?
  closingPart ClosingPaymentPart?

  @@index([productionPayableId])
  @@index([paidAt])
  @@map("professional_payments")
}

/// Custo mensal de equipe de remuneração fixa (João, Thiago) — não é pagamento por produção.
model TeamMonthlyCost {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeTeamMonthlyCost", fields: [companyId], references: [id])
  userId      String          @map("user_id") @db.Uuid
  month       DateTime        @db.Date
  amountCents Int             @map("amount_cents")
  notes       String?         @db.VarChar(500)
  version     Int             @default(1)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation("TeamMonthlyCostUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, month])
  @@map("team_monthly_costs")
}

/// Custo de logística (LG-00001): uma viagem pode atender várias OS (rateio documentado).
model LogisticsCost {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDeLogisticsCost", fields: [companyId], references: [id])
  number       Int             @default(dbgenerated())
  /// RETIRADA, ENTREGA, INSTALACAO, TRANSPORTE_TERCEIRIZADO, DESLOCAMENTO.
  kind         String          @db.VarChar(30)
  description  String          @db.VarChar(200)
  amountCents  Int             @map("amount_cents")
  date         DateTime        @db.Date
  deliveryId   String?         @map("delivery_id") @db.Uuid
  pickupId     String?         @map("pickup_id") @db.Uuid
  beneficiary  String?         @db.VarChar(160)
  /// IGUAL, POR_PECA, MANUAL.
  splitMethod  String          @map("split_method") @db.VarChar(20)
  splitNote    String?         @map("split_note") @db.VarChar(500)
  payableId    String?         @unique @map("payable_id") @db.Uuid
  cancelledAt  DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?         @map("cancel_reason") @db.VarChar(500)
  version      Int             @default(1)
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  delivery    Delivery?                 @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  pickup      PickupRequest?            @relation(fields: [pickupId], references: [id], onDelete: Restrict)
  payable     AccountPayable?           @relation(fields: [payableId], references: [id], onDelete: Restrict)
  allocations LogisticsCostAllocation[]

  // Evolução Fase 6: custo da viagem ligado ao agendamento.
  /// LANCADO (avulso/legado), PREVISTO (agendado), DEVIDO (realizado/taxa autorizada), CANCELADO,
  /// OPERACIONAL (Rodada 3: custo da equipe própria — custeio, sem recebedor nem obrigação).
  status              String                     @default("LANCADO") @db.VarChar(20)
  /// Recebedor vinculado (novos lançamentos). O texto `beneficiary` legado é preservado.
  payeeUserId         String?                    @map("payee_user_id") @db.Uuid
  payee               User?                      @relation("LogisticsCostPayee", fields: [payeeUserId], references: [id], onDelete: Restrict)
  adjustmentsCents    Int                        @default(0) @map("adjustments_cents")
  /// Fato gerador do valor devido (realização ou taxa autorizada).
  dueAt               DateTime?                  @map("due_at") @db.Timestamptz(3)
  /// Motivo de não ter gerado a obrigação (ex.: RECEBEDOR_AUSENTE).
  pendingReason       String?                    @map("pending_reason") @db.VarChar(40)
  /// MANUAL (legado), AUTO (OS da viagem) ou ESCOLHIDA (OS escolhidas pelo gestor).
  allocationMode      String                     @default("MANUAL") @map("allocation_mode") @db.VarChar(20)
  /// Rateio vigente (rateios são imutáveis; um novo rateio é uma nova revisão).
  allocationRevision  Int                        @default(1) @map("allocation_revision")
  participants        LogisticsCostParticipant[]
  adjustments         LogisticsCostAdjustment[]
  /// R2: solicitações de alteração de valor do recebedor.
  valueChangeRequests ValueChangeRequest[]

  @@unique([companyId, number])
  @@index([date])
  @@index([payeeUserId, dueAt])
  @@map("logistics_costs")
}

model LogisticsCostAllocation {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeLogisticsCostAllocation", fields: [companyId], references: [id])
  logisticsCostId    String          @map("logistics_cost_id") @db.Uuid
  serviceOrderId     String          @map("service_order_id") @db.Uuid
  serviceOrderItemId String?         @map("service_order_item_id") @db.Uuid
  amountCents        Int             @map("amount_cents")
  /// Evolução Fase 6: revisão do rateio (vale a de `logistics_costs.allocation_revision`).
  revision           Int             @default(1)

  cost         LogisticsCost @relation(fields: [logisticsCostId], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)

  @@unique([logisticsCostId, revision, serviceOrderId])
  @@index([serviceOrderId])
  @@map("logistics_cost_allocations")
}

/// Evolução Fase 6: quem executou a viagem (não é credor — o recebedor é `payee`).
model LogisticsCostParticipant {
  companyId       Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company         CompanySettings @relation("EmpresaDeLogisticsCostParticipant", fields: [companyId], references: [id])
  logisticsCostId String          @map("logistics_cost_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  cost LogisticsCost @relation(fields: [logisticsCostId], references: [id], onDelete: Restrict)
  user User          @relation("LogisticsCostParticipantUser", fields: [userId], references: [id], onDelete: Restrict)

  @@id([logisticsCostId, userId])
  @@map("logistics_cost_participants")
}

/// Evolução Fase 6: ajuste auditável do valor devido da viagem (imutável).
model LogisticsCostAdjustment {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company         CompanySettings @relation("EmpresaDeLogisticsCostAdjustment", fields: [companyId], references: [id])
  logisticsCostId String          @map("logistics_cost_id") @db.Uuid
  amountCents     Int             @map("amount_cents")
  reason          String          @db.VarChar(500)
  authorizedById  String          @map("authorized_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

