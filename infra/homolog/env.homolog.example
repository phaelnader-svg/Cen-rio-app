# Variáveis da homologação — MODELO, sem segredos. NÃO versionar o arquivo preenchido.
# Na VM do Google Cloud este arquivo NÃO é usado: infra/homolog/gcp/vm.sh gera /run/cenario/env
# a partir do Secret Manager. Este modelo serve para a verificação local da pilha.
# Use aspas simples nos valores (o Docker Compose não interpreta "$" dentro delas).

# Domínio de TESTE (local: localhost, com certificado interno do Caddy).
HOMOLOG_DOMAIN='teste.cenariogestao.com.br'
# Senha do PostgreSQL (openssl rand -hex 24)
POSTGRES_PASSWORD=''
# Segredo dos tokens, mínimo 32 caracteres (openssl rand -base64 48). Exclusivo deste ambiente.
TOKEN_HASH_SECRET=''
# Gestor de teste criado pelo seed (e-mail de teste; trocar a senha no primeiro acesso).
SEED_ADMIN_EMAIL='gestor@teste.cenariogestao.com.br'
SEED_ADMIN_PASSWORD=''
SEED_ADMIN_NAME='Gestor Homologação'
# Autenticação adicional no proxy: usuário, hash bcrypt da senha
# (docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<senha>')
# e o token do cookie de acesso (openssl rand -hex 32).
HOMOLOG_BASIC_USER='homologacao'
HOMOLOG_BASIC_HASH=''
HOMOLOG_GATE_TOKEN=''
# Imagens (local: as construídas pelo compose; na VM: Artifact Registry com a etiqueta do commit).
CENARIO_API_IMAGE='cenario-homolog-api'
CENARIO_WEB_IMAGE='cenario-homolog-web'
