// ─────────────────────────── Orçamentos ───────────────────────────

/// Base de dados do orçamento (independente de compras e estoque): materiais com preço (Tecidos,
/// Espumas, Insumos, Madeiramento), cidades da logística, serviços do tapeceiro e do ajudante,
/// taxas da máquina e tapeceiros responsáveis. Os orçamentos salvos guardam cópia dos valores,
/// então alterar ou excluir um cadastro não muda proposta já salva.
model QuoteCatalogItem {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDeQuoteCatalogItem", fields: [companyId], references: [id])
  /// MATERIAL | LOGISTICA | MAO_TAPECEIRO | MAO_AJUDANTE | TAXA_MAQUINA | TAPECEIRO
  kind         String          @db.VarChar(20)
  category     String?         @db.VarChar(20)
  name         String          @db.VarChar(160)
  priceCents   Int?            @map("price_cents")
  unit         String?         @db.VarChar(20)
  km           Decimal?        @db.Decimal(10, 2)
  /// Taxa da máquina em pontos-base (250 = 2,5%).
  rateBps      Int?            @map("rate_bps")
  phone        String?         @db.VarChar(40)
  /// Serviço do ajudante nascido de um serviço do tapeceiro (mesmo nome, preço próprio).
  linkedItemId String?         @map("linked_item_id") @db.Uuid
  position     Int             @default(0)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  linkedItem QuoteCatalogItem?  @relation("QuoteCatalogLink", fields: [linkedItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linkedFrom QuoteCatalogItem[] @relation("QuoteCatalogLink")

  @@index([kind, position])
  @@map("quote_catalog_items")
}

/// Configuração do orçamento (uma linha; vira uma por empresa no multi-empresa).
model QuoteSettings {
  id                  Int             @id @default(autoincrement())
  companyId           Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company             CompanySettings @relation("EmpresaDeQuoteSettings", fields: [companyId], references: [id])
  /// Alíquota do serviço/imposto em pontos-base (600 = 6%). Vazio = não cadastrada.
  taxRateBps          Int?            @map("tax_rate_bps")
  /// Nome da empresa na proposta. Vazio = nome fantasia da Empresa.
  companyNameOverride String?         @map("company_name_override") @db.VarChar(90)
  /// Logotipo da proposta (PNG/JPEG reduzido, em data URL).
  logoDataUrl         String?         @map("logo_data_url")
  /// Melhoria 141: textos fixos da proposta (vazio = texto padrão do sistema).
  proposalTitle       String?         @map("proposal_title") @db.VarChar(120)
  proposalIntro       String?         @map("proposal_intro") @db.VarChar(400)
  proposalThanks      String?         @map("proposal_thanks") @db.VarChar(600)
  version             Int             @default(1)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Uma configuração de orçamento por empresa.
  @@unique([companyId])
  @@map("quote_settings")
}

/// Orçamento salvo: cópia completa da proposta (nunca recalculada) e a O.S. do orçamento.
model Quote {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company         CompanySettings @relation("EmpresaDeQuote", fields: [companyId], references: [id])
  /// Numeração própria dos orçamentos (começa em 10200).
  number          Int             @default(dbgenerated())
  customerName    String          @map("customer_name") @db.VarChar(160)
  phone           String?         @db.VarChar(20)
  service         String          @db.VarChar(120)
  totalCents      Int             @map("total_cents")
  snapshot        Json
  workOrder       Json?           @map("work_order")
  /// Melhoria 77: ENVIADO | APROVADO | RECUSADO | SEM_RESPOSTA.
  status          String          @default("ENVIADO") @db.VarChar(16)
  statusChangedAt DateTime?       @map("status_changed_at") @db.Timestamptz(3)
  /// Melhoria 77: quando cobrar o cliente (lembrete).
  followUpAt      DateTime?       @map("follow_up_at") @db.Timestamptz(3)
  /// Melhoria 77/81: motivo da recusa (funil de vendas).
  lostReason      String?         @map("lost_reason") @db.VarChar(300)
  /// Melhoria 79: aceite registrado (pelo link do cliente ou pelo painel).
  approvedAt      DateTime?       @map("approved_at") @db.Timestamptz(3)
  approvedVia     String?         @map("approved_via") @db.VarChar(10)
  /// Melhoria 79: primeira vez que o cliente abriu o link.
  linkViewedAt    DateTime?       @map("link_viewed_at") @db.Timestamptz(3)
  /// Melhoria 78: pedido criado a partir deste orçamento.
  orderId         String?         @map("order_id") @db.Uuid
  /// Revisão geral (item 10): dia e turno da retirada escolhidos pelo cliente no link da proposta.
  pickupDate      DateTime?       @map("pickup_date") @db.Date
  pickupShift     String?         @map("pickup_shift") @db.VarChar(10)
  version         Int             @default(1)
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)
  deletedById     String?         @map("deleted_by_id") @db.Uuid

  createdBy User? @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedBy User? @relation("QuoteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([companyId, number])
  @@index([deletedAt, createdAt])
  @@index([status, followUpAt])
  @@map("quotes")
}

/// Multi-empresa: numeração própria de cada empresa (pedido nº 1, OS nº 1… em cada empresa).
/// Preenchida pelo gatilho `assign_company_number` nas tabelas com `number`.
