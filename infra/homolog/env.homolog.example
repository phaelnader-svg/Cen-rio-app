# Homologação do Cenário Gestão — copie para .env.homolog (NÃO versionar) e preencha.
# Domínio de TESTE (ex.: homolog.seu-dominio.com.br), com DNS apontado para a VM.
HOMOLOG_DOMAIN=
# Senha do PostgreSQL de homologação (gere: openssl rand -base64 24)
POSTGRES_PASSWORD=
# Segredo dos tokens (mínimo 32 caracteres; gere: openssl rand -base64 48). Exclusivo deste ambiente.
TOKEN_HASH_SECRET=
# Rede interna do Docker (o Caddy encaminha o IP real do cliente).
TRUST_PROXY=172.16.0.0/12
# Conta do gestor criada pelo seed (só e-mail de teste; troque a senha no primeiro acesso).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
