// Firma Viva — banco próprio do jogo (independente do Cenário Gestão).
// Guarda pessoas, organizações, convites, plantas, personagens, configurações dos agentes,
// metas do Quadro e a autorização da conexão com o Cenário Gestão (tokens selados).
// Registros operacionais (OS, materiais, produção, financeiro) continuam no Cenário Gestão.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("FIRMA_DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Sempre em minúsculas.
  email        String    @unique @db.VarChar(254)
  name         String    @db.VarChar(80)
  passwordHash String?   @map("password_hash") @db.VarChar(200)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  memberships   Membership[]
  resets        PasswordReset[]
  cenarioLogins CenarioLogin[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  /// Organização aberta nesta sessão (sempre conferida contra a associação a cada pedido).
  orgId      String?   @map("org_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  invites     Invite[]
  spaces      Space[]
  connection  CenarioConnection?
  settings    OrgSetting[]
  audit       AuditLog[]

  @@map("organizations")
}

/// Papel na organização: DONO, ADMIN, GESTOR (opera pelo jogo) ou MEMBRO (só acompanha).
model Membership {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  email       String    @db.VarChar(254)
  role        String    @db.VarChar(10)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("invites")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

/// E-mails transacionais (convite, recuperação). Em desenvolvimento ficam aqui para consulta.
model OutboxMail {
  id        String    @id @default(uuid()) @db.Uuid
  to        String    @db.VarChar(254)
  subject   String    @db.VarChar(200)
  body      String
  link      String?   @db.VarChar(1000)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  @@index([to, createdAt])
  @@map("outbox_mails")
}

/// Planta de um ambiente (Tapeçaria, Escritório…) da organização: paredes, áreas, estações,
/// personagens nas estações, armazenagem. `content` segue o formato do jogo (GameSpaceDto).
model Space {
  id        String   @id @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  key       String   @db.VarChar(40)
  name      String   @db.VarChar(80)
  kind      String   @db.VarChar(20)
  position  Int      @default(0)
  content   Json
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  revisions SpaceRevision[]

  @@unique([orgId, key])
  @@map("spaces")
}

model SpaceRevision {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  version   Int
  summary   String   @db.VarChar(1000)
  snapshot  Json
  createdBy String?  @map("created_by") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, version])
  @@map("space_revisions")
}

/// Configurações guardadas pelo jogo por organização: agentes (função, instruções, mesa,
/// políticas) e metas do Quadro. Chave: "agents" | "goals".
model OrgSetting {
  orgId     String   @map("org_id") @db.Uuid
  key       String   @db.VarChar(40)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
  @@map("org_settings")
}

/// Conexão da organização com o Cenário Gestão (uma por organização). Tokens SELADOS
/// (AES-256-GCM com chave do servidor); nunca saem do servidor do Firma Viva.
model CenarioConnection {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @unique @map("org_id") @db.Uuid
  /// CONECTADA | EXPIRADA | REVOGADA | DESCONECTADA
  status           String    @db.VarChar(15)
  /// Identidade da empresa no Cenário (endereço + documento/nome): uma organização por empresa.
  companyKey       String    @map("company_key") @db.VarChar(300)
  companyName      String    @map("company_name") @db.VarChar(160)
  companyDocument  String?   @map("company_document") @db.VarChar(20)
  cenarioUserName  String?   @map("cenario_user_name") @db.VarChar(120)
  cenarioUserEmail String?   @map("cenario_user_email") @db.VarChar(254)
  scopes           String[]
  permissions      String[]
  grantId          String?   @map("grant_id") @db.VarChar(64)
  accessEnc        String?   @map("access_enc")
  refreshEnc       String?   @map("refresh_enc")
  accessExpiresAt  DateTime? @map("access_expires_at") @db.Timestamptz(3)
  connectedById    String?   @map("connected_by_id") @db.Uuid
  connectedAt      DateTime? @map("connected_at") @db.Timestamptz(3)
  lastSyncAt       DateTime? @map("last_sync_at") @db.Timestamptz(3)
  lastError        String?   @map("last_error") @db.VarChar(300)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([companyKey, status])
  @@map("cenario_connections")
}

/// Estado temporário do fluxo de autorização (state + verificador PKCE selado).
/// CONEXAO: conectar a organização (pessoa e organização conhecidas).
/// ENTRAR: entrar no jogo com a conta do Cenário (sem sessão ainda; preso ao navegador).
model OAuthState {
  id          String    @id @default(uuid()) @db.Uuid
  stateHash   String    @unique @map("state_hash") @db.Char(64)
  purpose     String    @default("CONEXAO") @db.VarChar(10)
  orgId       String?   @map("org_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  /// ENTRAR: hash do cookie do navegador que começou o pedido (impede entrada forçada).
  browserHash String?   @map("browser_hash") @db.Char(64)
  verifierEnc String    @map("verifier_enc")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("oauth_states")
}

/// Pessoa do Cenário Gestão ligada a uma conta do Firma Viva (entrada direta pelo botão
/// "Acessar ambiente interativo"). Uma pessoa do Cenário por empresa → uma conta.
model CenarioLogin {
  id            String   @id @default(uuid()) @db.Uuid
  companyKey    String   @map("company_key") @db.VarChar(300)
  cenarioUserId String   @map("cenario_user_id") @db.VarChar(64)
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt   DateTime @default(now()) @map("last_login_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyKey, cenarioUserId])
  @@index([userId])
  @@map("cenario_logins")
}

/// Quem fez o quê, em qual organização e em qual empresa conectada.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(60)
  summary   String   @db.VarChar(400)
  company   String?  @db.VarChar(160)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
