/// Chegada FÍSICA de material medido em metros (ex.: rolos de tecido): registra o que chegou
/// (quantidade e unidade física) sem inventar metragem. Não movimenta estoque; a conferência
/// técnica posterior (recebimento com a medida real) libera o material.
model MaterialArrival {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company           CompanySettings @relation("EmpresaDeMaterialArrival", fields: [companyId], references: [id])
  number            Int             @default(dbgenerated())
  purchaseOrderId   String          @map("purchase_order_id") @db.Uuid
  /// [{ purchaseOrderItemId, description, unit, physicalCount, physicalUnit }]
  lines             Json
  status            String          @default("PENDENTE_CONFERENCIA") @db.VarChar(30)
  problemKind       String?         @map("problem_kind") @db.VarChar(30)
  problemNote       String?         @map("problem_note") @db.VarChar(500)
  receivedById      String          @map("received_by_id") @db.Uuid
  deviceId          String?         @map("device_id") @db.Uuid
  receivedAt        DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Recebimento (com a medida conferida) que encerrou esta chegada.
  materialReceiptId String?         @unique @map("material_receipt_id") @db.Uuid
  conferredById     String?         @map("conferred_by_id") @db.Uuid
  conferredAt       DateTime?       @map("conferred_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy    User          @relation("MaterialArrivalBy", fields: [receivedById], references: [id], onDelete: Restrict)
  conferredBy   User?         @relation("MaterialArrivalConferredBy", fields: [conferredById], references: [id], onDelete: SetNull)

