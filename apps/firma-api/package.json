{
  "name": "@firma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "criar-organizacao": "tsx --env-file-if-exists=../../.env src/cli/criar-organizacao.ts"
  },
  "dependencies": {
    "@cenario/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@firma/db": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.5",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "4.1.11"
  }
}
