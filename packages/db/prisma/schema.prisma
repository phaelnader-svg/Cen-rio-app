/// Evolução Fase 3: definição e substituição do titular da peça (imutável).
model ServiceOrderItemOwnerChange {
  id                      String          @id @default(uuid()) @db.Uuid
  companyId               Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company                 CompanySettings @relation("EmpresaDeServiceOrderItemOwnerChange", fields: [companyId], references: [id])
  serviceOrderItemId      String          @map("service_order_item_id") @db.Uuid
  /// DEFINICAO (primeiro titular) ou SUBSTITUICAO (troca autorizada).
  kind                    String          @db.VarChar(20)
  fromUserId              String?         @map("from_user_id") @db.Uuid
  toUserId                String          @map("to_user_id") @db.Uuid
  reason                  String?         @db.VarChar(500)
  /// Tarefas pendentes que passaram ao novo titular (concluídas nunca mudam).
  movedTaskIds            String[]        @map("moved_task_ids") @db.Uuid
  /// Há mão de obra combinada com outra pessoa: revisão financeira manual (Fase 5).
  financialReviewRequired Boolean         @default(false) @map("financial_review_required")
  createdById             String?         @map("created_by_id") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  item        ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  laborReview LaborReview?
  fromUser    User?            @relation("OwnerChangeFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser      User             @relation("OwnerChangeTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy   User?            @relation("OwnerChangeBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([serviceOrderItemId, createdAt])
  @@map("service_order_item_owner_changes")
}

/// Evolução Fase 5: revisão financeira da mão de obra (troca de titular com valor combinado).
/// Enquanto ABERTA, bloqueia liberação e pagamento da mão de obra no escopo (peça ou OS).
model LaborReview {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeLaborReview", fields: [companyId], references: [id])
  number             Int             @default(dbgenerated())
  serviceOrderId     String          @map("service_order_id") @db.Uuid
  /// Escopo: a peça (mão de obra por peça) ou nulo (mão de obra da OS inteira).
  serviceOrderItemId String?         @map("service_order_item_id") @db.Uuid
  ownerChangeId      String?         @unique @map("owner_change_id") @db.Uuid
  /// ABERTA ou RESOLVIDA.
  status             String          @default("ABERTA") @db.VarChar(20)
  reason             String          @db.VarChar(500)
  /// Resolução: [{professionalUserId, beforeCents, afterCents, paidCents, payableId}].
  resolution         Json?
  resolutionNote     String?         @map("resolution_note") @db.VarChar(500)
  openedById         String?         @map("opened_by_id") @db.Uuid
  resolvedById       String?         @map("resolved_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz(3)
  version            Int             @default(1)

  serviceOrder ServiceOrder                 @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  item         ServiceOrderItem?            @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  ownerChange  ServiceOrderItemOwnerChange? @relation(fields: [ownerChangeId], references: [id], onDelete: Restrict)
  openedBy     User?                        @relation("LaborReviewOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  resolvedBy   User?                        @relation("LaborReviewResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  payables     ProductionPayable[]          @relation("LaborReviewPayables")

  @@unique([companyId, number])
  @@index([status, createdAt])
  @@index([serviceOrderId])
  @@map("labor_reviews")
}

// ─────────────── Simplificação Fase 3: recebimentos compartilhados ───────────────

/// Participante operacional de uma retirada OU entrega: vê a parada no próprio roteiro.
/// Não é credor (o recebedor financeiro é o configurado na Fase 6) e não gera pagamento.
model LogisticsTripParticipant {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeLogisticsTripParticipant", fields: [companyId], references: [id])
  pickupId    String?         @map("pickup_id") @db.Uuid
  deliveryId  String?         @map("delivery_id") @db.Uuid
