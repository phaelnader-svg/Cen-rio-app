// Cenário Gestão — esquema do banco de dados (Fase 1: fundação).
//
// Convenções:
// - Tabelas e colunas em snake_case no banco; modelos em PascalCase no código.
// - Identificadores UUID.
// - Entidades editáveis têm coluna `version` para controle otimista de concorrência.
// - Toda alteração relevante gera registro de auditoria e evento de domínio na
//   mesma transação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Identidade ───────────────────────────────

/// Identidade de acesso. Credenciais ficam aqui; dados da pessoa ficam em Employee.
model User {
  id                   String          @id @default(uuid()) @db.Uuid
  companyId            Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company              CompanySettings @relation("EmpresaDeUser", fields: [companyId], references: [id])
  /// E-mail de acesso ao painel (opcional). Sempre armazenado em minúsculas.
  email                String?         @unique @db.VarChar(254)
  passwordHash         String?         @map("password_hash")
  /// PIN de 6 dígitos para os tablets (hash argon2id).
  pinHash              String?         @map("pin_hash")
  displayName          String          @map("display_name") @db.VarChar(60)
  active               Boolean         @default(true)
  lastLoginAt          DateTime?       @map("last_login_at") @db.Timestamptz(3)
  credentialsChangedAt DateTime?       @map("credentials_changed_at") @db.Timestamptz(3)
  /// Confirmação do e-mail pelo link enviado (Criar conta) ou por uma redefinição de senha.
  emailConfirmedAt     DateTime?       @map("email_confirmed_at") @db.Timestamptz(3)
  /// Melhoria 98: segredo da verificação em duas etapas (cifrado com a chave do servidor).
  totpSecret           String?         @map("totp_secret") @db.VarChar(200)
  /// Melhoria 98: verificação em duas etapas ligada desde.
  totpEnabledAt        DateTime?       @map("totp_enabled_at") @db.Timestamptz(3)
  /// Melhoria 98: códigos de recuperação (hash; cada um vale uma vez).
  totpRecoveryHashes   String[]        @default([]) @map("totp_recovery_hashes")
  /// Melhoria 114: usuário temporário do suporte do Cenário (criado quando a empresa libera).
  supportAgent         Boolean         @default(false) @map("support_agent")
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee             Employee?
  emailTokens          EmailToken[]
  /// Simplificação Fase 5: etapas de modelo em que é o responsável padrão.
  templateStepDefaults ProductionTemplateStep[] @relation("TemplateStepDefaultAssignee")
  roles                UserRole[]
  permissions          UserPermission[]
  sessions             Session[]                @relation("SessionUser")
  revokedSessions      Session[]                @relation("SessionRevokedBy")
  oauthCodes           OAuthCode[]              @relation("OAuthCodeUser")
  oauthGrants          OAuthGrant[]             @relation("OAuthGrantUser")
  oauthGrantsRevoked   OAuthGrant[]             @relation("OAuthGrantRevokedBy")
  auditLogs            AuditLog[]
  idempotencyKeys      IdempotencyKey[]
  uploadedFiles        StoredFile[]
  createdDevices       Device[]                 @relation("DeviceCreatedBy")
  revokedDevices       Device[]                 @relation("DeviceRevokedBy")

  createdCustomers               Customer[]             @relation("CustomerCreatedBy")
  createdOrders                  CommercialOrder[]      @relation("OrderCreatedBy")
  cancelledOrders                CommercialOrder[]      @relation("OrderCancelledBy")
  createdPickups                 PickupRequest[]        @relation("PickupCreatedBy")
  pickupEvents                   PickupEvent[]
  registeredReceipts             Receipt[]              @relation("ReceiptRegisteredBy")
  createdServiceOrders           ServiceOrder[]         @relation("ServiceOrderCreatedBy")
  cancelledServiceOrders         ServiceOrder[]         @relation("ServiceOrderCancelledBy")
  materialPurchasedServiceOrders ServiceOrder[]         @relation("ServiceOrderMaterialPurchasedBy")
  measuredItems                  ServiceOrderItem[]     @relation("ItemMeasuredBy")
  serviceOrderRevisions          ServiceOrderRevision[]
  attachments                    Attachment[]

  assignedMeasurements  Measurement[]         @relation("MeasurementAssignee")
  requestedMeasurements Measurement[]         @relation("MeasurementRequestedBy")
  measurementRevisions  MeasurementRevision[]
  reviewedRequests      MaterialRequest[]     @relation("MaterialRequestReviewedBy")

  stockMovements              StockMovement[]            @relation("StockMovementActor")
  createdReservations         StockReservation[]         @relation("ReservationCreatedBy")
  closedReservations          StockReservation[]         @relation("ReservationClosedBy")
  closedRequirements          MaterialRequirement[]      @relation("RequirementClosedBy")
  createdPurchaseOrders       PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  confirmedPurchaseOrders     PurchaseOrder[]            @relation("PurchaseOrderConfirmedBy")
  cancelledPurchaseOrders     PurchaseOrder[]            @relation("PurchaseOrderCancelledBy")
  balanceClosedPurchaseOrders PurchaseOrder[]            @relation("PurchaseOrderBalanceClosedBy")
  purchaseOrderHistory        PurchaseOrderHistory[]     @relation("PurchaseOrderHistoryActor")
  materialReceipts            MaterialReceipt[]          @relation("MaterialReceiptReceivedBy")
  receiptReversals            MaterialReceiptReversal[]  @relation("ReceiptReversalAuthorizedBy")
  createdLeftovers            MaterialLeftover[]         @relation("LeftoverCreatedBy")
  authorizedLeftoverMoves     MaterialLeftoverTransfer[] @relation("LeftoverTransferAuthorizedBy")

  createdPlans              ProductionPlan[]              @relation("PlanCreatedBy")
  publishedPlans            ProductionPlan[]              @relation("PlanPublishedBy")
  principalPlanItems        ProductionPlanItem[]          @relation("PlanItemPrincipal")
  planItemsPlanned          ProductionPlanItem[]          @relation("PlanItemPlannedBy")
  upholsteredItems          ServiceOrderItem[]            @relation("ItemUpholsterer")
  itemOwnerChangesFrom      ServiceOrderItemOwnerChange[] @relation("OwnerChangeFrom")
  itemOwnerChangesTo        ServiceOrderItemOwnerChange[] @relation("OwnerChangeTo")
  itemOwnerChangesBy        ServiceOrderItemOwnerChange[] @relation("OwnerChangeBy")
  planRevisions             ProductionPlanRevision[]      @relation("PlanRevisionCreatedBy")
  assignedTasks             ProductionTask[]              @relation("TaskAssignee")
  completedTasks            ProductionTask[]              @relation("TaskCompletedBy")
  taskEvents                ProductionTaskEvent[]         @relation("TaskEventActor")
  notifications             Notification[]                @relation("UserNotifications")
  attendanceArrivals        OperationalAttendance[]       @relation("AttendanceArrivalBy")
  attendanceDepartures      OperationalAttendance[]       @relation("AttendanceDepartureBy")
  attendanceCorrections     AttendanceCorrection[]        @relation("AttendanceCorrectionActor")
  attendanceImpacts         AttendanceImpact[]            @relation("AttendanceImpactAffected")
  attendanceImpactsResolved AttendanceImpact[]            @relation("AttendanceImpactResolvedBy")
  skillsGranted             EmployeeSkill[]               @relation("SkillGrantedBy")
  helpRequested             HelpRequest[]                 @relation("HelpRequester")
  helpGiven                 HelpRequest[]                 @relation("HelpHelper")
  helpEvents                HelpRequestEvent[]            @relation("HelpEventActor")
  proposalsDecided          RescheduleProposal[]          @relation("ProposalDecidedBy")
  planningActions           PlanningAction[]              @relation("PlanningActionActor")
  issuesReported            ProductionIssue[]             @relation("IssueReporter")
  issuesAssigned            ProductionIssue[]             @relation("IssueAssignee")
  issuesResolved            ProductionIssue[]             @relation("IssueResolvedBy")
  issuesCancelled           ProductionIssue[]             @relation("IssueCancelledBy")
  issueEvents               ProductionIssueEvent[]        @relation("IssueEventActor")
  inspectionsAssigned       QualityInspection[]           @relation("InspectionInspector")
  inspectionsDecided        QualityInspection[]           @relation("InspectionDecidedBy")
  qualityEvents             QualityEvent[]                @relation("QualityEventActor")
  packagingAssigned         PackagingRecord[]             @relation("PackagingAssignee")
  locationEvents            ItemLocationEvent[]           @relation("LocationEventActor")
  deliveriesResponsible     Delivery[]                    @relation("DeliveryResponsible")
  deliveriesCreated         Delivery[]                    @relation("DeliveryCreatedBy")
  deliveryEvents            DeliveryEvent[]               @relation("DeliveryEventActor")
  pickupsLogistics          PickupRequest[]               @relation("PickupLogisticsUser")
  logisticsResponsible      LogisticsOccurrence[]         @relation("LogisticsResponsible")
  logisticsReported         LogisticsOccurrence[]         @relation("LogisticsReportedBy")
  returnsResponsible        PieceReturn[]                 @relation("ReturnResponsible")

  // Fase 11: financeiro operacional.
  commercialAdjustments CommercialAdjustment[] @relation("CommercialAdjustmentBy")
  productionPayables    ProductionPayable[]    @relation("ProductionPayableProfessional")
  laborReviewsOpened    LaborReview[]          @relation("LaborReviewOpenedBy")
  laborReviewsResolved  LaborReview[]          @relation("LaborReviewResolvedBy")
  financialAdjustments  FinancialAdjustment[]  @relation("FinancialAdjustmentBy")
  teamMonthlyCosts      TeamMonthlyCost[]      @relation("TeamMonthlyCostUser")

  // Evolução Fase 6: custos de logística.
  logisticsPayeeOf         CompanySettings[]          @relation("LogisticsPayee")
  logisticsCostsPayee      LogisticsCost[]            @relation("LogisticsCostPayee")
  logisticsParticipations  LogisticsCostParticipant[] @relation("LogisticsCostParticipantUser")
  logisticsCostAdjustments LogisticsCostAdjustment[]  @relation("LogisticsCostAdjustmentBy")

  // Evolução Fase 7: fechamento semanal.
  weeklyClosingsChecked WeeklyClosing[]  @relation("WeeklyClosingCheckedBy")
  closingPayments       ClosingPayment[] @relation("ClosingPaymentBeneficiary")

  ownTeamDefaultFor CompanySettings[] @relation("OwnTeamDefault")

  moduleSettingsUpdated ModuleSetting[] @relation("ModuleSettingUpdatedBy")

  tripParticipations        LogisticsTripParticipant[] @relation("TripParticipant")
  materialArrivals          MaterialArrival[]          @relation("MaterialArrivalBy")
  materialArrivalsConferred MaterialArrival[]          @relation("MaterialArrivalConferredBy")

  plannedUpholsteredItems CommercialOrderItem[] @relation("PlannedUpholsterer")

  paymentReportsMade    CustomerPaymentReport[] @relation("PaymentReportBy")
  paymentReportsDecided CustomerPaymentReport[] @relation("PaymentReportDecidedBy")

  valueChangeRequests      ValueChangeRequest[]        @relation("ValueChangeBeneficiary")
  valueChangeDecisions     ValueChangeRequest[]        @relation("ValueChangeDecidedBy")
  closingConfirmations     WeeklyClosingConfirmation[] @relation("ConfirmationBeneficiary")
  closingConfirmationsByMe WeeklyClosingConfirmation[] @relation("ConfirmationCreatedBy")

  // Simplificação Fase 7: calendário, folgas/férias e propostas pedidas pelo funcionário.
  holidaysCreated       CompanyHoliday[]       @relation("HolidayCreatedBy")
  holidaysUpdated       CompanyHoliday[]       @relation("HolidayUpdatedBy")
  leavesCreated         AttendanceLeave[]      @relation("LeaveCreatedBy")
  leavesCancelled       AttendanceLeave[]      @relation("LeaveCancelledBy")
  leaveEvents           AttendanceLeaveEvent[] @relation("LeaveEventActor")
  proposalsRequested    RescheduleProposal[]   @relation("ProposalRequestedBy")
  // Reformulação, Fase 1: estoque simples e materiais da OS.
  inventoryItemsCreated InventoryItem[]        @relation("InventoryItemCreatedBy")
  fabricRollsCreated    FabricRoll[]           @relation("FabricRollCreatedBy")
  inventoryAdjustments  InventoryAdjustment[]  @relation("InventoryAdjustmentActor")
  osMaterialsCreated    ServiceOrderMaterial[] @relation("OsMaterialCreatedBy")
  osMaterialsUpdated    ServiceOrderMaterial[] @relation("OsMaterialUpdatedBy")
  osMaterialsRemoved    ServiceOrderMaterial[] @relation("OsMaterialRemovedBy")
  osMaterialsReconciled ServiceOrderMaterial[] @relation("OsMaterialReconciledBy")
  // Reformulação, Fase 2: materiais padrão dos modelos de serviço.
  modelMaterialsCreated ServiceModelMaterial[] @relation("ModelMaterialCreatedBy")
  modelMaterialsUpdated ServiceModelMaterial[] @relation("ModelMaterialUpdatedBy")
  // Reformulação, Fase 3: entregas diretas desfeitas.
  deliveriesReverted    Delivery[]             @relation("DeliveryRevertedBy")
  gameSpacesUpdated     GameSpace[]            @relation("GameSpaceUpdatedBy")
  gameStations          GameStationAssignee[]  @relation("GameStationAssignee")
  gameRevisions         GameLayoutRevision[]   @relation("GameRevisionCreatedBy")
  aiAgentsCreated       AiAgent[]              @relation("AiAgentCreatedBy")
  aiAgentMessages       AiAgentMessage[]       @relation("AiAgentMessageUser")
  aiProposalsDecided    AiAgentProposal[]      @relation("AiAgentProposalDecidedBy")
  cashSnapshots         CashSnapshot[]         @relation("CashSnapshotCreatedBy")
  cashEntries           CashEntry[]            @relation("CashEntryCreatedBy")
  cashGoals             CashGoal[]             @relation("CashGoalCreatedBy")
  // Módulo Orçamentos.
  quotesCreated         Quote[]                @relation("QuoteCreatedBy")
  feedbackReports       FeedbackReport[]       @relation("FeedbackReportUser")
  quotesDeleted         Quote[]                @relation("QuoteDeletedBy")

  @@map("users")
}

/// Pessoa que atua na empresa (gestor, tapeceiros, ajudante...).
model Employee {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company          CompanySettings @relation("EmpresaDeEmployee", fields: [companyId], references: [id])
  userId           String          @unique @map("user_id") @db.Uuid
  fullName         String          @map("full_name") @db.VarChar(120)
  displayName      String          @map("display_name") @db.VarChar(40)
  jobTitle         String          @map("job_title") @db.VarChar(80)
  responsibilities String?         @db.VarChar(500)
  phone            String?         @db.VarChar(30)
  /// Cor de identificação visual nos tablets e no painel (#RRGGBB).
  color            String          @db.Char(7)
  photoFileId      String?         @unique @map("photo_file_id") @db.Uuid
  active           Boolean         @default(true)
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  photo           StoredFile?             @relation("EmployeePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  assignedDevices Device[]
  receipts        Receipt[]               @relation("ReceiptReceivedBy")
  leadOf          ServiceOrder[]          @relation("ServiceOrderTechnicalLead")
  attendances     OperationalAttendance[]
  skills          EmployeeSkill[]
  leaves          AttendanceLeave[]

  @@index([active])
  @@map("employees")
}

// ─────────────────────────── Funções e permissões ───────────────────────────

model Role {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeRole", fields: [companyId], references: [id])
  /// Chave estável das funções padrão (null para funções criadas pelo gestor).
  key         String?         @db.VarChar(60)
  name        String          @db.VarChar(60)
  description String?         @db.VarChar(300)
  /// Funções do sistema não podem ser excluídas.
  system      Boolean         @default(false)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, key])
  @@unique([companyId, name])
  @@map("roles")
}

model RolePermission {
  companyId  Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company    CompanySettings @relation("EmpresaDeRolePermission", fields: [companyId], references: [id])
  roleId     String          @map("role_id") @db.Uuid
  permission String          @db.VarChar(80)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  companyId Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company   CompanySettings @relation("EmpresaDeUserRole", fields: [companyId], references: [id])
  userId    String          @map("user_id") @db.Uuid
  roleId    String          @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Concessões individuais além das funções (ex.: medição extraordinária autorizada).
model UserPermission {
  companyId  Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company    CompanySettings @relation("EmpresaDeUserPermission", fields: [companyId], references: [id])
  userId     String          @map("user_id") @db.Uuid
  permission String          @db.VarChar(80)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

// ─────────────────────────── Dispositivos e sessões ───────────────────────────

enum DeviceKind {
  TABLET
  COMPUTADOR
  CELULAR

  @@map("device_kind")
}

/// O que a tela inicial do aparelho mostra (2026-11-24, pedido do Raphael). Nunca mais do que o
/// cargo da pessoa permite: só escolhe entre produção e entregas/retiradas.
enum DeviceShows {
  TUDO
  PRODUCAO
  LOGISTICA

  @@map("device_shows")
}

enum DeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED

  @@map("device_status")
}

model Device {
  id                   String          @id @default(uuid()) @db.Uuid
  companyId            Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company              CompanySettings @relation("EmpresaDeDevice", fields: [companyId], references: [id])
  receipts             Receipt[]       @relation("ReceiptDevice")
  name                 String          @db.VarChar(60)
  kind                 DeviceKind      @default(TABLET)
  location             String?         @db.VarChar(80)
  status               DeviceStatus    @default(PENDING_PAIRING)
  assignedEmployeeId   String?         @map("assigned_employee_id") @db.Uuid
  restrictToAssigned   Boolean         @default(true) @map("restrict_to_assigned")
  shows                DeviceShows     @default(TUDO)
  /// Hash SHA-256 da credencial do dispositivo (o valor bruto fica só no cookie do tablet).
  credentialHash       String?         @unique @map("credential_hash") @db.Char(64)
  /// Hash SHA-256 do código de vinculação de uso único.
  pairingCodeHash      String?         @unique @map("pairing_code_hash") @db.Char(64)
  pairingCodeExpiresAt DateTime?       @map("pairing_code_expires_at") @db.Timestamptz(3)
  pairedAt             DateTime?       @map("paired_at") @db.Timestamptz(3)
  revokedAt            DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedById          String?         @map("revoked_by_id") @db.Uuid
  lastSeenAt           DateTime?       @map("last_seen_at") @db.Timestamptz(3)
  lastIp               String?         @map("last_ip") @db.VarChar(64)
  userAgent            String?         @map("user_agent") @db.VarChar(300)
  createdById          String?         @map("created_by_id") @db.Uuid
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedEmployee Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  createdBy        User?     @relation("DeviceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy        User?     @relation("DeviceRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  sessions         Session[]

  @@unique([companyId, name])
  @@index([status])
  @@map("devices")
}

enum SessionKind {
  WEB
  DEVICE

  @@map("session_kind")
}

model Session {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company       CompanySettings @relation("EmpresaDeSession", fields: [companyId], references: [id])
  /// Hash SHA-256 do token de sessão; o token bruto existe apenas no cookie httpOnly.
  tokenHash     String          @unique @map("token_hash") @db.Char(64)
  kind          SessionKind
  userId        String          @map("user_id") @db.Uuid
  deviceId      String?         @map("device_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?         @map("revoked_reason") @db.VarChar(40)
  revokedById   String?         @map("revoked_by_id") @db.Uuid
  ipAddress     String?         @map("ip_address") @db.VarChar(64)
  userAgent     String?         @map("user_agent") @db.VarChar(300)

  user       User        @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  revokedBy  User?       @relation("SessionRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  oauthGrant OAuthGrant?

  @@index([userId, revokedAt])
  @@index([deviceId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Controle persistente contra abuso de autenticação (por conta, IP ou dispositivo).
model AuthThrottle {
  key         String    @id @db.VarChar(200)
  failures    Int       @default(0)
  windowStart DateTime  @default(now()) @map("window_start") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("auth_throttle")
}

/// Link enviado por e-mail (confirmar o e-mail, redefinir a senha). Só o hash fica guardado.
model EmailToken {
  id        String          @id @default(uuid()) @db.Uuid
  companyId Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company   CompanySettings @relation("EmpresaDeEmailToken", fields: [companyId], references: [id])
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'CONFIRMAR_EMAIL' ou 'REDEFINIR_SENHA'.
  purpose   String          @db.VarChar(20)
  tokenHash String          @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?       @map("used_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Fila de e-mails do sistema (enviados em segundo plano, com novas tentativas).
model OutboundEmail {
  id        String          @id @default(uuid()) @db.Uuid
  companyId Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company   CompanySettings @relation("EmpresaDeOutboundEmail", fields: [companyId], references: [id])
  to        String          @db.VarChar(254)
  subject   String          @db.VarChar(200)
  text      String
  html      String?
  /// Tipo (confirmar-email, redefinir-senha, assinatura…), para relatórios e testes.
  kind      String          @db.VarChar(40)
  attempts  Int             @default(0)
  lastError String?         @map("last_error") @db.VarChar(500)
  nextTryAt DateTime        @default(now()) @map("next_try_at") @db.Timestamptz(3)
  sentAt    DateTime?       @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sentAt, nextTryAt])
  @@map("outbound_emails")
}

/// Cobrança da assinatura do Cenário Gestão (gerada no Asaas; a confirmação chega pelo webhook).
model SubscriptionInvoice {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeSubscriptionInvoice", fields: [companyId], references: [id])
  /// 'ASAAS' ou 'MANUAL' (pagamento registrado pelo dono da plataforma).
  provider    String          @db.VarChar(20)
  /// Id da cobrança no provedor (único no sistema).
  externalId  String?         @unique @map("external_id") @db.VarChar(80)
  plan        String          @db.VarChar(20)
  cycle       String          @db.VarChar(10)
  amountCents Int             @map("amount_cents")
  dueDate     DateTime        @map("due_date") @db.Date
  /// PENDENTE, PAGA, VENCIDA, CANCELADA.
  status      String          @default("PENDENTE") @db.VarChar(12)
  paymentUrl  String?         @map("payment_url") @db.VarChar(500)
  paidAt      DateTime?       @map("paid_at") @db.Timestamptz(3)
  /// Até quando o pagamento libera o sistema (preenchido ao pagar).
  periodEnd   DateTime?       @map("period_end") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, dueDate])
  @@map("subscription_invoices")
}

// ─────────────────────────────── Empresa ───────────────────────────────

/// Configurações da empresa (registro único, id = 1).
model CompanySettings {
  id                 Int       @id @default(autoincrement())
  tradeName          String    @map("trade_name") @db.VarChar(120)
  legalName          String?   @map("legal_name") @db.VarChar(160)
  document           String?   @db.VarChar(20)
  phone              String?   @db.VarChar(30)
  email              String?   @db.VarChar(254)
  address            String?   @db.VarChar(240)
  timezone           String    @default("America/Sao_Paulo") @db.VarChar(64)
  /// Horário a partir do qual o botão "Cheguei" é exibido (HH:MM).
  workdayStart       String    @default("08:30") @map("workday_start") @db.Char(5)
  /// "Parar tudo" dos agentes do escritório (nulo = trabalhando).
  agentsPausedAt     DateTime? @map("agents_paused_at") @db.Timestamptz(3)
  /// Link para o cliente avaliar a empresa no Google (usado pelo agente de Atendimento).
  googleReviewUrl    String?   @map("google_review_url") @db.VarChar(500)
  /// Limite para alerta de indisponibilidade operacional presumida (HH:MM).
  arrivalAlertAt     String    @default("09:30") @map("arrival_alert_at") @db.Char(5)
  workdayEnd         String    @default("18:00") @map("workday_end") @db.Char(5)
  /// Fase 7: início da janela em que o botão "Cheguei" aceita confirmação (HH:MM).
  arrivalWindowStart String    @default("07:00") @map("arrival_window_start") @db.Char(5)
  /// Fase 7: atraso (minutos) a partir do qual o gestor é avisado.
  lateAlertMinutes   Int       @default(15) @map("late_alert_minutes")
  /// Dias úteis (0 = domingo ... 6 = sábado).
  workingDays        Int[]     @default([1, 2, 3, 4, 5]) @map("working_days")
  /// Dia habitual de programação da semana seguinte.
  planningWeekday    Int       @default(5) @map("planning_weekday")
  /// Dia habitual de medição de tecidos e espumas.
  measurementWeekday Int       @default(5) @map("measurement_weekday")
  version            Int       @default(1)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Multi-empresa etapa 4: bloqueada pelo dono da plataforma (ninguém da empresa entra).
  blockedAt          DateTime? @map("blocked_at") @db.Timestamptz(3)
  blockedReason      String?   @map("blocked_reason") @db.VarChar(200)
  updatedById        String?   @map("updated_by_id") @db.Uuid

  // Cobrança e planos (2026-11-17). A situação é calculada pelas datas (packages/shared/billing.ts).
  /// Plano contratado: 'gestao' (R$ 399) ou 'gestao_jogo' (R$ 599, com o Firma Viva).
  plan                String    @default("gestao") @db.VarChar(20)
  /// 'MENSAL' ou 'ANUAL'.
  billingCycle        String    @default("MENSAL") @map("billing_cycle") @db.VarChar(10)
  /// Cortesia: nunca vence (Cenário Estofados e empresas liberadas pelo dono).
  billingCourtesy     Boolean   @default(false) @map("billing_courtesy")
  trialEndsAt         DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  paidUntil           DateTime? @map("paid_until") @db.Timestamptz(3)
  asaasCustomerId     String?   @map("asaas_customer_id") @db.VarChar(60)
  asaasSubscriptionId String?   @map("asaas_subscription_id") @db.VarChar(60)
  /// Melhoria 113: cancelamento pedido pela própria empresa (o acesso vai até o fim do período pago).
  canceledAt          DateTime? @map("canceled_at") @db.Timestamptz(3)
  /// Melhoria 113: motivo informado ao cancelar ou pausar.
  cancelReason        String?   @map("cancel_reason") @db.VarChar(500)
  /// Melhoria 113: assinatura pausada (sem cobrança) até esta data.
  pausedUntil         DateTime? @map("paused_until") @db.Timestamptz(3)
  /// Melhoria 114: acesso de suporte liberado pelo dono da empresa até esta data.
  supportAccessUntil  DateTime? @map("support_access_until") @db.Timestamptz(3)
  /// Melhoria 128: empresa de demonstração (fica fora dos números do negócio).
  isDemo              Boolean   @default(false) @map("is_demo")

  /// Fase 10: inspetor principal da qualidade (vazio = quem tem a competência de inspeção).
  qualityInspectorUserId    String? @map("quality_inspector_user_id") @db.Uuid
  /// Evolução Fase 3: responsável padrão das etapas de preparação/desmontagem (vazio = único
  /// ajudante ativo com a competência; se houver zero ou vários, a tarefa fica pendente).
  preparationAssigneeUserId String? @map("preparation_assignee_user_id") @db.Uuid

  // Fase 11: financeiro operacional.
  /// Alíquota estimada de tributos sobre a receita (pontos-base; 600 = 6%). Vazio = não configurada.
  taxRateBps Int? @map("tax_rate_bps")

  // Evolução Fase 6: custos de retirada e entrega.
  /// Valor padrão sugerido ao agendar uma retirada / entrega (centavos). Vazio = sem sugestão.
  defaultPickupCostCents   Int?    @map("default_pickup_cost_cents")
  defaultDeliveryCostCents Int?    @map("default_delivery_cost_cents")
  /// Recebedor único da logística (André). Vazio/inativo = obrigação não é gerada (pendência).
  logisticsPayeeUserId     String? @map("logistics_payee_user_id") @db.Uuid
  logisticsPayee           User?   @relation("LogisticsPayee", fields: [logisticsPayeeUserId], references: [id], onDelete: SetNull)

  // Simplificação Fase 2: responsável padrão da retirada pela equipe própria (Thiago). Vazio ou
  // inelegível = pendência para o gestor escolher; nunca um funcionário qualquer.
  ownTeamDefaultUserId String? @map("own_team_default_user_id") @db.Uuid
  ownTeamDefault       User?   @relation("OwnTeamDefault", fields: [ownTeamDefaultUserId], references: [id], onDelete: SetNull)

  // Multi-empresa: tudo o que pertence a esta empresa.
  empresaCompanyCounter              CompanyCounter[]              @relation("EmpresaDeCompanyCounter")
  empresaUser                        User[]                        @relation("EmpresaDeUser")
  empresaSession                     Session[]                     @relation("EmpresaDeSession")
  empresaDevice                      Device[]                      @relation("EmpresaDeDevice")
  empresaOAuthCode                   OAuthCode[]                   @relation("EmpresaDeOAuthCode")
  empresaOAuthGrant                  OAuthGrant[]                  @relation("EmpresaDeOAuthGrant")
  empresaOAuthAccessToken            OAuthAccessToken[]            @relation("EmpresaDeOAuthAccessToken")
  empresaEmployee                    Employee[]                    @relation("EmpresaDeEmployee")
  empresaRole                        Role[]                        @relation("EmpresaDeRole")
  empresaRolePermission              RolePermission[]              @relation("EmpresaDeRolePermission")
  empresaUserRole                    UserRole[]                    @relation("EmpresaDeUserRole")
  empresaUserPermission              UserPermission[]              @relation("EmpresaDeUserPermission")
  empresaEmployeeSkill               EmployeeSkill[]               @relation("EmpresaDeEmployeeSkill")
  empresaModuleSetting               ModuleSetting[]               @relation("EmpresaDeModuleSetting")
  empresaCompanyHoliday              CompanyHoliday[]              @relation("EmpresaDeCompanyHoliday")
  empresaAuditLog                    AuditLog[]                    @relation("EmpresaDeAuditLog")
  empresaDomainEvent                 DomainEvent[]                 @relation("EmpresaDeDomainEvent")
