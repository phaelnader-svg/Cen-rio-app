  @@index([purchaseOrderId, status])
  @@map("material_arrivals")
}

// ─────────────────────────── R2 — negociação e confirmação semanal ───────────────────────────

/// Pedido do próprio beneficiário para alterar um valor (mão de obra ou viagem). Não move dinheiro:
/// a aprovação aplica pelas funções financeiras existentes (valor combinado ou ajuste).
model ValueChangeRequest {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company             CompanySettings @relation("EmpresaDeValueChangeRequest", fields: [companyId], references: [id])
  number              Int             @default(dbgenerated())
  /// PRODUCAO (production_payable) ou LOGISTICA (logistics_cost).
  targetKind          String          @map("target_kind") @db.VarChar(20)
  productionPayableId String?         @map("production_payable_id") @db.Uuid
  logisticsCostId     String?         @map("logistics_cost_id") @db.Uuid
  beneficiaryUserId   String          @map("beneficiary_user_id") @db.Uuid
  /// Valor devido que o profissional viu ao pedir (CAS: mudou → OBSOLETA).
  currentCents        Int             @map("current_cents")
  requestedCents      Int             @map("requested_cents")
  reason              String          @db.VarChar(500)
  /// PENDENTE, APROVADA, RECUSADA, OBSOLETA.
  status              String          @default("PENDENTE") @db.VarChar(20)
  decisionNote        String?         @map("decision_note") @db.VarChar(500)
  /// Como a aprovação foi aplicada: VALOR_COMBINADO ou AJUSTE.
  appliedAs           String?         @map("applied_as") @db.VarChar(20)
  decidedById         String?         @map("decided_by_id") @db.Uuid
  decidedAt           DateTime?       @map("decided_at") @db.Timestamptz(3)
  sessionId           String?         @map("session_id") @db.Uuid
  deviceId            String?         @map("device_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  version             Int             @default(1)

  payable     ProductionPayable? @relation(fields: [productionPayableId], references: [id], onDelete: Restrict)
  cost        LogisticsCost?     @relation(fields: [logisticsCostId], references: [id], onDelete: Restrict)
  beneficiary User               @relation("ValueChangeBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  decidedBy   User?              @relation("ValueChangeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([status, createdAt])
  @@index([beneficiaryUserId, createdAt])
  @@index([productionPayableId])
  @@index([logisticsCostId])
  @@map("value_change_requests")
}

/// Retrato imutável do que o profissional conferiu numa semana (ou de uma exceção administrativa
/// do gestor). A validade é recalculada ao vivo comparando as linhas com o estado atual.
model WeeklyClosingConfirmation {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company           CompanySettings @relation("EmpresaDeWeeklyClosingConfirmation", fields: [companyId], references: [id])
  number            Int             @default(dbgenerated())
  beneficiaryUserId String          @map("beneficiary_user_id") @db.Uuid
  weekStart         DateTime        @map("week_start") @db.Date
  /// PROFISSIONAL ou EXCECAO_ADMINISTRATIVA.
  kind              String          @db.VarChar(30)
  /// Linhas ordenadas: [{kind, id, code, bucket, dueCents, totalDueCents}].
  items             Json
  totalCents        Int             @map("total_cents")
  /// SHA-256 do conteúdo canônico (pessoa, semana, linhas ordenadas).
  hash              String          @db.Char(64)
  /// Exceção: motivo interno (obrigatório) e mensagem neutra ao profissional.
  reason            String?         @db.VarChar(500)
  publicNote        String?         @map("public_note") @db.VarChar(300)
  createdById       String?         @map("created_by_id") @db.Uuid
  sessionId         String?         @map("session_id") @db.Uuid
  deviceId          String?         @map("device_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  beneficiary User  @relation("ConfirmationBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  createdBy   User? @relation("ConfirmationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([beneficiaryUserId, weekStart, createdAt])
  @@index([weekStart])
  @@map("weekly_closing_confirmations")
}

// ─────────────────────────── Simplificação Fase 7: calendário e folgas/férias ───────────────────────────

/// Feriados e dias sem expediente da empresa (fonte única da presença). Sem API externa.
model CompanyHoliday {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeCompanyHoliday", fields: [companyId], references: [id])
  date        DateTime        @db.Date
  name        String          @db.VarChar(120)
  active      Boolean         @default(true)
  version     Int             @default(1)
  createdById String?         @map("created_by_id") @db.Uuid
  updatedById String?         @map("updated_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("HolidayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, date])
  @@map("company_holidays")
}

/// Folga ou férias planejada por intervalo. Interpretada dia a dia (não cria presença futura).
model AttendanceLeave {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company       CompanySettings @relation("EmpresaDeAttendanceLeave", fields: [companyId], references: [id])
  number        Int             @default(dbgenerated())
  employeeId    String          @map("employee_id") @db.Uuid
  kind          String          @db.VarChar(10)
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime        @map("end_date") @db.Date
  reason        String          @db.VarChar(300)
  status        String          @default("ATIVA") @db.VarChar(12)
  version       Int             @default(1)
  createdById   String?         @map("created_by_id") @db.Uuid
  cancelledById String?         @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?         @map("cancel_reason") @db.VarChar(300)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy   User?                  @relation("LeaveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?                  @relation("LeaveCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  events      AttendanceLeaveEvent[]

  @@unique([companyId, number])
  @@index([employeeId, startDate])
  @@index([status, startDate, endDate])
  @@map("attendance_leaves")
}

/// Histórico imutável de cada folga/férias (criação, correção, cancelamento).
model AttendanceLeaveEvent {
  id        String          @id @default(uuid()) @db.Uuid
  companyId Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company   CompanySettings @relation("EmpresaDeAttendanceLeaveEvent", fields: [companyId], references: [id])
  leaveId   String          @map("leave_id") @db.Uuid
  action    String          @db.VarChar(20)
  reason    String          @db.VarChar(300)
  before    Json?
  after     Json
  actorId   String?         @map("actor_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  leave AttendanceLeave @relation(fields: [leaveId], references: [id], onDelete: Restrict)
  actor User?           @relation("LeaveEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leaveId, createdAt])
  @@map("attendance_leave_events")
}

// ======================================================================================
// Reformulação, Fase 1 — estoque simples (independente da OS) e materiais necessários da OS.
// ======================================================================================

/// Categoria personalizada do estoque simples (Tecidos, Espumas, Colas...). Nome único sem
/// diferenciar maiúsculas (índice funcional na migration).
model InventoryCategory {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company    CompanySettings @relation("EmpresaDeInventoryCategory", fields: [companyId], references: [id])
  name       String          @db.VarChar(60)
  position   Int             @default(0)
  archivedAt DateTime?       @map("archived_at") @db.Timestamptz(3)
  version    Int             @default(1)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items          InventoryItem[]
  osMaterials    ServiceOrderMaterial[]
  modelMaterials ServiceModelMaterial[]

  @@map("inventory_categories")
}

/// Material do estoque simples. Quantidade atualizada à mão (com ajuste auditado); nunca muda
/// sozinha por causa de uma OS.
model InventoryItem {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company            CompanySettings @relation("EmpresaDeInventoryItem", fields: [companyId], references: [id])
  name               String          @db.VarChar(160)
  categoryId         String?         @map("category_id") @db.Uuid
  unit               String          @db.VarChar(20)
  quantity           Decimal         @default(0) @db.Decimal(12, 3)
  referenceCostCents Int?            @map("reference_cost_cents")
  location           String?         @db.VarChar(120)
  notes              String?         @db.VarChar(500)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  version            Int             @default(1)
  createdById        String?         @map("created_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       InventoryCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy      User?                  @relation("InventoryItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rolls          FabricRoll[]
  adjustments    InventoryAdjustment[]
  osMaterials    ServiceOrderMaterial[]
  modelMaterials ServiceModelMaterial[]

  @@index([categoryId])
  @@map("inventory_items")
}

/// Rolo de tecido com identificação própria e metragem atualizada à mão.
model FabricRoll {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company     CompanySettings @relation("EmpresaDeFabricRoll", fields: [companyId], references: [id])
  itemId      String          @map("item_id") @db.Uuid
  code        String          @db.VarChar(40)
  color       String?         @db.VarChar(60)
  reference   String?         @db.VarChar(80)
  meters      Decimal         @default(0) @db.Decimal(12, 3)
  notes       String?         @db.VarChar(500)
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(3)
  version     Int             @default(1)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  item        InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdBy   User?                 @relation("FabricRollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  adjustments InventoryAdjustment[]

  @@index([itemId])
  @@map("fabric_rolls")
}

/// Ajuste manual de quantidade (de um material ou da metragem de um rolo). Imutável (gatilho).
model InventoryAdjustment {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company          CompanySettings @relation("EmpresaDeInventoryAdjustment", fields: [companyId], references: [id])
  itemId           String?         @map("item_id") @db.Uuid
  rollId           String?         @map("roll_id") @db.Uuid
  previousQuantity Decimal         @map("previous_quantity") @db.Decimal(12, 3)
  newQuantity      Decimal         @map("new_quantity") @db.Decimal(12, 3)
  reason           String?         @db.VarChar(500)
  actorId          String?         @map("actor_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  item  InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  roll  FabricRoll?    @relation(fields: [rollId], references: [id], onDelete: Restrict)
  actor User?          @relation("InventoryAdjustmentActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([rollId, createdAt])
  @@map("inventory_adjustments")
}

/// Material necessário da OS (lista simples). "Comprado" e "na oficina" são independentes; custo
/// opcional (null = não informado, nunca zero). Remoção lógica (removedAt) preserva o histórico.
model ServiceOrderMaterial {
  id                    String          @id @default(uuid()) @db.Uuid
  companyId             Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company               CompanySettings @relation("EmpresaDeServiceOrderMaterial", fields: [companyId], references: [id])
  serviceOrderId        String          @map("service_order_id") @db.Uuid
  description           String          @db.VarChar(200)
  categoryId            String?         @map("category_id") @db.Uuid
  inventoryItemId       String?         @map("inventory_item_id") @db.Uuid
  quantity              Decimal?        @db.Decimal(12, 3)
  unit                  String?         @db.VarChar(20)
  notes                 String?         @db.VarChar(500)
  purchased             Boolean         @default(false)
  available             Boolean         @default(false)
  costCents             Int?            @map("cost_cents")
  version               Int             @default(1)
  createdById           String?         @map("created_by_id") @db.Uuid
  updatedById           String?         @map("updated_by_id") @db.Uuid
  removedAt             DateTime?       @map("removed_at") @db.Timestamptz(3)
  removedById           String?         @map("removed_by_id") @db.Uuid
  /// Conciliação com o custo formal: null (pendente quando há custo formal), VINCULADO (é o mesmo
  /// registro formal — o custo informado deixa de contar) ou DISTINTO (custo à parte, conta).
  reconciliation        String?         @db.VarChar(20)
  linkedPurchaseItemId  String?         @map("linked_purchase_item_id") @db.Uuid
  linkedCostId          String?         @map("linked_cost_id") @db.Uuid
  reconciledById        String?         @map("reconciled_by_id") @db.Uuid
  reconciledAt          DateTime?       @map("reconciled_at") @db.Timestamptz(3)
  /// Fase 2: material padrão do modelo de serviço que originou a linha (null = lançada à mão).
  sourceModelMaterialId String?         @map("source_model_material_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  linkedPurchaseItem  PurchaseOrderItem?    @relation("OsMaterialLinkedPurchase", fields: [linkedPurchaseItemId], references: [id], onDelete: Restrict)
  linkedCost          ServiceOrderCost?     @relation("OsMaterialLinkedCost", fields: [linkedCostId], references: [id], onDelete: Restrict)
  reconciledBy        User?                 @relation("OsMaterialReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)
  serviceOrder        ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  category            InventoryCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryItem       InventoryItem?        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy           User?                 @relation("OsMaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?                 @relation("OsMaterialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  removedBy           User?                 @relation("OsMaterialRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  sourceModelMaterial ServiceModelMaterial? @relation(fields: [sourceModelMaterialId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@index([sourceModelMaterialId])
  @@index([linkedPurchaseItemId])
  @@index([linkedCostId])
  @@map("service_order_materials")
}

/// Reformulação, Fase 2 — material padrão do modelo de serviço (por tipo de peça e, opcional,
/// tipo de serviço; null = qualquer serviço). Só sugestão: aplicado numa OS vira linha da lista
/// simples sem custo, não comprada e não disponível, revisável pelo gestor.
model ServiceModelMaterial {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company         CompanySettings @relation("EmpresaDeServiceModelMaterial", fields: [companyId], references: [id])
  pieceType       PieceType       @map("piece_type")
  serviceType     ServiceType?    @map("service_type")
  description     String          @db.VarChar(200)
  categoryId      String?         @map("category_id") @db.Uuid
  inventoryItemId String?         @map("inventory_item_id") @db.Uuid
  /// Quantidade POR PEÇA (multiplicada pela quantidade da peça ao sugerir).
  quantity        Decimal?        @db.Decimal(12, 3)
  unit            String?         @db.VarChar(20)
  notes           String?         @db.VarChar(500)
  position        Int             @default(0)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  version         Int             @default(1)
  createdById     String?         @map("created_by_id") @db.Uuid
  updatedById     String?         @map("updated_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  category      InventoryCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem?         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy     User?                  @relation("ModelMaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                  @relation("ModelMaterialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  osMaterials   ServiceOrderMaterial[]

  @@index([pieceType, serviceType])
  @@map("service_model_materials")
}

/// Aplicativo externo autorizado a pedir acesso delegado (ex.: Firma Viva). Só o hash do segredo.
model OAuthClient {
  id            String   @id @default(uuid()) @db.Uuid
  clientId      String   @unique @map("client_id") @db.VarChar(64)
  name          String   @db.VarChar(80)
  secretHash    String   @map("secret_hash") @db.Char(64)
  redirectUris  String[] @map("redirect_uris")
  allowedScopes String[] @map("allowed_scopes")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  codes  OAuthCode[]
  grants OAuthGrant[]

  @@map("oauth_clients")
}

/// Código de autorização de uso único (PKCE S256), válido por poucos minutos.
model OAuthCode {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company       CompanySettings @relation("EmpresaDeOAuthCode", fields: [companyId], references: [id])
  codeHash      String          @unique @map("code_hash") @db.Char(64)
  clientId      String          @map("client_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  redirectUri   String          @map("redirect_uri") @db.VarChar(500)
  scopes        String[]
  codeChallenge String          @map("code_challenge") @db.VarChar(128)
  externalRef   String?         @map("external_ref") @db.VarChar(80)
  externalLabel String?         @map("external_label") @db.VarChar(120)
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime?       @map("used_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User        @relation("OAuthCodeUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt])
  @@map("oauth_codes")
}

/// Concessão revogável: usuário + aplicativo + escopos, ligada a uma sessão própria.
model OAuthGrant {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company          CompanySettings @relation("EmpresaDeOAuthGrant", fields: [companyId], references: [id])
  clientId         String          @map("client_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  sessionId        String          @unique @map("session_id") @db.Uuid
  scopes           String[]
  externalRef      String?         @map("external_ref") @db.VarChar(80)
  externalLabel    String?         @map("external_label") @db.VarChar(120)
  refreshHash      String?         @unique @map("refresh_hash") @db.Char(64)
  refreshExpiresAt DateTime?       @map("refresh_expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?       @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?         @map("revoked_reason") @db.VarChar(40)
  revokedById      String?         @map("revoked_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  client    OAuthClient        @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user      User               @relation("OAuthGrantUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session   Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  revokedBy User?              @relation("OAuthGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tokens    OAuthAccessToken[]

  @@index([userId, revokedAt])
  @@map("oauth_grants")
}

model OAuthAccessToken {
  id        String          @id @default(uuid()) @db.Uuid
  companyId Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company   CompanySettings @relation("EmpresaDeOAuthAccessToken", fields: [companyId], references: [id])
  grantId   String          @map("grant_id") @db.Uuid
  tokenHash String          @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([grantId])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
}

model GameSpace {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company      CompanySettings @relation("EmpresaDeGameSpace", fields: [companyId], references: [id])
  key          String          @db.VarChar(40)
  name         String          @db.VarChar(80)
  /// OFICINA | ESCRITORIO | OUTRO
  kind         String          @db.VarChar(20)
  widthCm      Int             @map("width_cm")
  depthCm      Int             @map("depth_cm")
  gridCm       Int             @default(50) @map("grid_cm")
  /// Paredes, portas e móveis decorativos (sem vínculos operacionais).
  doc          Json            @default("{}")
  /// Medidas e posições ainda ilustrativas (sugestão inicial não conferida).
  illustrative Boolean         @default(true)
  position     Int             @default(0)
  active       Boolean         @default(true)
  version      Int             @default(1)
  updatedById  String?         @map("updated_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy    User?                @relation("GameSpaceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  areas        GameArea[]
  stations     GameStation[]
  storageUnits GameStorageUnit[]
  revisions    GameLayoutRevision[]

  @@unique([companyId, key])
  @@map("game_spaces")
}

/// Área funcional (recebimento, corte, costura…). Identificador estável: renomear ou mover
/// preserva os vínculos.
model GameArea {
  id             String          @id @db.Uuid
  companyId      Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company        CompanySettings @relation("EmpresaDeGameArea", fields: [companyId], references: [id])
  spaceId        String          @map("space_id") @db.Uuid
  function       String          @db.VarChar(30)
  name           String          @db.VarChar(80)
  xCm            Int             @map("x_cm")
  yCm            Int             @map("y_cm")
  wCm            Int             @map("w_cm")
  dCm            Int             @map("d_cm")
  color          String?         @db.VarChar(9)
  /// Localização física do sistema (item_locations) representada por esta área.
  itemLocationId String?         @map("item_location_id") @db.Uuid
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  space        GameSpace         @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  itemLocation ItemLocation?     @relation(fields: [itemLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stations     GameStation[]
  storageUnits GameStorageUnit[]

  @@index([spaceId])
  @@map("game_areas")
}

/// Estação de trabalho (bancada, mesa de corte, máquina, mesa do escritório).
model GameStation {
  id         String          @id @db.Uuid
  companyId  Int             @default(dbgenerated("app_company_id()")) @map("company_id")
  company    CompanySettings @relation("EmpresaDeGameStation", fields: [companyId], references: [id])
