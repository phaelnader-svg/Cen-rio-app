# ─────────────────────────────────────────────────────────────────────────────
# Cenário Gestão — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o arquivo `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente lógico: development | staging (homologação) | production
APP_ENV=development
NODE_ENV=development

# Banco PostgreSQL (um banco por ambiente; nunca compartilhe entre ambientes)
DATABASE_URL=postgresql://cenario:SENHA_LOCAL@localhost:5432/cenario_dev
# Banco exclusivo para testes automatizados (é APAGADO durante os testes)
TEST_DATABASE_URL=postgresql://cenario:SENHA_LOCAL@localhost:5432/cenario_test
# Banco exclusivo para os testes ponta a ponta (Playwright) — também é APAGADO
E2E_DATABASE_URL=postgresql://cenario:SENHA_LOCAL@localhost:5432/cenario_e2e_test

# API
API_HOST=0.0.0.0
API_PORT=4000
# Origem(ns) do frontend autorizadas a fazer requisições com cookies (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000
# Proxy reverso confiável para ler o IP real (X-Forwarded-For).
# Valores: false | loopback | lista de IPs/CIDR (ex.: 10.0.0.2). Evite "true".
# Em produção, o proxy reverso deve encaminhar /api diretamente à API e
# sobrescrever X-Forwarded-For (veja infra/Caddyfile).
TRUST_PROXY=false
# Cookies com flag Secure (obrigatório true em staging/production com HTTPS)
COOKIE_SECURE=false
# Segredo para HMAC dos tokens de sessão/dispositivo (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
TOKEN_HASH_SECRET=
LOG_LEVEL=info

# Sessões
SESSION_WEB_IDLE_HOURS=12
SESSION_WEB_ABSOLUTE_DAYS=30
SESSION_DEVICE_IDLE_DAYS=30

# Armazenamento privado de arquivos (fora de qualquer diretório público)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5

# Frontend → API (usado pelo Next.js para encaminhar /api/*)
API_INTERNAL_URL=http://localhost:4000

# Seed inicial: conta do gestor. Sem esses valores o seed não cria o acesso.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
